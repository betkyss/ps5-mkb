+public:
+    explicit MkbSubmissionGate(Setter value,std::shared_ptr<MkbGateTrace> t={}):setter(std::move(value)),trace(std::move(t)){publishView();}
+    static std::shared_ptr<MkbSubmissionGate> forSession(ChiakiSession *s,std::shared_ptr<MkbGateTrace> trace={}) {

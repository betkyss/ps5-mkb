+        // in HID mode and does not open any device for input.
+        monitor=IOHIDManagerCreate(nullptr,kIOHIDOptionsTypeNone);
+        if(!monitor) { s.fail("hid-monitor-unavailable"); return false; }
+        MacInputCapture::setupMonitor(monitor,s,{}); monitored=true;
+        if(s.config.source==MkbMouseInput::Source::HID) {
+            manager=IOHIDManagerCreate(nullptr,kIOHIDOptionsTypeNone);
+            if(!manager) { s.fail("hid-manager-unavailable"); return false; }
+            auto matching=mouseMatch(); IOHIDManagerSetDeviceMatching(manager,matching); CFRelease(matching);
+            auto devices=IOHIDManagerCopyDevices(manager);
+            std::vector<const void *> refs(devices ? size_t(CFSetGetCount(devices)) : 0);
+            if(devices) CFSetGetValues(devices,refs.data());
+            std::vector<MkbMouseInput::Device> descriptions;
+            for(auto ref:refs) descriptions.push_back(describe(static_cast<IOHIDDeviceRef>(const_cast<void *>(ref))));
+            auto selection=MkbMouseInput::select(s.config,descriptions);
+            if(!selection.error) {
+                device=static_cast<IOHIDDeviceRef>(const_cast<void *>(refs[selection.index])); CFRetain(device);
+                s.x=selection.x; s.y=selection.y;
+                auto &d=descriptions[selection.index];
+                {std::lock_guard<std::mutex> lock(s.control);s.selected={true,d.hasLocation,d.vid,d.pid,d.location,MacInputCapture::nowNs()};}
+                std::fprintf(stderr,"MKB selected VID=0x%04x PID=0x%04x location=0x%08x\n",d.vid,d.pid,d.location);
+            }
+            if(devices) CFRelease(devices);
+            if(selection.error) { s.fail(selection.error); return false; }
+            if(s.cancelled) return false;
+            opened=IOHIDDeviceOpen(device,kIOHIDOptionsTypeNone)==kIOReturnSuccess;
+            if(!opened) { s.fail("hid-device-open-failed"); return false; }
+            if(s.cancelled) return false;
+            auto descriptor=IOHIDDeviceGetProperty(device,CFSTR(kIOHIDReportDescriptorKey));
+            if(!descriptor || CFGetTypeID(descriptor)!=CFDataGetTypeID()) {s.fail("hid-report-descriptor-unavailable");return false;}
+            auto data=static_cast<CFDataRef>(descriptor);
+            const auto length=CFDataGetLength(data);
+            if(length<=0 || size_t(length)>MkbHidReport::DescriptorLimit) {s.fail("unsupported-hid-descriptor-size");return false;}
+            s.descriptor=MkbHidReport::parse(CFDataGetBytePtr(data),size_t(length));
+            if(s.descriptor.error) {s.fail(s.descriptor.error);return false;}
+            for(const auto &binding:s.profile.binds) if(binding.first>=256 && binding.first<=260 &&
+                    !MkbHidReport::hasButton(s.descriptor,unsigned(binding.first-256))) {
+                s.fail("hid-bound-button-unavailable");return false;
+            }

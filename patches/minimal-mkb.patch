+        }
+        if(s.cancelled) return false;
+        return prepareTap(s,mask);
+    }
+    bool prepareTap(MkbCaptureState &s,CGEventMask mask) {
+        context=&s;
+        if(s.cancelled) return false;
+        // Create the tap only after potentially slow HID preparation. Do not
+        // generate our own disabled notification by toggling false then true.
+        s.tapStage="startup-create";
+        tap=tapOps.create(mask,&s);
+        if(!tap) { s.fail("event-tap-unavailable-check-accessibility"); return false; }
+        if(s.cancelled) return false;
+        source=tapOps.source(tap);
+        if(!source) { s.fail("event-tap-source-failed"); return false; }
+        tapLease=MacInputCapture::ownTap(tap,source,s.shared_from_this(),tapOps.lease);
+        s.nativeTap=tap;
+        tapOps.add(source);
+        const MkbTapStartupOps startup{
+            [&] {const bool enabled=tapOps.lease.enabled(tap);tapDiagnostic(s,enabled?"already-enabled":"enable-request",0,enabled);if(!enabled) tapOps.enable(tap,true);},
+            [&] {return tapOps.lease.enabled(tap);},
+            [&] {tapOps.pump();},
+            tapOps.now
+        };
+        if(!MkbWaitForTap(s,startup)) return false;
+        tapDiagnostic(s,"startup-ready",0,tapOps.lease.enabled(tap));
+        detached=tapOps.associate(false)==kCGErrorSuccess;
+        if(s.cancelled) return false;
+        hidden=tapOps.hide()==kCGErrorSuccess;
+        if(!detached || !hidden) { s.fail("cursor-capture-failed"); return false; }
+        if(s.cancelled) return false;
+        if(!checkTap(s,tap,"event-tap-disabled-startup-final-check",tapOps.lease.enabled)) return false;
+        if(s.cancelled) return false;
+        if(!s.permissions || !s.permissions->attachTap(tapLease,MacInputCapture::nowNs())) {
+            s.fail("event-tap-monitor-unavailable");return false;
+        }
+        return true;
+    }
+    void pumpReady(MkbCaptureState &s) override {
+        s.tapStage="ready-pump";
+        CFRunLoopRunInMode(kCFRunLoopDefaultMode,0.002,false);
+
+    }
+    void pump(MkbCaptureState &s) override {
+        s.tapStage="active-pump";
+        // Scheduling cadence only. Report boundaries come from the report callback,
+        // never from this run-loop timeout.
+        auto ops=MkbMakePumpOps(s,[] {CFRunLoopRunInMode(kCFRunLoopDefaultMode,0.002,false);});
+        MkbActivePump(s,ops);
+    }
+    void restoreCursor() override {
+        if(hidden) { tapOps.show(); hidden=false; }
+        if(detached) { tapOps.associate(true); detached=false; }
+    }
+    ~AppleBackend() override {
+        restoreCursor(); // Always before tap/IOHID teardown, which can block.
+        if(tap) tapOps.enable(tap,false);
+        if(device) {
+            MacInputCapture::unregisterReports(reportRegistration);
+            if(scheduled) IOHIDDeviceUnscheduleFromRunLoop(device,CFRunLoopGetCurrent(),kCFRunLoopDefaultMode);
+            if(opened) IOHIDDeviceClose(device,kIOHIDOptionsTypeNone);
+            CFRelease(device);
+        }
+        if(monitor) {
+            IOHIDManagerRegisterDeviceRemovalCallback(monitor,nullptr,nullptr);
+            if(monitored) IOHIDManagerUnscheduleFromRunLoop(monitor,CFRunLoopGetCurrent(),kCFRunLoopDefaultMode);
+            CFRelease(monitor);
+        }
+        if(manager) CFRelease(manager);
+        if(source) tapOps.remove(source);
+        if(context) context->nativeTap=nullptr;
+        if(!tapLease) {
+            if(tap) tapOps.lease.invalidate(tap);
+            if(source) tapOps.lease.release(source);
+            if(tap) tapOps.lease.release(tap);
+        }
+        tapLease.reset();
+
+    }
+};
+}
+MacInputCapture::MacInputCapture(BackendFactory value) : factory(std::move(value)) {
+    if(!factory) factory=[] { return std::make_unique<AppleBackend>(); };
+}
+bool MacInputCapture::liveProfile(const MkbProfile &value)
+{
+    if(!state || state->cancelled || !state->input.running())return false;
+    if(state->config.source==MkbMouseInput::Source::HID) {
+        for(const auto &binding:value.binds) {
+            if(binding.first>=261)return false;
+            if(binding.first>=256 && !MkbHidReport::hasButton(state->descriptor,unsigned(binding.first-256)))return false;
+        }
+    }
+    std::lock_guard<std::mutex> lock(state->profileMutex);
+    state->profile=value;profile=value;return true;
+}
+MacInputCapture::~MacInputCapture() { disarm(); }
+bool MacInputCapture::arm()
+{
+    lastError.clear();
+    auto config=MkbMouseInput::parse(std::getenv("CHIAKI_MKB_MOUSE_SOURCE"),std::getenv("CHIAKI_MKB_HID_VID"),
+        std::getenv("CHIAKI_MKB_HID_PID"),std::getenv("CHIAKI_MKB_HID_LOCATION"));
+    lifecycle->reserve(attemptToken,config,state?state->lifecycle:nullptr);
+    if(state && !state->finished) { lastError="capture-still-stopping"; return false; }
+    if(config.error) { lastError=config.error; std::fprintf(stderr,"MKB capture failure: %s\n",config.error); return false; }
+    if(config.source==MkbMouseInput::Source::HID) {
+        for(const auto &binding:profile.binds) if(binding.first>=261) {
+            lastError="unsupported-hid-mouse-binding";return false;
+        }
+    }
+    bool expected=false;
+    if(!nativeBusy.compare_exchange_strong(expected,true)) { lastError="capture-still-stopping"; return false; }
+    try {
+        state=std::make_shared<MkbCaptureState>(); state->phases=phases; state->permissionPhases=permissionPhases; state->failureHook=failureHook; state->config=config; state->profile=profile; state->requestedAt=now();
+        state->lifecycle=lifecycle->begin(attemptToken,config);
+        std::fprintf(stderr,"MKB source=%s VID=0x%04x PID=0x%04x location=0x%08x\n",
+            config.source==MkbMouseInput::Source::HID ? "hid" : "cg",config.vid,config.pid,config.location);
+        std::thread(&MacInputCapture::run,state,factory).detach();
+    } catch(...) {
+        nativeBusy=false; lastError="capture-thread-unavailable";
+        if(state) { state->finished=true; if(state->lifecycle)state->lifecycle->finish(); state->fail("capture-thread-unavailable"); }
+        return false;
+    }
+    return true;
+}
+void MacInputCapture::run(std::shared_ptr<MkbCaptureState> s, BackendFactory create)
+{
+    @autoreleasepool {
+        try {
+            auto backend=create();
+            struct Restore {
+                MkbNativeBackend *backend;
+                MkbCaptureState &state;
+                ~Restore() {
+                    if(state.failureHook && std::uncaught_exceptions()) state.fail("capture-native-exception");
+                    // Another thread can set cancelled before its hook reaches the gate.
+                    // Complete the same idempotent revoke before cursor restoration.
+                    if(state.failureHook) {
+                        std::string failure;
+                        {std::lock_guard<std::mutex> lock(state.control);failure=state.error;}
+                        if(!failure.empty()) state.failureHook(failure.c_str());
+                    }
+                    state.cancel(); // Close activation before detaching monitor ownership, including exceptions.
+                    std::shared_ptr<MkbPermissionMonitor> monitor;
+                    {std::lock_guard<std::mutex> lock(state.control);monitor=std::move(state.permissions);}
+                    if(monitor) monitor->stop();
+                    if(backend) backend->restoreCursor();
+                }
+            } restore{backend.get(),*s};
+            bool permissionGate=false;
+            if(backend) {
+                auto ops=backend->permissionOps();
+                ops.publish=[attempt=s->lifecycle](const auto &value){attempt->publishPermissions(value);};
+                if(ops.accessibility) {
+                    permissionGate=true;
+                    {std::lock_guard<std::mutex> lock(s->control);
+                        s->permissions=MkbPermissionMonitor::start(std::move(ops),s->config.source==MkbMouseInput::Source::HID,s->permissionPhases);}
+                    s->lifecycle->publishMonitor(s->permissions);
+                    if(!s->permissions) s->fail("permission-monitor-busy");
+                    else while(!s->cancelled) {
+                        const auto reason=s->permissions->failure(true);
+                        if(!reason) break;
+                        if(std::strcmp(reason,"permission-monitor-pending")!=0) {s->fail(reason);break;}
+                        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                    }
+                }
+            }
+            // Backends without a permission gate retain their own prepare/cancel handling.
+            const bool prepared=!(permissionGate && s->cancelled) && backend && backend->prepare(*s);
+            s->lifecycle->publishSelected(s->selected);
+            if(!prepared) {
+                if(!s->cancelled) s->fail("native-prepare-failed");
+            } else {
+                {
+                    std::unique_lock<std::mutex> lock(s->control);
+                    if(!s->cancelled) { s->readyAt=now(); s->phase=MkbCaptureState::Phase::Ready; }
+                    const auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(s->activationWaitMs);
+                    while(!s->cancelled && s->phase!=MkbCaptureState::Phase::Active) {
+                        if(std::chrono::steady_clock::now()>=deadline) {lock.unlock();s->fail("capture-activation-timeout");break;}
+                        const auto wake=std::min(deadline,std::chrono::steady_clock::now()+std::chrono::milliseconds(2));
+                        bool signaled;
+                        {
+                            MkbNativePhaseTrace::Scope phase(s->phases.get(),MkbNativePhaseTrace::Kind::ReadyWait);
+                            signaled=s->changed.wait_until(lock,wake,[&] {
+                                return s->cancelled || s->phase==MkbCaptureState::Phase::Active;
+                            });
+                        }
+                        if(signaled) break;
+                        lock.unlock();backend->pumpReady(*s);
+                        if(s->permissions) if(const auto reason=s->permissions->failure()) s->fail(reason);
+                        lock.lock();
+                    }
+                }
+                while(!s->cancelled) {
+                    MkbNativePhaseTrace::Scope phase(s->phases.get(),MkbNativePhaseTrace::Kind::Iteration);
+                    backend->pump(*s);
+                    MkbWatchdog(*s,MacInputCapture::now);
+                }
+            }
+            // backend cleanup can block, but remains solely on the owning worker.
+        } catch(...) { s->fail("capture-native-exception"); }
+        s->lifecycle->finish();s->finished=true;nativeBusy=false;
+    }
+}
+bool MacInputCapture::activate(uint64_t epoch, uint64_t at)
+{
+    if(!state) return false;
+    std::unique_lock<std::mutex> lock(state->control);
+    if(state->cancelled || state->phase!=MkbCaptureState::Phase::Ready) return false;
+    if(state->permissions) if(const auto reason=state->permissions->failure(true)) {
+        lock.unlock();state->fail(reason);return false;
+    }
+    state->generation=epoch; state->heartbeat=at;
+    state->input.begin(state->config.source,epoch,state->clock,mach_absolute_time(),state->x,state->y,&MacInputCapture::nowNs);
+    if(!state->input.running()){lock.unlock();state->inputStopped();return false;}
+    state->phase=MkbCaptureState::Phase::Active; state->changed.notify_all(); return true;
+}
+void MacInputCapture::disarm() { if(state) state->cancel(); }
+MacInputCapture::Status MacInputCapture::status()
+{
+    if(!state) return {MkbCaptureState::Phase::Idle,lastError};
+    bool timeout=false;
+    {
+        std::lock_guard<std::mutex> lock(state->control);
+        timeout=(state->phase==MkbCaptureState::Phase::Pending || state->phase==MkbCaptureState::Phase::Ready) && now()-state->requestedAt>2000;
+    }
+    if(timeout) state->fail("capture-startup-timeout");
+    std::lock_guard<std::mutex> lock(state->control); return {state->phase,state->error};
+}
+std::string MacInputCapture::failure() const
+{
+    if(!lastError.empty()) return lastError;
+    if(!state) return "capture-stopped";
+    std::lock_guard<std::mutex> lock(state->control); return state->error.empty() ? "capture-stopped" : state->error;
+}
+bool MacInputCapture::drain(std::deque<Event> &events,std::string &failure)
+{
+    if(!state) { events.clear();failure="capture-stopped";return false; }
+    state->heartbeat=now();
+    const bool healthy=state->input.drain(events,failure,now(),&MacInputCapture::nowNs);
+    return state->finishDrain(events,failure,healthy);
+}
diff --git a/gui/include/mkbwindowinput.h b/gui/include/mkbwindowinput.h
new file mode 100644
index 0000000..d5f9ffd
--- /dev/null
+++ b/gui/include/mkbwindowinput.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <QEvent>
+#include <QKeyEvent>
+#include <functional>
+
+namespace MkbWindowInput {
+enum Result { Continue, Consume, PassSystem };
+inline bool toggleChord(const QKeyEvent &key)
+{
+    // Qt's ControlModifier is the physical Command key on macOS.
+    return key.key()==Qt::Key_Escape && key.modifiers()==Qt::ControlModifier;
+}
+inline bool toggleShortcut(const QKeyEvent &key)
+{
+    return key.type()==QEvent::KeyPress && !key.isAutoRepeat() && toggleChord(key);
+}
+inline Result handle(QEvent *event, bool active, bool blocked, bool focused,
+    const std::function<void(const char *)> &release, const std::function<void(bool)> &toggle, bool busy=false, bool mappedCommand=false)
+{
+    if(event->type()==QEvent::WindowDeactivate) { release("focus-loss"); return Continue; }
+    if(event->type()==QEvent::KeyPress || event->type()==QEvent::KeyRelease) {
+        auto &key=*static_cast<QKeyEvent *>(event);
+        if(toggleChord(key)) {
+            if(toggleShortcut(key) && !blocked) toggle(focused);
+            return Consume; // Repeats and key-up never undo a just-enabled capture.
+        }
+        if(key.key()==Qt::Key_Escape) {
+            // Invalidate a grant sampled before begin, including an idle window.
+            // Preserve ordinary Escape routing when no capture/transaction owns it.
+            if(key.type()==QEvent::KeyPress && !key.isAutoRepeat()) release("escape");
+            return active || busy ? Consume : Continue;
+        }
+        const bool modifier=key.key()==Qt::Key_Control || key.key()==Qt::Key_Meta
+            || key.key()==Qt::Key_Alt || key.key()==Qt::Key_Shift;
+#ifdef Q_OS_MACOS
+        if(active && mappedCommand && (key.modifiers() & Qt::ControlModifier) &&
+            !(key.modifiers() & Qt::MetaModifier)) return Consume;
+#else
+        (void)mappedCommand;
+#endif
+        if(key.type()==QEvent::KeyPress && !modifier &&
+            (key.modifiers() & (Qt::ControlModifier|Qt::MetaModifier))) {
+            if(active) release("system-shortcut");
+            return PassSystem;
+        }
+        if(active) return Consume;
+    }
+    if(active && (event->type()==QEvent::MouseMove || event->type()==QEvent::MouseButtonPress
+        || event->type()==QEvent::MouseButtonRelease || event->type()==QEvent::MouseButtonDblClick
+        || event->type()==QEvent::TouchBegin || event->type()==QEvent::TouchUpdate || event->type()==QEvent::TouchEnd))
+        return Consume;
+    return Continue;
+}
+}
diff --git a/gui/include/mkbprofile.h b/gui/include/mkbprofile.h
new file mode 100644
index 0000000..5737866
--- /dev/null
+++ b/gui/include/mkbprofile.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <map>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct MkbAxisPoint { double speed, stick; };
+struct MkbAimMode {
+    double gain = 0.015, smoothing_ms = 0, cm360 = 0;
+    std::vector<MkbAxisPoint> x, y;
+};
+struct MkbProfile {
+    std::string name = "Встроенный, некалиброванный";
+    std::string error;
+    std::string digest;
+    double dpi = 0, radial_deadzone = 0;
+    bool rapid_fire_enabled = false;
+    uint32_t rapid_fire_interval_ms = 120, rapid_fire_press_ms = 40;
+    double recoil_vertical = 0;
+    bool recoil_enabled = false;
+    bool recoil_pulse = false;
+    double recoil_pulse_peak = .11;
+    uint32_t recoil_period_ms = 120;
+    std::map<std::string, std::string> calibration;
+    MkbAimMode hip, ads;
+    bool radial_menu_enabled = false;
+    double radial_menu_gain = .015;
+    uint32_t radial_menu_open_delay_ms = 350;
+    std::vector<int> radial_menu_actions;
+    // macOS virtual key codes; mouse buttons use 256 + CGMouseButton.
+    std::map<int, int> binds;
+    static MkbProfile defaults();
+    static MkbProfile load(const std::string &path);
+    static MkbProfile fromBytes(const std::string &bytes);
+    std::string compatibilityError(bool hid) const {
+        if(!valid())return error;
+        if(hid)for(const auto &binding:binds)if(binding.first>=261)
+            return "HID поддерживает левую, правую, среднюю и две боковые кнопки мыши";
+        return {};
+    }
+    bool valid() const { return error.empty(); }
+    std::string label() const;
+};
+
+// Device-specific Command bits shared by CGEvent and Qt nativeModifiers.
+inline bool MkbMappedCommand(const MkbProfile &profile, uint64_t flags)
+{
+    return ((flags & 0x10) && profile.binds.count(54)) ||
+        ((flags & 0x08) && profile.binds.count(55));
+}
+
+// Возвращает причину отказа bounded JSON, включая duplicate keys.
+std::string MkbJsonError(const std::string &input);

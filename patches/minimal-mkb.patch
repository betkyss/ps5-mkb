+        return s;
+    }
+    ~MkbWorker(){shutdownAndJoin();}
+    bool running()const {MkbStatusPublication<5>::Words value{};return control->view.read(value) && !value[0];}
+    void requestArm(MkbCaptureToken token);
+    // Acceptance and cancellation share this lock. Return the accepted revision,
+    // never infer it from a later passive read. A stale cancel cannot clear a new slot.
+    uint64_t cancelReconfigure(uint64_t expected=0) {
+        std::lock_guard<std::mutex> lock(control->mutex);
+        if(control->candidate && (!expected || control->revision==expected)){control->discardedRevision=control->revision;control->candidate.reset();}
+        control->publishView();return control->acceptedRevision;
+    }
+    bool reconfigure(std::shared_ptr<const MkbProfile> candidate,uint64_t revision) {
+        std::lock_guard<std::mutex> lock(control->mutex);
+        if(cameraProbe)return false;
+        if(control->closed || control->shutdown || control->candidate || !candidate || !candidate->valid())return false;
+        control->candidate=std::move(candidate);control->revision=revision;control->live=false;control->publishView();control->wake.notify_all();return true;
+    }
+    bool reconfigureLive(std::shared_ptr<const MkbProfile> candidate,uint64_t revision,MkbCaptureToken token,uint64_t runtimeRevision) {
+        std::lock_guard<std::mutex> lock(control->mutex);
+        if(cameraProbe || control->closed || control->shutdown || control->candidate || !candidate || !candidate->valid())return false;
+        control->candidate=std::move(candidate);control->revision=revision;control->live=true;
+        control->token=token;control->liveActive=gate->engaged();control->runtimeRevision=runtimeRevision;control->publishView();control->wake.notify_all();return true;
+    }
+    uint64_t discardedRevision() const {MkbStatusPublication<5>::Words w{};return control->view.read(w)?w[3]:0;}
+    void requestRelease(MkbCaptureToken token,MkbStopReason reason,const char *text);
+    Snapshot snapshot(uint64_t *sampleNs=nullptr)const {
+        MkbStatusPublication<20>::Words w{};Snapshot s;
+        if(!publication.read(w)){s.phase=Phase::Stopped;MkbCopyReason(s.reason,"status-unavailable");if(sampleNs)*sampleNs=0;return s;}
+        s.phase=Phase(w[0]);s.token={w[1],w[2]};s.code=MkbStopReason(w[3]);
+        s.owner=w[4];s.ticks=w[5];s.skipped=w[6];
+        std::memcpy(s.reason.data(),w.data()+7,s.reason.size());
+        if(sampleNs)*sampleNs=w[19];return s;
+    }
+    std::shared_ptr<MkbCaptureLifecycle> lifecycleHandle()const {return lifecycle;}
+    MkbCaptureLifecycle::Snapshot metadata() const {auto value=lifecycle->snapshot();MkbStatusPublication<5>::Words state{};if(control->view.read(state))value.revision=state[1];else value.known=false;return value;}
+    void shutdownAndJoin();
+};
+
+// Принятый ABI footprint из commit 700f245acd4386a9fd92bceb57b95efc4c422e7c.
+static_assert(sizeof(MkbWorker::Snapshot)==152,"accepted worker snapshot footprint");

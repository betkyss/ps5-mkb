+    }
+    void closeAndDetach(){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};if(closed)return;cancelRecovery();neutral("detach",MkbStopReason::Shutdown);cancelRecovery();session.stop();closed=true;setter={};reservation=Reservation::None;}
+};

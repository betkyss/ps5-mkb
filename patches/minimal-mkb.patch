+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbworkertypes.h"
+#include "mkbstatuspublication.h"
+#include <chiaki/session.h>
+class MkbSubmissionGate {
+public:
+    enum class Reservation { None, Preparing, Active, Releasing };
+    struct Result {bool accepted=false;uint64_t id=0;int error=0;};
+    struct View {bool known=false,ready=false,healthy=false,closed=false;Reservation reservation=Reservation::None;

+        if(accepted && setter && !closed) row.result=setter(state);
+        if(trace && trace->active){row.end=MkbNativePhaseTrace::now();trace->append(row);}
+        return {accepted,row.id,row.result};
+    }
+    Result write(ChiakiControllerState state,MkbCaptureToken t,const char *reason,MkbStopReason kind,bool accepted=true) {

+
+// Одна точка загрузки и передачи профиля mapper/capture, без запуска event tap.
+inline std::unique_ptr<MkbMapper> CreateMkbMapper(MkbMapper::Submit submit,
+    const std::function<void(const MkbProfile &)> &configureCapture)
+{
+    const bool explicitProfile=qEnvironmentVariableIsSet("CHIAKI_MKB_PROFILE");
+    const auto profile=explicitProfile ? MkbProfile::load(qEnvironmentVariable("CHIAKI_MKB_PROFILE").toStdString()) : MkbProfile::defaults();
+    configureCapture(profile);
+    std::unique_ptr<MkbMapper> mapper(new MkbMapper(std::move(submit),profile));
+    bool ok=false;
+    double gain=qEnvironmentVariable("CHIAKI_MKB_SENSITIVITY").toDouble(&ok);
+    if(ok && !explicitProfile) mapper->setSensitivity(gain);
+    return mapper;
+}

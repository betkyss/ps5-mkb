+    MkbSessionGate session;
+    Setter setter;
+    bool focused=true,blocked=false,closed=false,fault=false;
+    Reservation reservation=Reservation::None;
+    MkbCaptureToken token{};uint64_t nextCapture=0,submitId=0,releaseBeginNs=0;
+    std::shared_ptr<MkbGateTrace> trace;
+    MkbStopReason lastCode=MkbStopReason::None;std::array<char,96> lastReason{};
+    MkbStatusPublication<9> publication;
+    enum class RecoveryState { None, Pending, Succeeded, Exhausted, Cancelled };
+    RecoveryState recoveryState=RecoveryState::None;
+    const char *recoveryOutcomeLocked()const {
+        switch(recoveryState){case RecoveryState::Pending:return "pending";case RecoveryState::Succeeded:return "succeeded";
+        case RecoveryState::Exhausted:return "exhausted";case RecoveryState::Cancelled:return "cancelled";default:return "not-required";}
+    }
+    void sealTraceLocked(){if(trace)trace->seal(releaseBeginNs,recoveryOutcomeLocked());}
+    struct NeutralEpisode {bool pending=false;MkbCaptureToken token{};uint64_t generation=0,dueNs=0;unsigned retries=0;} recovery;
+    void beginReleasing(){if(!releaseBeginNs)releaseBeginNs=MkbNativePhaseTrace::now();if(reservation!=Reservation::None)reservation=Reservation::Releasing;}
+    void resetRecovery(){cancelRecovery();recoveryState=RecoveryState::None;recovery={};releaseBeginNs=0;}
+    void cancelRecovery(){if(recovery.pending)recoveryState=RecoveryState::Cancelled;recovery.pending=false;}
+    void scheduleRecovery(MkbCaptureToken t){
+        cancelRecovery();
+        if(!session.ready() || (t && t.session!=session.generation()))return;

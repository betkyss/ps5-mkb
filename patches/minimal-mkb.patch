+        v.token={w[4],w[5]};v.generation=w[6];v.revision=w[7];v.sampleNs=w[8];return v;
+    }
+    uint64_t beginSession() {std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};if(closed)return 0;cancelRecovery();sealTraceLocked();resetRecovery();fault=false;auto id=session.start();beginReleasing();neutral("start",MkbStopReason::Session);return id;}
+    uint64_t observeConnected(){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};return session.observeConnected();}
+    bool acceptConnected(uint64_t id){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};return !closed && session.connected(id);}
+    MkbSessionGate::QuitNotice observeQuit(){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};cancelRecovery();auto n=session.quit();beginReleasing();neutral("quit",MkbStopReason::Session);return n;}
+    void stopSession(){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};cancelRecovery();session.stop();beginReleasing();neutral("stop",MkbStopReason::Session);}
+    bool canRetry(const MkbSessionGate::QuitNotice &n)const {std::lock_guard<std::mutex> l(mutex);return !closed&&session.canRetry(n);}
+    bool shouldHandleQuit(const MkbSessionGate::QuitNotice &n)const {std::lock_guard<std::mutex> l(mutex);return !closed&&session.shouldHandleQuit(n);}
+    bool isCurrent(uint64_t n)const {std::lock_guard<std::mutex> l(mutex);return !closed&&session.isCurrent(n);}
+    bool ready()const {std::lock_guard<std::mutex> l(mutex);return eligible();}
+    void setEligibility(bool focus,bool block) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};focused=focus;blocked=block;
+        if((!focus||block) && reservation!=Reservation::None && reservation!=Reservation::Releasing){beginReleasing();neutral("eligibility",MkbStopReason::Eligibility);}
+    }
+    void setBlocked(bool value) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};blocked=value;
+        if(value && reservation!=Reservation::None && reservation!=Reservation::Releasing){beginReleasing();neutral("blocked",MkbStopReason::Eligibility);}
+    }
+    std::pair<MkbStopReason,std::array<char,96>> stopInfo()const {std::lock_guard<std::mutex> l(mutex);return {lastCode,lastReason};}
+    MkbCaptureToken reserveCapture() {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(!eligible()||reservation!=Reservation::None||nextCapture==UINT64_MAX)return {};
+        sealTraceLocked();resetRecovery();token={session.generation(),++nextCapture};reservation=Reservation::Preparing;
+        if(trace)trace->open();neutral("reserve",MkbStopReason::None);return token;
+    }
+    bool activateCapture(MkbCaptureToken t) {std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};if(!same(t)||!eligible()||reservation!=Reservation::Preparing)return false;reservation=Reservation::Active;return true;}
+    bool valid(MkbCaptureToken t)const {std::lock_guard<std::mutex> l(mutex);return same(t)&&t.session==session.generation()&&eligible()&&(reservation==Reservation::Preparing||reservation==Reservation::Active);}
+    bool revokeCapture(MkbCaptureToken t,const char *why,MkbStopReason kind) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(!same(t)||t.session!=session.generation()||reservation==Reservation::None||reservation==Reservation::Releasing)return false;
+        beginReleasing();neutral(why,kind);return true;
+    }
+    uint64_t releaseTimestamp(MkbCaptureToken t)const {std::lock_guard<std::mutex> l(mutex);return same(t)?releaseBeginNs:0;}
+    bool releasePending(MkbCaptureToken t)const {std::lock_guard<std::mutex> l(mutex);return same(t)&&reservation==Reservation::Releasing;}
+    bool completeRelease(MkbCaptureToken t){std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};if(!same(t)||reservation!=Reservation::Releasing)return false;cancelRecovery();sealTraceLocked();reservation=Reservation::None;return true;}
+    Result submitNeutral() {std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(closed || fault || !session.ready())return {};return neutral("dashboard-neutral",MkbStopReason::Release);}
+    // Called only by the idle/releasing owner. Success cannot clear the fault.
+    bool retryNeutral(uint64_t nowNs) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(!recovery.pending)return false;
+        if(closed || !fault || recovery.generation!=session.generation() || !session.ready()
+            || (recovery.token && (recovery.token!=token || recovery.token.session!=recovery.generation))
+            || (!recovery.token && reservation!=Reservation::None)
+            || reservation==Reservation::Active || reservation==Reservation::Preparing){cancelRecovery();return false;}
+        if(nowNs<recovery.dueNs)return false;
+        ChiakiControllerState idle;chiaki_controller_state_set_idle(&idle);
+        const auto result=writeOnce(idle,recovery.token,"submit-error-neutral-retry",MkbStopReason::Submit);
+        ++recovery.retries;
+        if(!result.error || recovery.retries>=3){recovery.pending=false;recoveryState=result.error?RecoveryState::Exhausted:RecoveryState::Succeeded;}
+        else recovery.dueNs=std::max(nowNs,MkbNativePhaseTrace::now())+(recovery.retries==1?16000000:32000000);
+        return true;
+    }
+    uint64_t recoveryDeadline()const {std::lock_guard<std::mutex> l(mutex);return recovery.pending?recovery.dueNs:0;}
+    const char *recoveryOutcome()const {std::lock_guard<std::mutex> l(mutex);return recoveryOutcomeLocked();}
+    MkbGateTrace::Terminal sealTrace(){std::lock_guard<std::mutex> l(mutex);sealTraceLocked();return trace&&trace->used?trace->terminal:MkbGateTrace::Terminal{0,releaseBeginNs,recoveryOutcomeLocked()};}
+    uint64_t generation()const {std::lock_guard<std::mutex> l(mutex);return session.generation();}
+    bool healthy()const {std::lock_guard<std::mutex> l(mutex);return !closed && !fault && session.ready();}
+    bool engaged()const {std::lock_guard<std::mutex> l(mutex);return reservation!=Reservation::None;}
+    MkbCaptureToken current()const {std::lock_guard<std::mutex> l(mutex);return token;}
+    Result submitWorker(MkbCaptureToken t,ChiakiControllerState state,const char *why) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(!same(t)||t.session!=session.generation()||!eligible()||reservation==Reservation::None||reservation==Reservation::Releasing)return write(state,t,why,MkbStopReason::None,false);
+        if(reservation==Reservation::Preparing)chiaki_controller_state_set_idle(&state);
+        return write(state,t,why,MkbStopReason::None);
+    }
+    Result submitLegacy(ChiakiControllerState state) {
+        std::lock_guard<std::mutex> l(mutex);PublishOnExit publish{*this};
+        if(closed||fault||reservation!=Reservation::None)return {};

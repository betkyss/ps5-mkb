+MkbMapper::MkbMapper(Submit sink, MkbProfile config) : submit(std::move(sink)), profile(std::move(config))
+{
+    if(!validRadialConfig(profile))
+        profile.error="Некорректные параметры круговых меню";
+    else if(!std::isfinite(profile.recoil_vertical) || profile.recoil_vertical < 0 || profile.recoil_vertical > .25)
+        profile.error = "Компенсация отдачи должна быть от 0 до 0.25";
+    else if(!std::isfinite(profile.recoil_pulse_peak) || profile.recoil_pulse_peak<.001 ||
+        profile.recoil_pulse_peak>.25 || profile.recoil_period_ms<32 || profile.recoil_period_ms>496 || profile.recoil_period_ms%8)
+        profile.error = "Некорректные параметры импульсной компенсации";
+    else if(profile.rapid_fire_interval_ms<64 || profile.rapid_fire_interval_ms>1000 ||
+        profile.rapid_fire_interval_ms%8 || profile.rapid_fire_press_ms<16 ||
+        profile.rapid_fire_press_ms>496 || profile.rapid_fire_press_ms%8 ||
+        profile.rapid_fire_press_ms>=profile.rapid_fire_interval_ms)
+        profile.error = "Некорректные параметры автотапа";
+    else recoil_vertical = profile.recoil_vertical;
+}
+unsigned MkbMapper::menuMask(const std::array<bool, Count> &state) const
+{
+    unsigned mask=0;
+    if(profile.radial_menu_enabled) for(int action:profile.radial_menu_actions)
+        if(action>=0 && action<Count && state[action]) mask|=1U<<action;
+    return mask;
+}
+void MkbMapper::clearMenu()
+{
+    menu_reset_at=menu_ready_at=0;menu_mask=0; menu_x=menu_y=0; menu_report=menu_boundary_report=menu_close_neutral=false;
+}
+void MkbMapper::transitionMenu(unsigned mask, uint64_t at, uint64_t sourceTime)
+{
+    if(mask==menu_mask) return;
+    // Flush the old selection with its opener still held, before any release.
+    if(menu_mask) emitState("menu-final",false);
+    // Once a guarded menu closes, only movement sourced after the actual
+    // release can reach the camera. Do not keep the cancelled future deadline.
+    const auto dispatchedAt=std::max(at,recoil_now_ms);
+    const auto resetAt=!mask && profile.radial_menu_open_delay_ms?dispatchedAt:sourceTime;
+    menu_reset_at=std::max(menu_reset_at,resetAt);
+    menu_close_neutral=menu_mask && !mask;
+    menu_mask=mask; menu_x=menu_y=0;
+    // Source, ingest and dispatch share an epoch. The opener reaches the game
+    // only now, so queued input must not consume any of the opening guard.
+    menu_ready_at=mask && profile.radial_menu_open_delay_ms?
+        radialDeadline(dispatchedAt,profile.radial_menu_open_delay_ms):0;
+    x=y=smooth_x=smooth_y=0; emitted_right_x=emitted_right_y=0;
+    segment_start=std::max(segment_start,at);
+}
+bool MkbMapper::reconfigure(const MkbProfile &candidate,uint64_t expectedRuntime,uint64_t at,bool deferSubmit)
+{
+    if(!candidate.valid() || !validRadialConfig(candidate) || (armed && runtime_revision!=expectedRuntime)) return false;
+    const bool hadMenu=menu_mask!=0;
+    defer_output=deferSubmit;
+    auto oldActions=profile.radial_menu_actions, newActions=candidate.radial_menu_actions;
+    std::sort(oldActions.begin(),oldActions.end());std::sort(newActions.begin(),newActions.end());
+    bool menuChanged=profile.radial_menu_enabled!=candidate.radial_menu_enabled ||
+        profile.radial_menu_gain!=candidate.radial_menu_gain ||
+        profile.radial_menu_open_delay_ms!=candidate.radial_menu_open_delay_ms || oldActions!=newActions;
+    const auto boundary=at?at:last_tick;
+    for(const auto &binding:profile.binds) {
+        const auto next=candidate.binds.find(binding.first);
+        if(next==candidate.binds.end() || next->second!=binding.second)rebindingAt[binding.first]=boundary;
+    }
+    for(const auto &binding:candidate.binds) {
+        const auto old=profile.binds.find(binding.first);
+        if(old==profile.binds.end() || old->second!=binding.second)rebindingAt[binding.first]=boundary;
+    }
+    // Release old logical actions while retaining physical down state. Remapped
+    // sources cannot press a new action until a real up followed by down.
+    for(const auto &held:sources) if(held.second && !suppressed.count(held.first)) {
+        const auto old=profile.binds.find(held.first);const auto next=candidate.binds.find(held.first);
+        if(old!=profile.binds.end() && (next==candidate.binds.end() || old->second!=next->second)) {
+            const auto action=static_cast<Key>(old->second);
+            if(holds[action]) --holds[action];
+            applyKey(action,holds[action]!=0,last_tick,boundary);
+        }
+        if((old==profile.binds.end())!=(next==candidate.binds.end()) ||
+           (old!=profile.binds.end() && next!=candidate.binds.end() && old->second!=next->second)) suppressed.insert(held.first);
+    }
+    const bool hadSequence=hold_left || hold_right || dodge!=Dodge::Idle;
+    hold_left=hold_right=false; dodge=Dodge::Idle;
+    if(hadSequence) emitState("sequence-cancel",false);
+    for(const auto &binding:candidate.binds)
+        if(binding.second==HoldLeft || binding.second==HoldRight || binding.second==DodgeRoll) rebindingAt[binding.first]=boundary;
+    profile=candidate;
+    recoil_enabled=profile.recoil_enabled;recoil_vertical=profile.recoil_vertical;
+    rapid_fire_enabled=profile.rapid_fire_enabled;
+    if(menuChanged || menu_mask!=menuMask(keys)) {
+        menu_mask=menuMask(keys);menu_x=menu_y=0;
+        menu_ready_at=menu_mask && profile.radial_menu_open_delay_ms?
+            radialDeadline(std::max(boundary,recoil_now_ms),profile.radial_menu_open_delay_ms):0;
+        if(hadMenu || menu_mask) {
+            menu_reset_at=std::max(menu_reset_at,boundary);
+            x=y=smooth_x=smooth_y=0;emitted_right_x=emitted_right_y=0;
+            emitState("menu-config",false);
+        }
+    }
+    // Keep mouse accumulation, smoothing, cadence and the current fire phase.
+    defer_output=false;return true;
+}
+void MkbMapper::flushReconfigure()
+{
+    auto pending=std::move(deferred_output);deferred_output.clear();
+    for(const auto &entry:pending)submit(entry.first,entry.second.c_str());
+}
+bool MkbMapper::rapidFirePressed()
+{
+    if(!armed || !keys[R2]) { rapid_fire_started=false; return false; }
+    if(!rapid_fire_enabled) { rapid_fire_started=false; return true; }
+    if(!rapid_fire_started) {
+        rapid_fire_started=true;rapid_fire_pressed=true;
+        rapid_fire_deadline_ms=recoil_now_ms+profile.rapid_fire_press_ms;
+    } else if(recoil_now_ms>=rapid_fire_deadline_ms) {
+        // Emit each edge before scheduling the next. A late tick must not skip
+        // the release phase or replay a burst of overdue taps.
+        rapid_fire_pressed=!rapid_fire_pressed;
+        const uint32_t duration=rapid_fire_pressed?profile.rapid_fire_press_ms:
+            profile.rapid_fire_interval_ms-profile.rapid_fire_press_ms;
+        rapid_fire_deadline_ms=recoil_now_ms+duration;
+    }
+    return rapid_fire_pressed;
+}
+MkbMapper::RecoilState MkbMapper::recoilState() const
+{
+    RecoilState state;
+    state.enabled=armed && recoil_enabled;
+    state.rapidFireEnabled=armed && rapid_fire_enabled;
+    state.aiming=armed && keys[L2]; state.firing=armed && keys[R2];
+    state.strength=recoil_vertical;
+    state.pulseMode=profile.recoil_pulse;
+    state.pulsePeak=profile.recoil_pulse?std::max(recoil_vertical,profile.recoil_pulse_peak):profile.recoil_pulse_peak;
+    state.pulsePeriodMs=profile.recoil_period_ms;
+    state.applying=recoilCorrection()!=0;
+    state.pulsePause=profile.recoil_pulse && recoilEligible() && recoilSignal()==0;
+    return state;
+}
+bool MkbMapper::recoilEligible() const
+{
+    return armed && !menu_mask && recoil_enabled && keys[L2] && keys[R2] && recoil_vertical>0 &&
+        !keys[LookUp] && !keys[LookDown] && !keys[LookLeft] && !keys[LookRight];
+}
+void MkbMapper::updateRecoilPhase()
+{
+    if(!profile.recoil_pulse || !recoilEligible()) {pulse_started=false;return;}
+    if(!pulse_started) {pulse_start_ms=recoil_now_ms;pulse_started=true;}
+}
+double MkbMapper::recoilSignal() const
+{
+    if(!recoilEligible()) return 0;
+    if(!profile.recoil_pulse || recoil_vertical>=profile.recoil_pulse_peak) return recoil_vertical;
+    if(!pulse_started || recoil_now_ms<pulse_start_ms) return 0;
+    const auto elapsed=recoil_now_ms-pulse_start_ms;
+    const auto cycle=elapsed/profile.recoil_period_ms;
+    const auto position=elapsed%profile.recoil_period_ms;
+    // Spend fractional ON-time credit in existing 8-ms input quanta. A tiny
+    // target skips cycles, rather than receiving an 8-ms pulse every cycle.
+    const long double quota=static_cast<long double>(profile.recoil_period_ms)*
+        static_cast<long double>(recoil_vertical)/static_cast<long double>(profile.recoil_pulse_peak)/8.L;
+    const long double first=std::floor(static_cast<long double>(cycle)*quota+1e-12L);
+    const long double next=std::floor((static_cast<long double>(cycle)+1.L)*quota+1e-12L);
+    const long double onMs=std::min(static_cast<long double>(profile.recoil_period_ms),(next-first)*8.L);
+    return static_cast<long double>(position)<onMs?profile.recoil_pulse_peak:0;
+}
+int MkbMapper::recoilCorrection() const
+{
+    const int correction=int(recoilSignal()*32767);
+    return std::max(-32767,std::min(32767,int(emitted_right_y)+correction))-int(emitted_right_y);
+}
+void MkbMapper::setSensitivity(double value)
+{
+    if(std::isfinite(value) && value > 0 && value <= 1) profile.hip.gain = profile.ads.gain = value;
+}
+bool MkbMapper::arm(bool connected, bool focused, bool blocked, uint64_t now)
+{
+    if(armed || !profile.valid() || !connected || !focused || blocked) return false;
+    clearMenu();
+    keys.fill(false); holds.fill(0); sources.clear(); suppressed.clear(); rebindingAt.clear(); x = y = smooth_x = smooth_y = 0; aim_ads = false; emitted_right_x = emitted_right_y = 0; ++epoch; segment_start = last_tick = armed_at = now; armed = true;
+    hold_left=hold_right=false; dodge=Dodge::Idle;
+    rapid_fire_enabled=profile.rapid_fire_enabled;rapid_fire_started=false;
+    recoil_enabled = profile.recoil_enabled;recoil_vertical=profile.recoil_vertical;recoil_now_ms=now;pulse_started=false;
+    emitState("arm", false);
+    return true;
+}
+void MkbMapper::release(const char *reason)
+{
+    clearMenu();
+    armed = false; ++epoch; keys.fill(false); holds.fill(0); sources.clear(); suppressed.clear(); rebindingAt.clear(); x = y = smooth_x = smooth_y = 0; aim_ads = false; emitted_right_x = emitted_right_y = 0; last_reason = reason;
+    hold_left=hold_right=false; dodge=Dodge::Idle;
+    rapid_fire_enabled=false;rapid_fire_started=false;
+    recoil_enabled = false;pulse_started=false;
+    emitState(reason, false);
+}
+bool MkbMapper::validate(uint64_t generation, uint64_t timestamp, uint64_t now)
+{
+    if(!armed || generation != epoch || timestamp < armed_at) return false;
+    if(now < timestamp || now - timestamp > 100 || now < last_tick || now - last_tick > 250)
+    { release("stale-event-or-handler-stall"); return false; }
+    return true;
+}
+void MkbMapper::key(uint64_t generation, Key key, bool down, uint64_t timestamp, uint64_t now)
+{
+    if(!validate(generation, timestamp, now) || key < 0 || key >= Count) return;
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    const bool sequence=(key==HoldLeft || key==HoldRight || key==DodgeRoll) && down && !keys[key];
+    applyKey(key, down, timestamp, timestamp);
+    if(sequence) startSequence(key);
+}
+void MkbMapper::applyKey(Key key, bool down, uint64_t segmentTime, uint64_t sourceTime)
+{
+    if(keys[key] == down) return;
+    if(!menu_report) {
+        auto next=keys;next[key]=down;transitionMenu(menuMask(next),segmentTime,sourceTime);
+    }
+    if(!menu_mask && key == L2 && !identicalAimModes(profile.hip, profile.ads)) {
+        // Consume queued deltas under the mode and time interval that produced them.
+        const uint64_t end = std::max(segment_start, segmentTime);
+        if(x != 0 || y != 0) {
+            tick_dt = std::max<uint64_t>(1, end - segment_start) / 1000.0;
+            emitState("mode-segment", true); x = y = 0;
+        }
+        segment_start = end;
+    }
+    keys[key] = down;
+    if(key==HoldLeft || key==HoldRight || key==DodgeRoll) return;
+    if(key==R2 && !down) rapid_fire_started=false;
+    if(key == RapidFireToggle) {
+        if(down) {rapid_fire_enabled=!rapid_fire_enabled;rapid_fire_started=false;++runtime_revision;}
+        emitState(rapid_fire_enabled?"rapid-fire-on":"rapid-fire-off",false);
+        return;
+    }
+    if(key >= RecoilToggle && key <= RecoilIncrease) {
+        if(down) {
+            ++runtime_revision;
+            if(key == RecoilToggle) recoil_enabled = !recoil_enabled;
+            else {
+                const auto prior=recoil_vertical;
+                recoil_vertical = std::max(0.0, std::min(.25,
+                    recoil_vertical + (key == RecoilIncrease ? .005 : -.005)));
+                if(recoil_vertical!=prior) pulse_started=false;
+            }
+            char reason[64];
+            std::snprintf(reason, sizeof(reason), "recoil-%s-%.1fpct",
+                recoil_enabled ? "on" : "off", recoil_vertical * 100);
+            emitState(reason, false);
+        } else emitState("release", false);
+        return;
+    }
+    if(key>=LookUp && key<=LookRight) {menu_x=menu_y=0;x=y=smooth_x=smooth_y=0;emitted_right_x=emitted_right_y=0;}
+    // Every transition reaches the local submit, even down/up between timer ticks.
+    emitState(down ? "press" : "release", false);
+}
+void MkbMapper::physical(uint64_t generation, int source, bool down, uint64_t timestamp, uint64_t now, bool repeat)
+{
+    if(!validate(generation, timestamp, now)) return;
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    applyPhysical(source, down, timestamp, repeat, timestamp);
+}
+void MkbMapper::applyPhysical(int source, bool down, uint64_t segmentTime, bool repeat, uint64_t sourceTime)
+{
+    // Caps Lock flagsChanged is one pulse in either toggle state, never a hold.
+    if(source==57) {
+        const auto binding=profile.binds.find(source);
+        const auto barrier=rebindingAt.find(source);
+        if(down && !repeat && binding!=profile.binds.end() && binding->second==DodgeRoll &&
+            (barrier==rebindingAt.end() || segmentTime>barrier->second)) startSequence(DodgeRoll);
+        return;
+    }
+    if(suppressed.count(source)) { sources[source]=down;if(!down && segmentTime>rebindingAt[source]){suppressed.erase(source);rebindingAt.erase(source);}return; }
+    const auto barrier=rebindingAt.find(source);
+    if(barrier!=rebindingAt.end()) {
+        if(down && segmentTime<=barrier->second){sources[source]=true;suppressed.insert(source);return;}
+        if(segmentTime>barrier->second)rebindingAt.erase(barrier);
+    }
+    if(repeat)return;
+    const bool wasDown=sources[source];
+    sources[source]=down;
+    auto binding = profile.binds.find(source);
+    if(binding == profile.binds.end()) return;
+    if(binding->second < 0 || binding->second >= Count) return;
+    if(wasDown == down) return;
+    auto action = static_cast<Key>(binding->second);
+    if(down) ++holds[action]; else if(holds[action]) --holds[action];
+    applyKey(action, holds[action] != 0, segmentTime, sourceTime);
+    if(down && (action==HoldLeft || action==HoldRight || action==DodgeRoll)) startSequence(action);
+}
+
+bool MkbMapper::validateIngest(uint64_t generation, uint64_t sourceTime, uint64_t ingestTime, uint64_t now)
+{
+    if(!validate(generation, sourceTime, now)) return false;
+    if(ingestTime < armed_at || ingestTime > now) {
+        release("invalid-ingest-time"); return false;
+    }
+    return true;
+}
+bool MkbMapper::physicalIngest(uint64_t generation, int source, bool down, uint64_t sourceTime,
+    uint64_t ingestTime, uint64_t now, bool repeat)
+{
+    if(!validateIngest(generation, sourceTime, ingestTime, now)) return false;
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    applyPhysical(source, down, ingestTime, repeat, sourceTime);
+    return true;
+}
+bool MkbMapper::report(uint64_t generation, double dx, double dy, uint8_t buttons,
+    uint64_t sourceTime, uint64_t ingestTime, uint64_t now)
+{
+    if(!validateIngest(generation, sourceTime, ingestTime, now)) return false;
+    if(!std::isfinite(dx) || !std::isfinite(dy) || (buttons & ~uint8_t(31))) {
+        release("invalid-report"); return false;
+    }
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    // Update all physical holds before emitting logical transitions. A snapshot
+    // can move a held action between mouse aliases without releasing it.
+    std::array<bool,5> changed{};
+    for(unsigned i=0;i<5;++i) {
+        const int source=256+int(i);const bool down=(buttons&(1U<<i))!=0;
+        const bool wasDown=sources[source];sources[source]=down;
+        if(suppressed.count(source)) {if(!down && ingestTime>rebindingAt[source]){suppressed.erase(source);rebindingAt.erase(source);}continue;}
+        const auto barrier=rebindingAt.find(source);
+        if(barrier!=rebindingAt.end()) {
+            if(down && ingestTime<=barrier->second){suppressed.insert(source);continue;}
+            if(ingestTime>barrier->second)rebindingAt.erase(barrier);
+        }
+        const auto binding=profile.binds.find(source);
+        if(binding==profile.binds.end() || binding->second<0 || binding->second>=Count) continue;
+        if(wasDown==down) continue;
+        changed[i]=true;sources[source]=down;
+        auto &count=holds[binding->second];
+        if(down) ++count;else if(count) --count;
+    }
+    auto finalKeys=keys;
+    for(unsigned i=0;i<5;++i) if(changed[i]) {
+        const auto action=profile.binds.at(256+int(i));finalKeys[action]=holds[action]!=0;
+    }
+    const unsigned nextMask=menuMask(finalKeys);
+    const bool boundary=nextMask!=menu_mask;
+    const bool guardedClose=boundary && !nextMask && profile.radial_menu_open_delay_ms;
+    const bool movementCurrent=!guardedClose && (!menu_reset_at || sourceTime>menu_reset_at ||
+        (boundary && sourceTime==menu_reset_at));
+    transitionMenu(nextMask,ingestTime,sourceTime);
+    menu_report=true;menu_boundary_report=boundary;
+    // Usage order remains 1 through 5; each action observes the complete new snapshot.
+    for(unsigned i=0;i<5;++i) if(changed[i]) {
+        const auto action=static_cast<Key>(profile.binds.at(256+int(i)));
+        applyKey(action,holds[action]!=0,ingestTime,sourceTime);
+        if(sources[256+int(i)] && (action==HoldLeft || action==HoldRight || action==DodgeRoll)) startSequence(action);
+    }
+    menu_boundary_report=false;
+    if(boundary) emitState("menu-boundary",false);
+    menu_report=false;menu_close_neutral=false;
+    // This report's motion belongs after its buttons, even when source and
+    // ingest times differ. Later reports still obey the source-time fence.
+    if(movementCurrent && (!menu_mask ||
+        (ingestTime>=menu_ready_at && sourceTime>=menu_ready_at))) accumulate(dx, dy);
+    return true;
+}
+void MkbMapper::motion(uint64_t generation, double dx, double dy, uint64_t timestamp, uint64_t now)
+{
+    if(!validate(generation, timestamp, now)) return;
+    if(!std::isfinite(dx) || !std::isfinite(dy)) { release("invalid-motion"); return; }
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    if((!menu_reset_at || timestamp>menu_reset_at) &&
+        (!menu_mask || (timestamp>=menu_ready_at))) accumulate(dx, dy);
+}
+void MkbMapper::accumulate(double dx, double dy)
+{
+    if(keys[LookUp] || keys[LookDown] || keys[LookLeft] || keys[LookRight])return;
+    if(menu_mask) {
+        menu_x+=dx*profile.radial_menu_gain;menu_y+=dy*profile.radial_menu_gain;
+        // Scale before hypot: both finite components may be near DBL_MAX.
+        const auto scale=std::max(std::abs(menu_x),std::abs(menu_y));
+        if(scale>1) {
+            menu_x/=scale;menu_y/=scale;
+            const auto norm=std::hypot(menu_x,menu_y);
+            menu_x/=norm;menu_y/=norm;
+        } else {
+            const auto norm=std::max(1.0,std::hypot(menu_x,menu_y));
+            menu_x/=norm;menu_y/=norm;
+        }
+        return;
+    }
+    x = std::max(-100000.0, std::min(100000.0, x + dx));
+    y = std::max(-100000.0, std::min(100000.0, y + dy));
+}
+void MkbMapper::startSequence(Key key)
+{
+    if(key==HoldLeft || key==HoldRight) {
+        bool &active=key==HoldLeft?hold_left:hold_right;
+        auto &deadline=key==HoldLeft?hold_left_deadline:hold_right_deadline;
+        if(active) return;
+        active=true; deadline=recoil_now_ms+600;
+    } else {
+        if(dodge!=Dodge::Idle) return;
+        dodge=keys[Moon]?Dodge::InitialGap:Dodge::First;
+        dodge_deadline=recoil_now_ms+64;
+    }
+    emitState("sequence-start",false);
+}
+void MkbMapper::advanceSequences(uint64_t now)
+{
+    if(hold_left && now>=hold_left_deadline) hold_left=false;
+    if(hold_right && now>=hold_right_deadline) hold_right=false;
+    if(dodge!=Dodge::Idle && now>=dodge_deadline) {
+        // One edge per tick, deadlines measured from the emitted edge.
+        switch(dodge) {
+        case Dodge::InitialGap: dodge=Dodge::First; break;
+        case Dodge::First: dodge=Dodge::Gap; break;
+        case Dodge::Gap: dodge=Dodge::Second; break;
+        case Dodge::Second: dodge=Dodge::FinalGap; break;
+        case Dodge::FinalGap: dodge=Dodge::Idle; break;
+        default: break;
+        }
+        dodge_deadline=now+64;
+    }
+}
+void MkbMapper::tick(uint64_t now)
+{
+    if(!armed) return;
+    if(now < last_tick || now - last_tick > 250) { release("handler-stall"); return; }
+    tick_dt = double(now - segment_start) / 1000.0;
+    if(tick_dt <= 0) return;
+    recoil_now_ms=std::max(recoil_now_ms,now);
+    advanceSequences(now);
+    segment_start = last_tick = now; emitState("tick", true); x = y = 0;
+}
+void MkbMapper::emitState(const char *reason, bool mouse)
+{
+    if(menu_boundary_report) return;
+    updateRecoilPhase();
+    ChiakiControllerState state;
+    chiaki_controller_state_set_idle(&state);
+    if(armed)
+    {
+        double lx = int(keys[D]) - int(keys[A]), ly = int(keys[S]) - int(keys[W]);
+        double norm = std::max(1.0, std::hypot(lx, ly));
+        state.left_x = int16_t(lx / norm * 32767); state.left_y = int16_t(ly / norm * 32767);
+        if(mouse && !menu_mask)
+        {
+            const auto &mode = keys[L2] ? profile.ads : profile.hip;
+            if(aim_ads != keys[L2]) {
+                if(!identicalAimModes(profile.hip, profile.ads)) smooth_x = smooth_y = 0;
+                aim_ads = keys[L2];
+            }
+            auto axis = [&](double delta, double &smooth, const std::vector<MkbAxisPoint> &table) {
+                if(delta == 0) { smooth = 0; return 0.0; }
+                double value = table.empty() ? delta * mode.gain * 0.008 / tick_dt :
+                    delta / profile.dpi * 2.54 * 360.0 / mode.cm360 / tick_dt;
+                if(mode.smoothing_ms > 0) {
+                    double alpha = -std::expm1(-tick_dt * 1000.0 / mode.smoothing_ms);
+                    smooth += alpha * (value - smooth); value = smooth;
+                }
+                if(table.empty()) return value;
+                double speed = std::abs(value), stick = table.back().stick;
+                for(size_t i = 1; i < table.size(); ++i) if(speed <= table[i].speed) {
+                    const auto &a = table[i-1]; const auto &b = table[i];
+                    stick = a.stick + (b.stick-a.stick) * (speed-a.speed)/(b.speed-a.speed); break;
+                }
+                return std::copysign(stick, value);
+            };
+            double rx = axis(x, smooth_x, mode.x), ry = axis(y, smooth_y, mode.y);
+            const double magnitude = std::hypot(rx, ry);
+            if(mode.x.empty() && magnitude > 0 && profile.radial_deadzone > 0) {
+                const double output = profile.radial_deadzone + (1-profile.radial_deadzone)*std::min(1.0,magnitude);
+                rx *= output/magnitude; ry *= output/magnitude;
+            }
+            norm = std::max(1.0, std::hypot(rx, ry));
+            emitted_right_x = int16_t(rx / norm * 32767); emitted_right_y = int16_t(ry / norm * 32767);
+        }
+        state.right_x = menu_mask?int16_t(menu_x*32767):emitted_right_x;
+        state.right_y = menu_mask?int16_t(menu_y*32767):emitted_right_y;
+        // Явные направления для консольного selector. После отпускания сразу neutral.
+        const double menuX=int(keys[LookRight])-int(keys[LookLeft]);
+        const double menuY=int(keys[LookDown])-int(keys[LookUp]);
+        if(!menu_close_neutral && (!menu_mask || recoil_now_ms>=menu_ready_at) &&
+            (keys[LookUp] || keys[LookDown] || keys[LookLeft] || keys[LookRight])) {
+            const double menuNorm=std::max(1.0,std::hypot(menuX,menuY));
+            state.right_x=int16_t(menuX/menuNorm*32767);state.right_y=int16_t(menuY/menuNorm*32767);
+        } else if(!menu_mask && !menu_close_neutral) {
+            // Add only to this submission, never to the cached mouse position.
+            // Trigger release or a toggle therefore removes recoil immediately.
+            state.right_y=int16_t(int(emitted_right_y)+recoilCorrection());
+        }
+        const uint32_t buttons[] = {0,0,0,0, CHIAKI_CONTROLLER_BUTTON_CROSS,
+            CHIAKI_CONTROLLER_BUTTON_BOX, CHIAKI_CONTROLLER_BUTTON_PYRAMID,
+            CHIAKI_CONTROLLER_BUTTON_MOON, CHIAKI_CONTROLLER_BUTTON_L3,
+            CHIAKI_CONTROLLER_BUTTON_L1, CHIAKI_CONTROLLER_BUTTON_R1,
+            CHIAKI_CONTROLLER_BUTTON_DPAD_UP, CHIAKI_CONTROLLER_BUTTON_DPAD_DOWN,
+            CHIAKI_CONTROLLER_BUTTON_DPAD_LEFT, CHIAKI_CONTROLLER_BUTTON_DPAD_RIGHT};
+        for(unsigned i = Cross; i <= Right; ++i) if(keys[i]) state.buttons |= buttons[i];
+        if(hold_left) state.buttons |= CHIAKI_CONTROLLER_BUTTON_DPAD_LEFT;
+        if(hold_right) state.buttons |= CHIAKI_CONTROLLER_BUTTON_DPAD_RIGHT;
+        if(dodge!=Dodge::Idle) {
+            state.buttons &= ~CHIAKI_CONTROLLER_BUTTON_MOON;
+            if(dodge==Dodge::First || dodge==Dodge::Second) state.buttons |= CHIAKI_CONTROLLER_BUTTON_MOON;
+        }
+        const uint32_t extra[] = {CHIAKI_CONTROLLER_BUTTON_R3, CHIAKI_CONTROLLER_BUTTON_OPTIONS,
+            CHIAKI_CONTROLLER_BUTTON_SHARE, CHIAKI_CONTROLLER_BUTTON_PS, CHIAKI_CONTROLLER_BUTTON_TOUCHPAD};
+        for(unsigned i = R3; i <= Touchpad; ++i) if(keys[i]) state.buttons |= extra[i-R3];
+        state.l2_state = keys[L2] ? 255 : 0; state.r2_state = rapidFirePressed() ? 255 : 0;
+    }
+    if(!menu_report) menu_close_neutral=false;
+    if(defer_output)deferred_output.emplace_back(state,reason);
+    else submit(state, reason);
+}
+
+void MkbEventQueue::reset()
+{
+    std::lock_guard<std::mutex> lock(mutex); queue.clear(); error.clear();
+}
+bool MkbEventQueue::push(const Event &event)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!error.empty()) return false;
+    if(queue.size() >= 512) { queue.clear(); error = "queue-overflow"; return false; }
+    queue.push_back(event); return true;
+}
+void MkbEventQueue::fail(const char *reason)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    if(error.empty()) error = reason;
+    queue.clear();
+}
+bool MkbEventQueue::drain(std::deque<Event> &events, std::string &failure)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    events.clear(); events.swap(queue); failure = error;
+    return error.empty();
+}

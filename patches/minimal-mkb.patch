+
+void StreamSession::HeadsetAudioDeviceChanged(bool added, unsigned int which, bool capture, QString device_name)
+{
+    RefreshHeadsetControl();
+    if(!output_policy.headset || capture || !headset_audio_channels || !headset_audio_rate)
+        return;
+    if(added && device_name != audio_out_device_name) return;
+    QMutexLocker frame_lock(&audio_out_frame_mutex);
+    if(audio_out_stopping) return;
+    // The ADDED index may have expired while the Qt notification was queued.
+    // Re-enumerate by selected name; REMOVED still carries an opened device ID.
+    bool present = false;
+    const int count = SDL_GetNumAudioDevices(0);
+    for(int i = 0; i < count; ++i) {
+        const char *name = SDL_GetAudioDeviceName(i, 0);
+        if(name && audio_out_device_name == QString::fromUtf8(name)) {
+            present = true;
+            break;
+        }
+    }
+    if(!added) {
+        if(which != audio_out) return;
+        headset_audio_retry->stop();
+        StopAudioOutDrainThread();
+        SDL_CloseAudioDevice(audio_out);
+        audio_out = 0;
+        QMutexLocker locker(&audio_out_ring_mutex);
+        audio_out_ring_buf.clear();
+        audio_out_ring_read_pos = audio_out_ring_write_pos = audio_out_ring_fill = 0;
+        audio_out_overflow_logged = false;
+        return;
+    }
+    if(!audio_out && present) {
+        // The copied event identity proves this was a selected-device add,
+        // even if unplug/replug completed before either notification arrived.
+        headset_audio_attempts = 0;
+        ScheduleHeadsetAudioRetry();
+    }
+}
+
+void StreamSession::ShutdownAudioOutput()
+{
+    QMutexLocker frame_lock(&audio_out_frame_mutex);
+    audio_out_stopping = true;
+    // The drain only uses ring/drain locks, so joining under frame_lock cannot
+    // wait for a frame callback holding this same lock.
+    StopAudioOutDrainThread();
+    if(audio_out) SDL_CloseAudioDevice(audio_out);
+    audio_out = 0;
+    QMutexLocker locker(&audio_out_ring_mutex);
+    audio_out_ring_buf.clear();
+    audio_out_ring_read_pos = audio_out_ring_write_pos = audio_out_ring_fill = 0;
+    audio_out_overflow_logged = false;
 }
 

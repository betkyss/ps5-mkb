+#include <memory>
+struct MkbCaptureToken {
+    uint64_t session=0,capture=0;
+    explicit operator bool() const {return session && capture;}
+    bool operator==(const MkbCaptureToken &o) const {return session==o.session && capture==o.capture;}
+    bool operator!=(const MkbCaptureToken &o) const {return !(*this==o);}
+};
+enum class MkbStopReason { None, Release, Eligibility, Session, Native, Mapper, Clock, Submit, Shutdown };
+inline void MkbCopyReason(std::array<char,96> &out,const char *reason) {
+    std::strncpy(out.data(),reason?reason:"",out.size()-1);out.back()=0;
+}
+struct MkbGateRecord {
+    MkbCaptureToken token;uint64_t id=0,begin=0,end=0,thread=0;
+    ChiakiControllerState state{};int result=0;bool accepted=false;
+    MkbStopReason kind=MkbStopReason::None;std::array<char,96> reason{};
+};
+struct MkbGateTrace {
+    struct Terminal {uint64_t endNs=0,releaseNs=0;const char *recovery="not-required";};
+    static constexpr size_t Limit=65536;
+    std::unique_ptr<MkbGateRecord[]> rows{new MkbGateRecord[Limit]};
+    std::atomic<size_t> count{0},dropped{0};std::atomic<bool> active{false};
+    bool used=false;Terminal terminal{};
+    void open() {if(!used){used=true;active=true;}}
+    size_t close() {active=false;return count.load(std::memory_order_acquire);}
+    void seal(uint64_t releaseNs,const char *recovery) {
+        if(used && !terminal.endNs){terminal={MkbNativePhaseTrace::now(),releaseNs,recovery};close();}
+    }
+    void append(const MkbGateRecord &r) {
+        if(!active.load()) return;
+        const auto n=count.load(std::memory_order_relaxed);
+        if(n==Limit){++dropped;return;}
+        rows[n]=r;count.store(n+1,std::memory_order_release);
+    }
+};
+struct MkbCadence {
+    static constexpr uint64_t Period=8000000;
+    uint64_t origin=0,deadline=0,skipped=0;
+    bool begin(uint64_t now) {origin=now;skipped=0;if(!now || now>UINT64_MAX-Period)return false;deadline=now+Period;return true;}
+    bool due(uint64_t wake) const {return deadline && wake>=deadline;}
+    bool advance(uint64_t finish) {
+        if(finish<origin || finish<deadline) return false;
+        const auto n=(finish-origin)/Period+1;
+        if(n>(UINT64_MAX-origin)/Period) return false;
+        const auto next=origin+n*Period;skipped+=(next-deadline)/Period-1;deadline=next;return true;
+    }
+};
diff --git a/gui/include/mkbpermissionmonitor.h b/gui/include/mkbpermissionmonitor.h
new file mode 100644
index 0000000..bc5af95
--- /dev/null
+++ b/gui/include/mkbpermissionmonitor.h
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbnativephasetrace.h"
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+// Destruction is deferred until no background query can use the captured handle/context.
+class MkbTapLease {
+    std::function<bool()> query;
+    std::function<void()> finalize;
+public:
+    MkbTapLease(std::function<bool()> q,std::function<void()> f):query(std::move(q)),finalize(std::move(f)){}
+    ~MkbTapLease() {finalize();}
+    bool enabled() const {return query();}
+};
+
+struct MkbPermissionSnapshot {
+    static constexpr uint64_t MaxAgeNs=150000000;
+    enum Status : uint64_t { Pending=0, Allowed=1, AccessibilityDenied=2, MonitoringDenied=3, ClockInvalid=4, QueryFailed=5, TapDisabled=6 };
+    struct Value { uint64_t start=0,end=0; Status status=Pending; bool tapChecked=false; };
+    static Value encode(uint64_t start,uint64_t end,uint64_t previousEnd,bool ax,bool hid,bool tap=true,bool checked=false) {
+        const bool invalid=!start || end<start || start<previousEnd || end==UINT64_MAX;
+        return {start,end,invalid?ClockInvalid:!ax?AccessibilityDenied:!hid?MonitoringDenied:!tap?TapDisabled:Allowed,checked};
+    }
+    static const char *failure(const Value &value,uint64_t now,uint64_t created,bool initial=false,uint64_t tapSince=0) {
+        if(!created || !now || now<created || value.status==ClockInvalid) return "permission-monitor-clock-invalid";
+        if(value.status==QueryFailed) return "permission-query-failed";
+        if(value.status==Pending)
+            return now-created>=MaxAgeNs?"permission-monitor-stale":"permission-monitor-pending";
+        if(now<value.start || now<value.end) return "permission-monitor-clock-invalid";
+        if(value.status==AccessibilityDenied) return initial?"permission-denied-accessibility":"permission-lost";
+        if(value.status==MonitoringDenied) return initial?"permission-denied-input-monitoring":"permission-lost";
+        if(value.status==TapDisabled) return "event-tap-disabled-runtime-check";
+        if(value.status!=Allowed) return "permission-query-failed";
+        if(tapSince && !value.tapChecked) {
+            if(now<tapSince) return "permission-monitor-clock-invalid";
+            if(now-tapSince>=MaxAgeNs) return "event-tap-monitor-stale";
+        }
+        return now-value.start>=MaxAgeNs?"permission-monitor-stale":nullptr;
+    }
+    // The writer fills the inactive slot before publishing its index. Atomic
+    // fields and slot versions also cover a reader delayed across two updates.
+    struct Publication {
+        struct Slot {
+            std::atomic<uint64_t> version{0},start{0},end{0},status{Pending},tapChecked{0};
+            void publish(const Value &value) {
+                version.fetch_add(1);
+                start.store(value.start);end.store(value.end);status.store(value.status);tapChecked.store(value.tapChecked);
+                version.fetch_add(1);
+            }
+            bool read(Value &value) const {
+                const auto before=version.load();
+                if(before&1) return false;
+                const Value candidate{start.load(),end.load(),Status(status.load()),bool(tapChecked.load())};
+                if(before!=version.load()) return false;
+                value=candidate;return true;
+            }
+        } buffers[2];
+        std::atomic<unsigned> current{0};
+        void publish(const Value &value) {
+            const auto next=1-current.load();
+            buffers[next].publish(value);
+            current.store(next);
+        }
+        bool read(Value &value) const {
+            for(unsigned attempt=0;attempt<3;++attempt)
+                if(buffers[current.load()].read(value)) return true;
+            return false;
+        }
+    };
+};
+
+class MkbPermissionMonitor {
+public:
+    struct Ops {
+        std::function<bool()> accessibility,monitoring;
+        std::function<uint64_t()> clock=MkbNativePhaseTrace::now;
+        std::function<void(const MkbPermissionSnapshot::Value &)> publish={};
+    };
+    static constexpr unsigned IntervalMs=50;
+private:
+    struct Shared {
+        Ops ops;
+        const bool hid;
+        const uint64_t created;
+        std::shared_ptr<MkbNativePhaseTrace> trace;
+        MkbPermissionSnapshot::Publication snapshot;
+        std::shared_ptr<MkbTapLease> tap;
+        std::atomic<uint64_t> tapSince{0};
+        std::atomic<bool> stopped{false};
+        std::mutex waitMutex;
+        std::condition_variable wake;
+        Shared(Ops value,bool source,std::shared_ptr<MkbNativePhaseTrace> t)
+            :ops(std::move(value)),hid(source),created(ops.clock()),trace(std::move(t)){}
+    };
+    std::shared_ptr<Shared> shared;
+    inline static std::atomic<bool> occupied{false};
+    explicit MkbPermissionMonitor(std::shared_ptr<Shared> s):shared(std::move(s)){}
+    static void run(std::shared_ptr<Shared> s) {
+        uint64_t previousEnd=s->created;
+        try {
+            while(!s->stopped.load(std::memory_order_acquire)) {
+                const auto start=s->ops.clock();
+                bool ax,hid=true;
+                {MkbNativePhaseTrace::Scope phase(s->trace.get(),MkbNativePhaseTrace::Kind::Accessibility);ax=s->ops.accessibility();}
+                if(s->stopped.load(std::memory_order_acquire)) break;
+                if(ax && s->hid) {
+                    MkbNativePhaseTrace::Scope phase(s->trace.get(),MkbNativePhaseTrace::Kind::InputMonitoring);
+                    hid=s->ops.monitoring();
+                }
+                bool checked=false,tap=true;
+                if(ax && hid && s->tapSince.load(std::memory_order_acquire)) {
+                    if(s->stopped.load(std::memory_order_acquire)) break;
+                    MkbNativePhaseTrace::Scope phase(s->trace.get(),MkbNativePhaseTrace::Kind::Tap);
+                    checked=true;tap=s->tap->enabled();
+                }
+                const auto end=s->ops.clock();
+                const auto value=MkbPermissionSnapshot::encode(start,end,previousEnd,ax,hid,tap,checked);
+                if(s->stopped.load(std::memory_order_acquire)) break;
+                s->snapshot.publish(value);if(s->ops.publish)s->ops.publish(value);
+                previousEnd=end;
+                if(value.status!=MkbPermissionSnapshot::Allowed) break;
+                std::unique_lock<std::mutex> lock(s->waitMutex);
+                s->wake.wait_for(lock,std::chrono::milliseconds(IntervalMs),[&]{return s->stopped.load();});
+            }
+        } catch(...) {const MkbPermissionSnapshot::Value value{0,0,MkbPermissionSnapshot::QueryFailed};s->snapshot.publish(value);if(s->ops.publish)s->ops.publish(value);}
+        // Free the global slot only after no more calls can touch the old context.
+        s.reset();occupied.store(false,std::memory_order_release);
+    }
+public:
+    static bool busy() {return occupied.load(std::memory_order_acquire);}
+    static std::shared_ptr<MkbPermissionMonitor> start(Ops ops,bool hid,std::shared_ptr<MkbNativePhaseTrace> trace) {
+        bool expected=false;
+        if(!occupied.compare_exchange_strong(expected,true)) return {};
+        try {
+            auto state=std::make_shared<Shared>(std::move(ops),hid,std::move(trace));
+            auto result=std::shared_ptr<MkbPermissionMonitor>(new MkbPermissionMonitor(state));
+            std::thread(run,std::move(state)).detach();
+            return result;
+        } catch(...) {occupied=false;return {};}
+    }
+    // One native publisher initializes the immutable lease before the release flag.
+    bool attachTap(std::shared_ptr<MkbTapLease> tap,uint64_t at) {
+        if(!tap || !at || shared->stopped.load() || shared->tapSince.load()) return false;
+        shared->tap=std::move(tap);
+        shared->tapSince.store(at,std::memory_order_release);
+        return true;
+    }
+    void stop() {shared->stopped.store(true,std::memory_order_release);shared->wake.notify_all();}
+    ~MkbPermissionMonitor() {stop();}
+    bool snapshot(MkbPermissionSnapshot::Value &value) const {return shared->snapshot.read(value);}
+    template<class Clock> const char *failureWithClock(Clock clock,bool initial=false) const {
+        MkbPermissionSnapshot::Value value;
+        if(!snapshot(value)) return "permission-monitor-snapshot-busy";
+        const auto tapSince=shared->tapSince.load(std::memory_order_acquire);
+        return MkbPermissionSnapshot::failure(value,clock(),shared->created,initial,tapSince);
+    }
+    const char *failure(bool initial=false) const {
+        return failureWithClock(MkbNativePhaseTrace::now,initial);
+    }
+};
diff --git a/gui/include/mkbnativephasetrace.h b/gui/include/mkbnativephasetrace.h
new file mode 100644
index 0000000..ee8a385
--- /dev/null
+++ b/gui/include/mkbnativephasetrace.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <algorithm>
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+#include <pthread.h>
+#endif
+
+// One native producer. Published rows never change; GUI freezes a prefix at stop.
+class MkbNativePhaseTrace {
+public:
+    enum class Kind { Iteration, Pump, Wait, Seal, Tap, Accessibility, InputMonitoring,
+                      Watchdog, Callback, Decode, Publish, CgCallback, ReadyWait, PermissionSnapshot };
+    struct Row { uint64_t ns,thread; Kind kind; bool exit; };
+    static constexpr size_t MaxRecords=1048576;
+    static constexpr uint64_t DurationNs=60000000000ULL;
+    static uint64_t now() noexcept {
+#ifdef __APPLE__
+        mach_timebase_info_data_t base{};
+        if(mach_timebase_info(&base)!=KERN_SUCCESS || !base.denom) return 0;
+        const auto ns=__uint128_t(mach_absolute_time())*base.numer/base.denom;
+        return ns<=UINT64_MAX ? uint64_t(ns) : 0;
+#else
+        return 0;
+#endif
+    }
+    static uint64_t threadId() noexcept {
+#ifdef __APPLE__
+        uint64_t id=0;pthread_threadid_np(nullptr,&id);return id;
+#else
+        return 0;
+#endif
+    }
+    explicit MkbNativePhaseTrace(size_t capacity=MaxRecords,uint64_t (*clock)()=now,
+                                 uint64_t (*thread)()=threadId)
+        :limit(std::min(capacity,MaxRecords)),rows(new Row[limit]),clock(clock),thread(thread) {}
+    const size_t limit;
+    std::unique_ptr<Row[]> rows;
+    std::atomic<size_t> count{0},dropped{0},invalid{0};
+    std::atomic<uint64_t> begin{0},end{0};
+    std::atomic<bool> closed{true};
+    void start(uint64_t ns) noexcept {
+        if(!ns || ns>UINT64_MAX-DurationNs) {invalid.fetch_add(1);return;}
+        begin.store(ns,std::memory_order_relaxed);end.store(ns+DurationNs,std::memory_order_relaxed);
+        closed.store(false,std::memory_order_release);
+    }
+    size_t stop(uint64_t ns) noexcept {
+        const auto began=begin.load(std::memory_order_acquire);
+        if(ns<began) {invalid.fetch_add(1,std::memory_order_relaxed);ns=began;}
+        end.store(std::min(end.load(),ns),std::memory_order_release);
+        closed.store(true,std::memory_order_release);
+        return count.load(std::memory_order_acquire);
+    }
+    bool active() const noexcept {return !closed.load(std::memory_order_acquire);}
+    class Scope {
+        MkbNativePhaseTrace *trace;
+        Kind kind;
+    public:
+        Scope(MkbNativePhaseTrace *t,Kind k) noexcept :trace(t),kind(k) {
+            if(trace) trace->record(kind,false);
+        }
+        ~Scope() {if(trace) trace->record(kind,true);}
+        Scope(const Scope &)=delete;
+        Scope &operator=(const Scope &)=delete;
+    };
+private:
+    uint64_t (*clock)();
+    uint64_t (*thread)();
+    uint64_t last=0,producer=0;
+    void record(Kind kind,bool exit) noexcept {
+        if(!active()) return;
+        const auto ns=clock();
+        if(!ns || ns<last) {invalid.fetch_add(1,std::memory_order_relaxed);return;}
+        last=ns;
+        if(ns<begin.load(std::memory_order_acquire) || ns>=end.load(std::memory_order_acquire)) return;
+        if(!producer) producer=thread();
+        if(!producer) {invalid.fetch_add(1,std::memory_order_relaxed);return;}
+        const auto n=count.load(std::memory_order_relaxed);
+        if(n==limit) {dropped.fetch_add(1,std::memory_order_relaxed);return;}
+        rows[n]={ns,producer,kind,exit};
+        count.store(n+1,std::memory_order_release);
+    }
+};
+static_assert(std::atomic<size_t>::is_always_lock_free && std::atomic<uint64_t>::is_always_lock_free &&
+              std::atomic<bool>::is_always_lock_free,"Native phase recorder requires lock-free atomics");
diff --git a/gui/include/mkbmousetrace.h b/gui/include/mkbmousetrace.h
new file mode 100644
index 0000000..1d94439
--- /dev/null
+++ b/gui/include/mkbmousetrace.h
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbmapper.h"
+#include "mkbnativephasetrace.h"
+#include <chiaki/streamconnection.h>
+#include <atomic>
+#include <memory>
+#include <vector>
+
+// Только GUI-поток. В callback/tick нет I/O; exporter владеет отдельным snapshot.
+class MkbMouseTrace {
+public:
+    static constexpr size_t MaxRecords=65536;
+    static constexpr uint64_t DurationMs=60000;
+    enum class Kind { Mouse, Tick, Neutral, Other, Request };
+    enum class End { Release, Timeout, Overflow, Invalid, Destroy };
+    struct Record {
+        Kind kind;
+        uint64_t time, source=0;
+        double dx=0,dy=0;
+        int16_t rx=0,ry=0;
+        uint64_t generation=0;
+        MkbEventQueue::NativeTiming native{};
+    };
+    // Один producer (sender), immutable опубликованный prefix для exporter.
+    static_assert(std::atomic<size_t>::is_always_lock_free &&
+                  std::atomic<uint64_t>::is_always_lock_free && std::atomic<bool>::is_always_lock_free,
+                  "Sender recorder requires lock-free atomics");
+    // Compact optional trace storage remains independent of passive health.
+    struct SenderRecord {
+        uint64_t start_us,end_us;ChiakiSeqNum16 sequence;int16_t right_x,right_y;ChiakiErrorCode result;
+        uint64_t generation,revision,retry_due_us;unsigned retry_count;bool retry_pending,degraded;
+    };
+    static constexpr size_t SenderMaxRecords=16384;
+    struct SenderBuffer {
+        explicit SenderBuffer(size_t maximum):limit(std::min(maximum,SenderMaxRecords)),rows(new SenderRecord[limit]) {}
+        const size_t limit;
+        std::unique_ptr<SenderRecord[]> rows;
+        std::atomic<size_t> count{0},dropped{0};
+        std::atomic<uint64_t> begin{0},deadline{0},release{0};
+        std::atomic<bool> closed{false};
+        bool clockValid=false;
+        int64_t offsetUs=0;
+        uint64_t uncertaintyUs=0;
+    };
+    struct Snapshot {
+        uint64_t begin=0,end=0;
+        End reason=End::Release;
+        std::vector<Record> records;
+        std::shared_ptr<SenderBuffer> sender;
+        std::shared_ptr<MkbNativePhaseTrace> phases;
+        size_t phaseCount=0,permissionPhaseCount=0;
+        std::shared_ptr<MkbNativePhaseTrace> permissionPhases;
+    };
+    struct ExportResult {
+        std::atomic<bool> done{false},ok{false};
+        // Читать только после done.load(). Каталог/имя не попадают в журнал.
+        std::string path;
+    };
+    explicit MkbMouseTrace(std::string directory={},size_t limit=MaxRecords);
+    ~MkbMouseTrace();
+    MkbMouseTrace(const MkbMouseTrace &)=delete;
+    MkbMouseTrace &operator=(const MkbMouseTrace &)=delete;
+    ChiakiFeedbackObserver observer();
+    std::shared_ptr<MkbNativePhaseTrace> phaseTrace() const {return phases;}
+    std::shared_ptr<MkbNativePhaseTrace> permissionTrace() const {return permissionPhases;}
+    void attach(ChiakiStreamConnection &connection) { connection.feedback_observer=observer(); }
+    // clock возвращает GUI monotonic ms; измерение bracket сохраняет погрешность.
+    void prepare(const ChiakiControllerState &request,const char *reason,bool mapperActive,uint64_t (*clock)());
+    static void observe(void *user,const ChiakiFeedbackSendRecord *record) noexcept;
+    void begin(uint64_t now);
+    void mouse(const MkbEventQueue::Event &event,uint64_t generation,uint64_t now);
+    void submit(int16_t rx,int16_t ry,Kind kind,uint64_t now);
+    void advance(uint64_t now);
+    void finish(uint64_t now,End reason=End::Release);
+    bool active() const {return recording;}
+    bool enabled() const {return !directory.empty() && (!used || recording);}
+    void controller(const ChiakiControllerState &state,const char *reason,bool mapperActive,uint64_t now);
+    std::shared_ptr<ExportResult> result() const {return completion;}
+    // Тот же exporter используется worker и автономными тестами.
+    static bool write(const std::string &directory,const Snapshot &snapshot,std::string &path);
+    static std::string serialize(const Snapshot &snapshot);
+    static bool writeBytes(const std::string &directory,const std::string &bytes,std::string &path);
+private:
+    std::shared_ptr<SenderBuffer> sender;
+    std::shared_ptr<MkbNativePhaseTrace> phases,permissionPhases;
+    std::string directory;
+    size_t limit;
+    bool used=false,recording=false;
+    uint64_t last=0;
+    std::unique_ptr<Snapshot> snapshot;
+    std::shared_ptr<ExportResult> completion;
+    void logStart() const;
+    bool allocate();
+    bool accept(uint64_t now);
+    void append(Record record);
+};
diff --git a/gui/src/mkbmousetrace.cpp b/gui/src/mkbmousetrace.cpp
new file mode 100644
index 0000000..e9089eb
--- /dev/null
+++ b/gui/src/mkbmousetrace.cpp
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbmousetrace.h"
+#include <chiaki/time.h>
+#include <chrono>
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstring>
+#include <cstdio>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <thread>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace {
+// Даже зависший диск не создаёт неограниченное число worker при новых сессиях.
+std::atomic<unsigned> writers{0};
+const char *name(MkbMouseTrace::Kind kind) {
+    switch(kind) {
+    case MkbMouseTrace::Kind::Mouse:return "mouse";
+    case MkbMouseTrace::Kind::Tick:return "tick";
+    case MkbMouseTrace::Kind::Neutral:return "neutral";
+    case MkbMouseTrace::Kind::Other:return "other";
+    case MkbMouseTrace::Kind::Request:return "request";
+    }
+    return "other";
+}
+const char *name(MkbMouseTrace::End end) {
+    switch(end) {
+    case MkbMouseTrace::End::Release:return "release";
+    case MkbMouseTrace::End::Timeout:return "timeout";
+    case MkbMouseTrace::End::Overflow:return "overflow";
+    case MkbMouseTrace::End::Invalid:return "invalid";
+    case MkbMouseTrace::End::Destroy:return "destroy";
+    }
+    return "invalid";
+}
+}
+MkbMouseTrace::MkbMouseTrace(std::string dir,size_t maximum)
+    :directory(std::move(dir)),limit(std::min(maximum,MaxRecords)) {}
+MkbMouseTrace::~MkbMouseTrace() {
+    if(recording) finish(last,End::Destroy);
+}
+ChiakiFeedbackObserver MkbMouseTrace::observer() {
+    if(directory.empty()) return {};
+    try {
+        const bool first=!phases;
+        if(!sender) sender=std::make_shared<SenderBuffer>(limit);
+        if(!phases) phases=std::make_shared<MkbNativePhaseTrace>();
+        if(!permissionPhases) permissionPhases=std::make_shared<MkbNativePhaseTrace>(8192);
+        if(!snapshot && !allocate()) return {};
+        if(first) std::fprintf(stderr,"MKB mouse trace: READY arm_starts_recording=1 duration_ms=%llu native_capacity=%zu\n",
+            (unsigned long long)DurationMs,phases->limit);
+    } catch(...) {return {};}
+    return {observe,sender.get()};
+}
+void MkbMouseTrace::observe(void *user,const ChiakiFeedbackSendRecord *r) noexcept {
+    auto &s=*static_cast<SenderBuffer *>(user);
+    const auto begin=s.begin.load(std::memory_order_acquire);
+    if(!begin || s.closed.load(std::memory_order_acquire) || r->start_us<begin ||
+       r->start_us>=s.deadline.load(std::memory_order_acquire)) return;
+    const auto n=s.count.load(std::memory_order_relaxed);
+    if(n==s.limit) {s.dropped.fetch_add(1,std::memory_order_relaxed);return;}
+    s.rows[n]={r->start_us,r->end_us,r->sequence,r->right_x,r->right_y,r->result,r->generation,r->revision,r->retry_due_us,r->retry_count,r->retry_pending,r->degraded};
+    s.count.store(n+1,std::memory_order_release);
+}
+void MkbMouseTrace::prepare(const ChiakiControllerState &request,const char *reason,bool mapperActive,uint64_t (*clock)()) {
+    if(directory.empty()) return;
+    if(std::strcmp(reason,"arm")==0 && used && !recording) {
+        std::fputs("MKB mouse trace: arm-skipped reason=one-shot-used new_stream_session_required=1\n",stderr);
+        return;
+    }
+    if(!sender) return;
+    if(std::strcmp(reason,"arm")==0 && !used) {
+        // Память готова до arm. Сначала публикуем collector, потом выбираем
+        // фактическую границу. Ранний provisional prefix exporter отфильтрует.
+        begin(0);
+        if(!recording) return;
+        snapshot->sender=sender;
+        sender->deadline.store(UINT64_MAX,std::memory_order_relaxed);
+        sender->begin.store(1,std::memory_order_release);
+        const auto beforeMs=clock();
+        const auto library=chiaki_time_now_monotonic_us();
+        const auto afterMs=clock();
+        snapshot->begin=last=beforeMs;
+        sender->begin.store(library,std::memory_order_release);
+        sender->deadline.store(library+DurationMs*1000,std::memory_order_release);
+        if(!beforeMs || !afterMs || !library || afterMs<beforeMs ||
+           afterMs>(UINT64_MAX-999)/1000) {
+            sender->closed.store(true,std::memory_order_release);
+            finish(beforeMs,End::Invalid);
+            return;
+        }
+        const auto before=beforeMs*1000;
+        const auto after=afterMs*1000+999;
+        sender->offsetUs=int64_t(before+(after-before)/2)-int64_t(library);
+        sender->uncertaintyUs=(after-before+1)/2+1;
+        sender->clockValid=true;
+        logStart();
+    }
+    if(recording) {
+        if(sender && !mapperActive) sender->release.store(chiaki_time_now_monotonic_us(),std::memory_order_release);
+        submit(request.right_x,request.right_y,Kind::Request,clock());
+    }
+}
+bool MkbMouseTrace::allocate() {
+    try {
+        completion=std::make_shared<ExportResult>();
+        snapshot=std::make_unique<Snapshot>();
+        snapshot->records.reserve(limit);
+        return true;
+    } catch(...) {
+        snapshot.reset();
+        if(completion) completion->done=true;
+        return false;
+    }
+}
+void MkbMouseTrace::begin(uint64_t now) {
+    if(used || directory.empty()) return;
+    used=true;
+    if(!snapshot && !allocate()) return;
+    snapshot->begin=last=now; recording=true;
+    snapshot->phases=phases;snapshot->permissionPhases=permissionPhases;
+    const auto began=MkbNativePhaseTrace::now();
+    if(phases) phases->start(began);
+    if(permissionPhases) permissionPhases->start(began);
+    if(!sender) logStart();
+}
+void MkbMouseTrace::logStart() const {
+    std::fprintf(stderr,"MKB mouse trace: start begin_ms=%llu sender_begin_us=%llu duration_ms=%llu max_records=%zu\n",
+        (unsigned long long)snapshot->begin,
+        (unsigned long long)(snapshot->sender ? snapshot->sender->begin.load() : 0),
+        (unsigned long long)DurationMs,limit);
+}
+bool MkbMouseTrace::accept(uint64_t now) {
+    if(!recording) return false;
+    if(now<last) {finish(last,End::Invalid);return false;}
+    if(now-snapshot->begin>=DurationMs) {
+        finish(snapshot->begin+DurationMs,End::Timeout);return false;
+    }
+    last=now;return true;
+}
+void MkbMouseTrace::advance(uint64_t now) {(void)accept(now);}
+void MkbMouseTrace::append(Record record) {
+    if(snapshot->records.size()==limit) {finish(record.time,End::Overflow);return;}
+    snapshot->records.push_back(record);
+}
+void MkbMouseTrace::mouse(const MkbEventQueue::Event &event,uint64_t generation,uint64_t now) {
+    if(!recording || event.source>=0 || event.key>=0 || event.generation!=generation) return;
+    if(!accept(now)) return;
+    if(!std::isfinite(event.dx) || !std::isfinite(event.dy) ||
+       event.timestamp<snapshot->begin || event.timestamp>now || now-event.timestamp>100) {
+        finish(now,End::Invalid);return;
+    }
+    Record record{Kind::Mouse,now,event.timestamp,event.dx,event.dy,0,0};
+    record.generation=event.generation;record.native=event.native;
+    append(record);
+}
+void MkbMouseTrace::submit(int16_t rx,int16_t ry,Kind kind,uint64_t now) {
+    if(!accept(now)) return;
+    append({kind,now,0,0,0,rx,ry});
+}
+void MkbMouseTrace::controller(const ChiakiControllerState &state,const char *reason,bool mapperActive,uint64_t now) {
+    if(std::strcmp(reason,"arm")==0) begin(now);
+    const auto kind=!mapperActive ? Kind::Neutral :
+        std::strcmp(reason,"tick")==0 ? Kind::Tick : Kind::Other;
+    submit(state.right_x,state.right_y,kind,now);
+    if(!mapperActive) finish(now);
+}
+void MkbMouseTrace::finish(uint64_t now,End reason) {
+    if(!recording) return;
+    recording=false;
+    if(now<last) {now=last;reason=End::Invalid;}
+    if(now-snapshot->begin>=DurationMs && reason==End::Release) {
+        now=snapshot->begin+DurationMs;reason=End::Timeout;
+    }
+    snapshot->end=now;snapshot->reason=reason;
+    const auto ended=MkbNativePhaseTrace::now();
+    if(snapshot->phases) snapshot->phaseCount=snapshot->phases->stop(ended);
+    if(snapshot->permissionPhases) snapshot->permissionPhaseCount=snapshot->permissionPhases->stop(ended);
+    if(snapshot->sender) {
+        if(reason==End::Invalid) snapshot->sender->clockValid=false;
+        const auto nowUs=chiaki_time_now_monotonic_us();
+        const auto cap=snapshot->sender->begin.load()+DurationMs*1000;
+        snapshot->sender->deadline.store(std::min(cap,nowUs+300000),std::memory_order_release);
+    }
+    std::fprintf(stderr,"MKB mouse trace: stop begin_ms=%llu end_ms=%llu reason=%s gui_records=%zu sender_records=%zu sender_dropped=%zu\n",
+        (unsigned long long)snapshot->begin,(unsigned long long)snapshot->end,name(reason),snapshot->records.size(),
+        snapshot->sender ? snapshot->sender->count.load(std::memory_order_acquire) : 0,
+        snapshot->sender ? snapshot->sender->dropped.load() : 0);
+    auto result=completion;
+    if(writers.fetch_add(1)>=2) {
+        std::fprintf(stderr,"MKB mouse trace: export begin_ms=%llu reason=%s status=failed cause=worker-limit\n",
+            (unsigned long long)snapshot->begin,name(reason));
+        --writers;result->done=true;
+        return;
+    }
+    try {
+        std::thread([data=std::move(snapshot),result,dir=directory] {
+            // Ожидание только на exporter; GUI и sender не ждут ни диск, ни neutral.
+            if(data->sender) {
+                const auto until=std::chrono::steady_clock::now()+std::chrono::milliseconds(300);
+                std::this_thread::sleep_until(until);
+                data->sender->closed.store(true,std::memory_order_release);
+            }
+            bool ok=false;
+            try {ok=write(dir,*data,result->path);} catch(...) {}
+            // Путь каталога не логируется. Имя создаётся самим mkstemp.
+            const auto slash=result->path.find_last_of('/');
+            const char *file=ok ? result->path.c_str()+(slash==std::string::npos?0:slash+1) : "none";
+            std::fprintf(stderr,"MKB mouse trace: export begin_ms=%llu reason=%s status=%s file=%s\n",
+                (unsigned long long)data->begin,name(data->reason),ok?"ok":"failed",file);
+            result->ok=ok;--writers;result->done=true;
+        }).detach();
+    } catch(...) {
+        std::fputs("MKB mouse trace: export status=failed cause=worker-start\n",stderr);
+        --writers;result->done=true;
+    }
+}
+std::string MkbMouseTrace::serialize(const Snapshot &s) {
+    std::ostringstream out;
+    out.exceptions(std::ios::badbit | std::ios::failbit);
+    out.imbue(std::locale::classic());out<<std::setprecision(17);
+    const bool complete=s.reason==End::Release || s.reason==End::Timeout;
+    out<<"{\"version\":"<<(s.sender?4:1)<<",\"clock\":\"mach-monotonic-ms\",\"precision_ms\":1,\"status\":\""
+       <<(complete?"complete":"incomplete")<<"\",\"end_reason\":\""<<name(s.reason)
+       <<"\",\"begin_ms\":"<<s.begin<<",\"end_ms\":"<<s.end<<",\"records\":[";
+    bool first=true;
+    for(const auto &r:s.records) {
+        if(!first) out<<',';
+        first=false;
+        out<<"{\"kind\":\""<<name(r.kind)<<"\",\"time_ms\":"<<r.time;
+        if(r.kind==Kind::Mouse) out<<",\"source_ms\":"<<r.source<<",\"dx\":"<<r.dx<<",\"dy\":"<<r.dy;
+        else out<<",\"right_x\":"<<r.rx<<",\"right_y\":"<<r.ry;
+        if(s.sender && r.kind==Kind::Mouse && (r.native.sequence || r.native.sourceNs || r.native.arrivalNs || r.native.drainNs)) {
+            out<<",\"native\":{\"clock\":\""
+               <<(r.native.clock==MkbEventQueue::NativeTiming::Clock::MachAbsoluteNs?"mach-absolute-ns":"unknown")
+               <<"\",\"generation\":"<<r.generation<<",\"sequence\":"<<r.native.sequence
+               <<",\"source_ns\":"<<r.native.sourceNs<<",\"arrival_ns\":"<<r.native.arrivalNs
+               <<",\"drain_ns\":"<<r.native.drainNs<<'}';
+        }
+        out<<'}';
+    }
+    out<<']';
+    if(s.sender) {
+        const auto &f=*s.sender;
+        auto count=f.count.load(std::memory_order_acquire);
+        const auto release=f.release.load(std::memory_order_acquire);
+        const auto boundary=f.begin.load(std::memory_order_acquire);
+        size_t first=0;
+        while(first<count && f.rows[first].start_us<boundary) ++first;
+        while(count>first && f.rows[count-1].start_us>=f.deadline.load()) --count;
+        bool neutral=false;
+        for(size_t i=first;i<count;++i) {
+            const auto &r=f.rows[i];
+            if(release && r.start_us>=release && r.right_x==0 && r.right_y==0) neutral=true;
+        }
+        out<<",\"sender\":{\"clock\":\"chiaki-monotonic-us\",\"gui_offset_us\":"<<f.offsetUs
+           <<",\"uncertainty_us\":"<<f.uncertaintyUs<<",\"begin_us\":"<<f.begin.load()
+           <<",\"deadline_us\":"<<f.deadline.load()<<",\"release_us\":"<<release
+           <<",\"dropped\":"<<f.dropped.load()<<",\"neutral_candidate_observed\":"<<(neutral?"true":"false")
+           <<",\"clock_valid\":"<<(f.clockValid?"true":"false")
+           <<",\"release_neutral_confirmed\":false,\"status\":\"incomplete\",\"records\":[";
+        for(size_t i=first;i<count;++i) {
+            const auto &r=f.rows[i];if(i!=first) out<<',';
+            out<<"{\"start_us\":"<<r.start_us<<",\"end_us\":"<<r.end_us<<",\"sequence\":"<<r.sequence
+               <<",\"right_x\":"<<r.right_x<<",\"right_y\":"<<r.right_y<<",\"result\":"<<int(r.result)
+               <<",\"generation\":"<<r.generation<<",\"revision\":"<<r.revision<<",\"retry_due_us\":"<<r.retry_due_us
+               <<",\"retry_count\":"<<r.retry_count<<",\"retry_pending\":"<<(r.retry_pending?"true":"false")
+               <<",\"degraded\":"<<(r.degraded?"true":"false")<<'}';
+        }
+        out<<"]}";
+    }
+    const auto writePhases=[&](const char *key,const std::shared_ptr<MkbNativePhaseTrace> &buffer,size_t frozen) {
+        if(!buffer) return;
+        const auto &p=*buffer;
+        const char *names[]={"iteration","pump","wait","seal","tap","accessibility","input_monitoring",
+                             "watchdog","callback","decode","publish","cg_callback","ready_wait","permission_snapshot"};
+        out<<",\""<<key<<"\":{\"clock\":\"mach-absolute-ns\",\"begin_ns\":"<<p.begin.load()
+           <<",\"end_ns\":"<<p.end.load()<<",\"capacity\":"<<p.limit
+           <<",\"dropped\":"<<p.dropped.load()<<",\"invalid\":"<<p.invalid.load()
+           <<",\"records\":[";
+        const auto n=std::min(frozen,p.count.load(std::memory_order_acquire));
+        bool firstPhase=true;
+        for(size_t i=0;i<n;++i) {
+            const auto &r=p.rows[i];
+            if(r.ns<p.begin.load() || r.ns>=p.end.load()) continue;
+            if(!firstPhase) out<<',';
+            firstPhase=false;
+            out<<"{\"ns\":"<<r.ns<<",\"thread_id\":"<<r.thread<<",\"phase\":\""<<names[unsigned(r.kind)]
+               <<"\",\"edge\":\""<<(r.exit?"exit":"entry")<<"\"}";
+        }
+        out<<"]}";
+    };
+    writePhases("native_phases",s.phases,s.phaseCount);
+    writePhases("permission_phases",s.permissionPhases,s.permissionPhaseCount);
+    out<<"}\n";
+    return out.str();
+}
+bool MkbMouseTrace::write(const std::string &directory,const Snapshot &s,std::string &path) {
+    return writeBytes(directory,serialize(s),path);
+}
+bool MkbMouseTrace::writeBytes(const std::string &directory,const std::string &bytes,std::string &path) {
+    // mkstemp: O_EXCL, 0600, уникальное имя. Частичная запись удаляется.
+    std::string file=directory+"/mouse-trace-XXXXXX";
+    std::vector<char> temp(file.begin(),file.end());temp.push_back(0);
+    const int fd=mkstemp(temp.data());
+    if(fd<0) return false;
+    bool ok=true;size_t offset=0;
+    while(offset<bytes.size()) {
+        const auto n=::write(fd,bytes.data()+offset,bytes.size()-offset);
+        if(n<0 && errno==EINTR) continue;
+        if(n<=0) {ok=false;break;}
+        offset+=size_t(n);
+    }
+    if(::close(fd)!=0) ok=false;
+    if(!ok) {::unlink(temp.data());return false;}
+    path=temp.data();return true;
+}

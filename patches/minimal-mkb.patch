+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbcapturecoordinator.h"
+#include "mkbsubmissiongate.h"
+#include "mkbworkertrace.h"
+#include "mkbstatuspublication.h"
+#include "mkbcameraprobe.h"
+class MkbWorker {
+public:
+    enum class Mode { Default, Enabled, Invalid };
+    static Mode mode(const char *value,const char *source) {
+        if(!value || std::strcmp(value,"0")==0)return Mode::Default;
+        return std::strcmp(value,"1")==0 && source && std::strcmp(source,"hid")==0?Mode::Enabled:Mode::Invalid;
+    }
+    enum class Phase { Idle, Preparing, Active, Releasing, Stopped };
+    struct Snapshot {
+        Phase phase=Phase::Idle;MkbCaptureToken token;MkbStopReason code=MkbStopReason::None;
+        std::array<char,96> reason{};uint64_t owner=0,ticks=0,skipped=0;
+    };
+    struct RecoilSnapshot {
+        uint64_t sampleNs=0,session=0,capture=0,runtimeRevision=0,profileRevision=0;
+        bool enabled=false,aiming=false,firing=false,applying=false,accepted=false,pulsePause=false,rapidFireEnabled=false;
+        double strengthPercent=0;
+        int outputY=0;
+        bool pulseMode=false;
+        double pulsePeakPercent=0;
+        uint32_t pulsePeriodMs=0;
+    };
+private:
+    struct Control {
+        std::mutex mutex;std::condition_variable wake;bool shutdown=false,closed=false;
+        std::shared_ptr<const MkbProfile> candidate; uint64_t revision=0,acceptedRevision=0,discardedRevision=0;
+        bool live=false,liveActive=false;MkbCaptureToken token{};uint64_t runtimeRevision=0;
+        MkbStatusPublication<5> view;
+        Control(){publishView();}
+        void publishView(){view.publish({uint64_t(closed),acceptedRevision,revision,discardedRevision,MkbNativePhaseTrace::now()});}
+        MkbCaptureToken arm{},stop{};MkbStopReason code=MkbStopReason::None;std::array<char,96> reason{};
+        void release(MkbCaptureToken token,MkbStopReason why,const char *text) {
+            std::lock_guard<std::mutex> lock(mutex);if(closed)return;
+            if(candidate && live){discardedRevision=revision;candidate.reset();publishView();}
+            stop=token;code=why;MkbCopyReason(reason,text);wake.notify_all();
+        }
+    };
+    std::shared_ptr<Control> control=std::make_shared<Control>();
+    std::shared_ptr<MkbSubmissionGate> gate;
+    std::shared_ptr<MkbWorkerTrace> trace;
+    MkbProfile profile;MacInputCapture::BackendFactory factory;
+    std::function<void()> beforeWait; // Optional offline barrier, called outside all worker/gate locks.
+    MkbStatusPublication<20> publication;
+    std::shared_ptr<MkbCaptureLifecycle> lifecycle=std::make_shared<MkbCaptureLifecycle>();
+    const bool cameraProbe;
+    MkbStatusPublication<14> probePublication;
+    MkbStatusPublication<9> recoilPublication;
+    friend struct MkbWorkerOfflineAccess; // Только offline contention test.
+    std::thread thread;
+    void run();
+    void runOwner();
+    void publish(Phase phase,MkbCaptureToken token,MkbStopReason code,const char *reason,uint64_t ticks,uint64_t skipped);
+public:
+    MkbWorker(MkbProfile profile,std::shared_ptr<MkbSubmissionGate> gate,std::shared_ptr<MkbWorkerTrace> trace,
+        MacInputCapture::BackendFactory factory={},std::function<void()> beforeWait={},bool probe=false);
+    bool cameraProbeEnabled()const{return cameraProbe;}
+    MkbCameraProbe::Snapshot cameraProbeStatus()const {
+        MkbStatusPublication<14>::Words w{};MkbCameraProbe::Snapshot s;
+        if(!probePublication.read(w))return s;
+        s.phase=MkbCameraProbe::Phase(w[0]);s.axis=w[1];s.value=w[2];s.durationMs=w[3];
+        s.trial=w[4];s.beginNs=w[5];s.neutralNs=w[6];s.deadlineNs=w[7];
+        s.sampleNs=w[8];s.session=w[9];s.capture=w[10];
+        s.trialAxis=w[11];s.trialValue=w[12];s.trialDurationMs=w[13];return s;
+    }
+    RecoilSnapshot recoilStatus()const {

+                QJsonObject o{{"vid",int(vid)},{"pid",int(pid)}};if(hasLocation)o["location"]=double(location);return o;
+            };
+            out["requestedSelector"]=selector(metadata.requested.vid,metadata.requested.pid,metadata.requested.location,metadata.requested.hasLocation);
+            out["selectionConfirmed"]=sameAttempt && metadata.selected.confirmed && !metadata.cleanup && (s.phase==MkbWorker::Phase::Preparing || s.phase==MkbWorker::Phase::Active);
+            if(metadata.selected.confirmed)out["selectedSelector"]=selector(metadata.selected.vid,metadata.selected.pid,metadata.selected.location,metadata.selected.hasLocation);
+            out["selectionAgeMs"]=metadata.selected.at && now>=metadata.selected.at?double(now-metadata.selected.at)/1000000:-1;
+        }
+#endif
+        return out;
+    };
+#ifdef __APPLE__
+    ops.release=[this] {
+        ReleaseMkb("dashboard-release");ClearLegacyInput();
+        if(!mkb_worker_gate)return QString("Нет worker");
+        auto sent=mkb_worker_gate->submitNeutral();
+        return sent.accepted && !sent.error?QString():QString("Отправка neutral не подтверждена");
+    };
+    ops.arm=[this] {
+        if(auto e=mkb_worker_profile.compatibilityError(true);!e.empty())return QString::fromStdString(e);
+        const auto result=MkbSessionInput::arm(mkb_worker_mode,mkb_worker.get(),mkb_worker_gate.get(),mkb_target_window.focused(),input_block!=0,
+            [this]{ClearLegacyInput();},[]{});
+        return result==MkbSessionInput::Arm::Requested?QString():QString("Захват отклонён: окно или ввод не готовы");
+    };
+    ops.queue=[this](std::shared_ptr<const MkbProfile> p,uint64_t r){return mkb_worker && mkb_worker->reconfigure(std::move(p),r);};
+    ops.queueLive=[this](std::shared_ptr<const MkbProfile> p,uint64_t r,uint64_t capture,uint64_t runtime) {
+        return mkb_worker && mkb_worker_gate && mkb_worker->reconfigureLive(std::move(p),r,{mkb_worker_gate->current().session,capture},runtime);
+    };
+    ops.cancelQueue=[this](uint64_t revision){return mkb_worker?mkb_worker->cancelReconfigure(revision):0;};
+#endif
+    return ops;
+}
+QJsonObject StreamSession::DashboardStatus() const {return dashboardController.status(const_cast<StreamSession *>(this)->DashboardOps());}
+QString StreamSession::DashboardBegin(const QString &command,const QByteArray &bytes,MkbDashboardController::Operation &operation,uint64_t expectedEpoch,uint64_t expectedRuntime) {return dashboardController.begin(command,bytes,DashboardOps(),operation,expectedEpoch,expectedRuntime);}
+QString StreamSession::DashboardPoll(MkbDashboardController::Operation operation,bool &done) {return dashboardController.poll(operation,done);}
+void StreamSession::DashboardCancel(MkbDashboardController::Operation operation) {dashboardController.cancel(operation);}
+
+void StreamSession::SetupHeadsetControl()
+{
+    if(!output_policy.headset)return;
+#ifdef Q_OS_MACOS
+    headset_backend=MkbCreateCoreAudioBackend();
+    headset_control=std::make_unique<MkbHeadsetAudioControl>(*headset_backend,audio_out_device_name,
+        [](const QString &uid) {return QSettings().value("headset-audio/"+uid+"/lastNonzero",0).toDouble();},
+        [](const QString &uid,double value) {QSettings settings;const auto key="headset-audio/"+uid+"/lastNonzero";
+            if(settings.value(key,0).toDouble()!=value)settings.setValue(key,value);});
+#endif
+    if(headset_backend)headset_backend->listen([this] {RefreshHeadsetControl();});
+    RefreshHeadsetControl();
+}
+
+void StreamSession::RefreshHeadsetControl()
+{
+    if(headset_control)headset_control->refresh();
+}
+
+QJsonObject StreamSession::HeadsetAudioStatus()
+{
+    if(!output_policy.headset || !headset_control)return {{"supported",false},{"error","headset-audio-unavailable"}};
+    RefreshHeadsetControl();
+    QJsonObject view;
+    {QMutexLocker lock(&audio_out_frame_mutex);view=headset_control->snapshot(audio_out!=0,double(audio_volume)/SDL_MIX_MAXVOLUME);}
+    if(view!=audio_last) {++audio_revision;audio_last=view;}
+    view["audioRevision"]=double(audio_revision);view["operationId"]=audio_operation;view["sampleAgeMs"]=0;
+    return view;
+}
+
+QString StreamSession::HeadsetAudioCommand(const QJsonObject &request)
+{
+    const QStringList allowed={"command","requestId","operationId","processId","sessionId","sessionGeneration","audioRevision","setVolume","setOutputMuted"};
+    for(auto it=request.begin();it!=request.end();++it)if(!allowed.contains(it.key()))return "unknown-audio-field";
+    if(request.contains("setVolume")==request.contains("setOutputMuted"))return "invalid-audio-command";
+    if(request.contains("setVolume") && (!request["setVolume"].isDouble() || !std::isfinite(request["setVolume"].toDouble()) || request["setVolume"].toDouble()<0 || request["setVolume"].toDouble()>100))return "invalid-volume";
+    if(request.contains("setOutputMuted") && !request["setOutputMuted"].isBool())return "invalid-audio-command";
+    const auto before=HeadsetAudioStatus();
+    if(!headset_control || !output_policy.headset)return "headset-audio-unavailable";
+    if(request["audioRevision"]!=before["audioRevision"])return "audio-revision-changed";
+    const auto generation=headset_control->generation;
+    const auto error=request.contains("setVolume")?headset_control->set(request["setVolume"].toDouble()/100,generation):
+        headset_control->setMuted(request["setOutputMuted"].toBool(),generation);
+    if(error.isEmpty()) {QMutexLocker lock(&audio_out_frame_mutex);audio_volume=SDL_MIX_MAXVOLUME;}
+    audio_operation=request["operationId"].toString();
+    ++audio_revision;
+    return error;
+}
+
+QString StreamSession::HeadsetAudioPoll(bool expired)
+{
+    if(!headset_control)return "headset-audio-unavailable";
+    const auto error=headset_control->poll(expired);
+    if(error.isEmpty()) {QMutexLocker lock(&audio_out_frame_mutex);audio_volume=SDL_MIX_MAXVOLUME;}
+    return error;
+}

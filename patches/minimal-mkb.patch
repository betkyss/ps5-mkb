@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbworkertypes.h"
+#include "mkbmousetrace.h"
+#include "mkbfeedbackhealth.h"
+struct MkbWorkerRecord {
+    enum class Kind { Wake, Event, Tick, Submit, Stop } kind=Kind::Wake;
+    MkbCaptureToken token;uint64_t deadline=0,wake=0,drain=0,mapperMs=0,finish=0,skipped=0,submitId=0;
+    MkbEventQueue::Event event;ChiakiControllerState state{};bool consumed=false;
+    MkbStopReason reason=MkbStopReason::None;
+};
+class MkbWorkerTrace {
+public:
+    static constexpr size_t Limit=65536;
+    struct Buffer {std::array<char,96> stopReason{};std::unique_ptr<MkbWorkerRecord[]> rows{new MkbWorkerRecord[Limit]};size_t count=0,dropped=0,invalid=0,discarded=0,oldGeneration=0;uint64_t steadyOriginNs=0,clockUncertaintyNs=0,armMs=0;};
+    struct Completion {std::atomic<bool> done{false},ok{false};std::string path;};
+private:
+    MkbFeedbackHealth health;
+    static void observeSend(void *user,const ChiakiFeedbackSendRecord *r);
+    static void observeLifecycle(void *user,uint64_t generation,bool active);
+    std::string directory;bool used=false,recording=false;
+    std::shared_ptr<Buffer> data;
+    std::shared_ptr<MkbGateTrace> journal;
+    std::shared_ptr<MkbNativePhaseTrace> native,permissions;
+    std::shared_ptr<MkbMouseTrace::SenderBuffer> sender;
+    std::shared_ptr<Completion> completion=std::make_shared<Completion>();
+    uint64_t beginNs=0,releaseNs=0;
+    std::string recoveryStatus="not-required";
+public:
+    explicit MkbWorkerTrace(std::string dir={});
+    std::shared_ptr<MkbGateTrace> gateBuffer()const{return journal;}
+    std::shared_ptr<MkbNativePhaseTrace> nativeBuffer()const{return native;}
+    std::shared_ptr<MkbNativePhaseTrace> permissionBuffer()const{return permissions;}
+    std::shared_ptr<Completion> result()const{return completion;}
+    ChiakiFeedbackObserver observer(){return {observeSend,this,observeLifecycle};}
+    bool feedbackHealth(MkbFeedbackHealth::Words &out)const{return health.read(out);}
+    void begin(uint64_t nowNs);
+    void clockMapping(uint64_t origin,uint64_t uncertainty,uint64_t armMs=0){if(recording){data->steadyOriginNs=origin;data->clockUncertaintyNs=uncertainty;data->armMs=armMs;}}
+    void append(const MkbWorkerRecord &row);
+    void beginRelease(uint64_t nowNs,const char *reason);
+    void finish(uint64_t nowNs,const char *reason=nullptr,const char *recovery="not-required");
+};
diff --git a/gui/src/mkbworkertrace.cpp b/gui/src/mkbworkertrace.cpp
new file mode 100644
index 0000000..cff324d
--- /dev/null
+++ b/gui/src/mkbworkertrace.cpp
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbworkertrace.h"
+#include <chiaki/time.h>
+#include <thread>
+#include <sstream>
+#include <locale>
+#include <iomanip>
+#include <limits>
+namespace {std::atomic<unsigned> workerExporters{0};}
+void MkbWorkerTrace::observeSend(void *user,const ChiakiFeedbackSendRecord *r) {
+    auto &self=*static_cast<MkbWorkerTrace *>(user);
+    self.health.observe(*r);
+    if(self.sender)MkbMouseTrace::observe(self.sender.get(),r);
+}
+void MkbWorkerTrace::observeLifecycle(void *user,uint64_t generation,bool active) {
+    static_cast<MkbWorkerTrace *>(user)->health.lifecycle(generation,active);
+}
+MkbWorkerTrace::MkbWorkerTrace(std::string dir):directory(std::move(dir)) {
+    if(directory.empty()){completion->done=true;return;}
+    try {
+        data=std::make_shared<Buffer>();journal=std::make_shared<MkbGateTrace>();
+        native=std::make_shared<MkbNativePhaseTrace>();permissions=std::make_shared<MkbNativePhaseTrace>(8192);
+        sender=std::make_shared<MkbMouseTrace::SenderBuffer>(Limit);
+    }catch(...){data.reset();journal.reset();native.reset();permissions.reset();sender.reset();completion->done=true;}
+}
+void MkbWorkerTrace::begin(uint64_t ns) {
+    if(used||!data)return;used=true;recording=true;beginNs=ns;
+    native->start(ns);permissions->start(ns);
+    const auto before=MkbNativePhaseTrace::now();const auto us=chiaki_time_now_monotonic_us();const auto after=MkbNativePhaseTrace::now();
+    sender->begin=us;sender->deadline=us+60000000;
+    sender->clockValid=before&&after>=before&&us;sender->offsetUs=int64_t((before+(after-before)/2)/1000)-int64_t(us);
+    sender->uncertaintyUs=(after-before)/2000+1;
+}
+void MkbWorkerTrace::append(const MkbWorkerRecord &row) {
+    if(!recording)return;
+    if(row.finish && row.finish<beginNs){++data->invalid;return;}
+    if(row.finish && row.finish-beginNs>=MkbNativePhaseTrace::DurationNs){finish(beginNs+MkbNativePhaseTrace::DurationNs,"trace-duration-limit","pending");return;}
+    if(row.kind==MkbWorkerRecord::Kind::Event && !row.consumed){++data->discarded;if(row.reason==MkbStopReason::Session)++data->oldGeneration;}
+    if(data->count==Limit){++data->dropped;return;}data->rows[data->count++]=row;
+}
+void MkbWorkerTrace::beginRelease(uint64_t ns,const char *reason) {
+    if(!recording)return;
+    if(reason)MkbCopyReason(data->stopReason,reason);
+    if(releaseNs)return;
+    releaseNs=ns;
+    // releaseNs belongs to mach-absolute-ns; map the actual gate boundary.
+    const auto mapped=int64_t(ns/1000)-sender->offsetUs;
+    sender->release=mapped>0?uint64_t(mapped):0;
+}
+void MkbWorkerTrace::finish(uint64_t ns,const char *reason,const char *recovery) {
+    if(!recording)return;
+    if(!releaseNs)beginRelease(ns,reason);
+    recording=false;recoveryStatus=recovery;
+    auto rows=data;const auto n=rows->count;auto gates=journal;const auto gn=gates->close();const auto gd=gates->dropped.load();auto result=completion;
+    MkbMouseTrace::Snapshot evidence;evidence.begin=beginNs/1000000;evidence.end=ns/1000000;
+    evidence.phases=native;evidence.phaseCount=native->stop(ns);evidence.permissionPhases=permissions;
+    evidence.permissionPhaseCount=permissions->stop(ns);evidence.sender=sender;
+    sender->deadline=std::min(sender->deadline.load(),chiaki_time_now_monotonic_us()+300000);
+    if(workerExporters.fetch_add(1)>=2){--workerExporters;result->done=true;return;}
+    try {
+        std::thread([rows,n,gates,gn,gd,result,evidence,release=releaseNs,end=ns,recovery=recoveryStatus,dir=directory] {
+            std::this_thread::sleep_for(std::chrono::milliseconds(300));evidence.sender->closed=true;
+            bool ok=false;
+            try {
+                std::ostringstream out;out.imbue(std::locale::classic());out<<std::setprecision(std::numeric_limits<double>::max_digits10);
+                out<<"{\"version\":1,\"kind\":\"independent-mapper-worker\",\"release_begin_ns\":"<<release<<",\"recovery_end_ns\":"<<end<<",\"recovery_status\":"<<std::quoted(recovery)<<",\"export_status\":"<<std::quoted(recovery=="pending"?"incomplete":"complete")<<",\"worker_dropped\":"<<rows->dropped<<",\"gate_dropped\":"<<gd<<",\"worker_invalid\":"<<rows->invalid<<",\"discarded_events\":"<<rows->discarded<<",\"old_generation_events\":"<<rows->oldGeneration<<",\"pending_at_release\":\"not_observed\",\"steady_origin_ns\":"<<rows->steadyOriginNs<<",\"clock_uncertainty_ns\":"<<rows->clockUncertaintyNs<<",\"arm_ms\":"<<rows->armMs<<",\"stop_reason\":"<<std::quoted(rows->stopReason.data())<<",\"worker\":[";
+                for(size_t i=0;i<n;++i){const auto &r=rows->rows[i];if(i)out<<',';
+                    out<<"{\"kind\":"<<int(r.kind)<<",\"session\":"<<r.token.session<<",\"capture\":"<<r.token.capture
+                       <<",\"deadline_ns\":"<<r.deadline<<",\"wake_ns\":"<<r.wake<<",\"drain_ns\":"<<r.drain<<",\"mapper_ms\":"<<r.mapperMs
+                       <<",\"finish_ns\":"<<r.finish<<",\"skipped\":"<<r.skipped<<",\"submit_id\":"<<r.submitId<<",\"reason\":"<<int(r.reason)
+                       <<",\"consumed\":"<<(r.consumed?"true":"false")<<",\"generation\":"<<r.event.generation<<",\"sequence\":"<<r.event.native.sequence
+                       <<",\"source_ns\":"<<r.event.native.sourceNs<<",\"arrival_ns\":"<<r.event.native.arrivalNs<<",\"ingest_sequence\":"<<r.event.ingestSequence
+                       <<",\"ingest_ms\":"<<r.event.ingestTime<<",\"source_ms\":"<<r.event.timestamp<<",\"source\":"<<r.event.source<<",\"key\":"<<r.event.key
+                       <<",\"whole_report\":"<<(r.event.wholeReport?"true":"false")<<",\"native_clock\":"<<int(r.event.native.clock)<<",\"down\":"<<(r.event.down?"true":"false")<<",\"buttons\":"<<unsigned(r.event.buttons)<<",\"dx\":"<<r.event.dx<<",\"dy\":"<<r.event.dy<<'}';}
+                out<<"],\"gate\":[";
+                for(size_t i=0;i<gn;++i){const auto &r=gates->rows[i];if(i)out<<',';
+                    out<<"{\"id\":"<<r.id<<",\"session\":"<<r.token.session<<",\"capture\":"<<r.token.capture<<",\"begin_ns\":"<<r.begin<<",\"end_ns\":"<<r.end
+                       <<",\"thread\":"<<r.thread<<",\"accepted\":"<<(r.accepted?"true":"false")<<",\"result\":"<<r.result<<",\"reason_code\":"<<int(r.kind)
+                       <<",\"reason\":"<<std::quoted(r.reason.data())<<",\"left_x\":"<<r.state.left_x<<",\"left_y\":"<<r.state.left_y<<",\"right_x\":"<<r.state.right_x<<",\"right_y\":"<<r.state.right_y<<",\"buttons\":"<<r.state.buttons<<",\"l2\":"<<unsigned(r.state.l2_state)<<",\"r2\":"<<unsigned(r.state.r2_state)<<'}';}
+                out<<"],\"evidence\":"<<MkbMouseTrace::serialize(evidence)<<"}\n";
+                ok=MkbMouseTrace::writeBytes(dir,out.str(),result->path);
+            }catch(...){}
+            result->ok=ok;result->done=true;--workerExporters;
+        }).detach();
+    }catch(...){--workerExporters;result->done=true;}
+}

+// The native callback and offline tests use the same bounded handoff queue.
+#include <deque>
+#include <mutex>
+class MkbEventQueue
+{
+public:
+    struct NativeTiming {
+        enum class Clock : uint8_t { Unknown, MachAbsoluteNs };
+        uint64_t sourceNs=0, arrivalNs=0, drainNs=0, sequence=0;
+        Clock clock=Clock::Unknown;
+    };
+    struct Event {
+        uint64_t generation, timestamp; int key; bool down; double dx, dy; int source; bool repeat;
+        NativeTiming native; // Только диагностика; не участвует в mapper и сортировке.
+        bool wholeReport = false;
+        uint8_t buttons = 0;
+        uint64_t ingestSequence = 0, ingestTime = 0; // ingestTime in mapper milliseconds.
+        Event(uint64_t g=0, uint64_t t=0, int k=-1, bool d=false, double x=0, double y=0, int s=-1, bool r=false)
+            : generation(g), timestamp(t), key(k), down(d), dx(x), dy(y), source(s), repeat(r) {}
+    };
+    void reset();
+    bool push(const Event &event);
+    void fail(const char *reason);
+    bool drain(std::deque<Event> &events, std::string &failure);
+private:
+    std::mutex mutex;
+    std::deque<Event> queue;
+    std::string error;
+};
+
+inline void MkbDispatchEvent(MkbMapper &mapper, const MkbEventQueue::Event &event, uint64_t now)
+{
+    if(event.wholeReport)
+        mapper.report(event.generation, event.dx, event.dy, event.buttons,
+            event.timestamp, event.ingestTime, now);
+    else if(event.source >= 0) {
+        if(event.ingestSequence)
+            mapper.physicalIngest(event.generation, event.source, event.down,
+                event.timestamp, event.ingestTime, now, event.repeat);
+        else
+            mapper.physical(event.generation, event.source, event.down, event.timestamp, now, event.repeat);
+    }
+    else if(event.key >= 0)
+        mapper.key(event.generation, static_cast<MkbMapper::Key>(event.key), event.down, event.timestamp, now);
+    else
+        mapper.motion(event.generation, event.dx, event.dy, event.timestamp, now);
+}

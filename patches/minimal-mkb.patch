+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkboutputpolicy.h"
+#include <QtGlobal>
+#include <QString>
+#include <algorithm>
+#include <cstdint>
+
+inline ChiakiDisableAudioVideo MkbAudioVideoDisabled(ChiakiDisableAudioVideo saved)
+{
+    return MkbOutputPolicy::select(saved, qEnvironmentVariable("CHIAKI_MKB_NO_AV")==QStringLiteral("1"),
+        qEnvironmentVariable("CHIAKI_MKB_HEADSET_QUIET")==QStringLiteral("1")).audioVideo;
+}
+
+class MkbLatencyStats
+{
+public:
+    struct Samples {
+        uint64_t count=0, min=0, max=0, sum=0;
+        void add(uint64_t value) {
+            min=count ? std::min(min,value) : value; max=std::max(max,value); sum+=value; ++count;
+        }
+        double mean() const { return count ? double(sum)/count : 0; }
+    };
+    struct Report { Samples age, dt; };
+    void begin(uint64_t now) { lastTick=lastReport=now; samples={}; }
+    void event(uint64_t timestamp,uint64_t now) { if(now>=timestamp) samples.age.add(now-timestamp); }
+    void tick(uint64_t now) { if(now>=lastTick) samples.dt.add(now-lastTick); lastTick=now; }
+    bool report(uint64_t now,Report &out) {
+        if(now<lastReport || now-lastReport<1000) return false;
+        out=samples; samples={}; lastReport=now; return true;
+    }
+private:
+    uint64_t lastTick=0,lastReport=0;
+    Report samples;
+};
diff --git a/gui/include/mkbmouseinput.h b/gui/include/mkbmouseinput.h
new file mode 100644
index 0000000..1d5231f
--- /dev/null
+++ b/gui/include/mkbmouseinput.h
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbmapper.h"
+#include <atomic>
+#include <algorithm>
+#include <mutex>
+#include <limits>
+#include <vector>
+#include <chrono>
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+#endif
+
+// Чистая часть native-ввода. Тот же перевод и очередь используются в replay.
+namespace MkbMouseInput {
+enum class Source { CG, HID };
+struct Config {
+    Source source = Source::CG;
+    uint32_t vid = 0, pid = 0, location = 0;
+    bool hasLocation = false;
+    const char *error = nullptr;
+};
+inline bool number(const char *text, uint32_t maximum, uint32_t &out)
+{
+    if(!text || !*text) return false;
+    unsigned base = 10;
+    if(text[0]=='0' && (text[1]=='x' || text[1]=='X')) { base=16; text+=2; }
+    if(!*text) return false;
+    uint32_t value=0;
+    for(; *text; ++text) {
+        unsigned digit = *text>='0' && *text<='9' ? unsigned(*text-'0') :
+            *text>='a' && *text<='f' ? unsigned(*text-'a'+10) :
+            *text>='A' && *text<='F' ? unsigned(*text-'A'+10) : 16;
+        if(digit>=base || digit>maximum || value>(maximum-digit)/base) return false;
+        value=value*base+digit;
+    }
+    out=value; return true;
+}
+inline Config parse(const char *source, const char *vid, const char *pid, const char *location)
+{
+    Config config;
+    if(!source || std::string(source)=="cg") return config;
+    if(std::string(source)!="hid") { config.error="unknown-mouse-source"; return config; }
+    config.source=Source::HID;
+    if(!number(vid,65535,config.vid) || !number(pid,65535,config.pid) ||
+        (location && !number(location,UINT32_MAX,config.location))) config.error="invalid-hid-selector";
+    config.hasLocation=location!=nullptr;
+    return config;
+}
+struct Axis {
+    uint64_t cookie=0, collection=0;
+    unsigned usage=0;
+};
+struct Device {
+    uint32_t vid=0, pid=0, location=0;
+    bool identifiers=false, hasLocation=false;
+    std::vector<Axis> axes;
+    bool mouse=true;
+};
+struct Selection {
+    size_t index=0;
+    uint64_t x=0, y=0;
+    const char *error=nullptr;
+};
+inline Selection select(const Config &config, const std::vector<Device> &devices)
+{
+    Selection result;
+    if(config.error) { result.error=config.error; return result; }
+    size_t matches=0;
+    for(size_t i=0; i<devices.size(); ++i) {
+        const auto &d=devices[i];
+        if(!d.mouse || !d.identifiers || d.vid!=config.vid || d.pid!=config.pid ||
+            (config.hasLocation && (!d.hasLocation || d.location!=config.location))) continue;
+        result.index=i; ++matches;
+    }
+    if(matches!=1) { result.error=matches ? "ambiguous-hid-device" : "hid-device-not-found"; return result; }
+    const auto &axes=devices[result.index].axes;
+    const Axis *x=nullptr, *y=nullptr;
+    for(const auto &axis:axes) {
+        auto &slot=axis.usage==0x30 ? x : y;
+        if(axis.usage!=0x30 && axis.usage!=0x31) continue;
+        if(slot) { result.error="ambiguous-hid-axes"; return result; }
+        slot=&axis;
+    }
+    if(!x || !y || !x->cookie || !y->cookie || !x->collection ||
+        x->cookie==y->cookie || x->collection!=y->collection) result.error="invalid-hid-axes";
+    else { result.x=x->cookie; result.y=y->cookie; }
+    return result;
+}
+struct Clock {
+    uint32_t numer=1, denom=1;
+    uint64_t originTicks=0, originMs=0;
+};
+struct Sample {
+    uint64_t generation=0, cookie=0, timestamp=0, received=0;
+    int64_t delta=0;
+    const char *error=nullptr;
+};
+struct Translation {
+    MkbEventQueue::Event event;
+    bool mapped=false;
+    uint64_t sourceNs=0;
+    const char *error=nullptr;
+};
+inline Translation translate(const Sample &sample, const Clock &clock,
+    uint64_t generation, uint64_t armedTicks, uint64_t x, uint64_t y)
+{
+    Translation out;
+    if(sample.generation!=generation) return out;
+    if(sample.error) { out.error=sample.error; return out; }
+    if(sample.cookie!=x && sample.cookie!=y) { out.error="invalid-hid-element"; return out; }
+    if(!clock.numer || !clock.denom) { out.error="invalid-hid-timebase"; return out; }
+    if(sample.timestamp>sample.received) { out.error="future-hid-event"; return out; }
+    // До округления: даже 100 мс + один tick уже устарели.
+    const __uint128_t age=__uint128_t(sample.received-sample.timestamp)*clock.numer;
+    if(age>__uint128_t(100000000)*clock.denom) {
+        if(sample.delta) out.error="stale-hid-event";
+        return out;
+    }
+    if(sample.timestamp<armedTicks) return out;
+    if(sample.timestamp<clock.originTicks) { out.error="invalid-hid-origin"; return out; }
+    const __uint128_t millis=__uint128_t(sample.timestamp-clock.originTicks)*clock.numer/clock.denom/1000000;
+    if(millis>UINT64_MAX-clock.originMs) { out.error="invalid-hid-timestamp"; return out; }
+    // IOHID целые должны точно представляться double, иначе не теряем counts молча.
+    if(sample.delta>9007199254740991LL || sample.delta< -9007199254740991LL) {
+        out.error="invalid-hid-delta"; return out;
+    }
+    const __uint128_t ns=__uint128_t(sample.timestamp-clock.originTicks)*clock.numer/clock.denom + __uint128_t(clock.originMs)*1000000;
+    if(ns>UINT64_MAX) { out.error="invalid-hid-timestamp"; return out; }
+    out.sourceNs=uint64_t(ns);
+    out.event={generation,clock.originMs+uint64_t(millis),-1,false,
+        sample.cookie==x ? double(sample.delta) : 0, sample.cookie==y ? double(sample.delta) : 0};
+    // Абсолютная шкала mach, отдельно от существующего relative sourceNs/timestamp.
+    const __uint128_t sourceAbsolute=__uint128_t(sample.timestamp)*clock.numer/clock.denom;
+    const __uint128_t arrivalAbsolute=__uint128_t(sample.received)*clock.numer/clock.denom;
+    if(sample.timestamp && sample.received && sourceAbsolute<=UINT64_MAX && arrivalAbsolute<=UINT64_MAX) {
+        out.event.native.sourceNs=uint64_t(sourceAbsolute);
+        out.event.native.arrivalNs=uint64_t(arrivalAbsolute);
+        out.event.native.clock=MkbEventQueue::NativeTiming::Clock::MachAbsoluteNs;
+    }
+    out.mapped=true; return out;
+}
+// Whole HID reports publish atomically in ingest order. CG-only events stay
+// staged until seal orders them by source time; pump timing defines no report boundary.
+class Handoff {
+public:
+    using IngestClock = std::function<uint64_t()>; // Absolute ns, same clock as sourceNs.
+    static uint64_t nowNs() {
+#ifdef __APPLE__
+        mach_timebase_info_data_t base{};
+        if(mach_timebase_info(&base)!=KERN_SUCCESS || !base.denom) return 0;
+        const __uint128_t ns=__uint128_t(mach_absolute_time())*base.numer/base.denom;
+        return ns<=UINT64_MAX ? uint64_t(ns) : 0;
+#else
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+    }
+    void begin(Source value, uint64_t epoch, Clock time, uint64_t start, uint64_t xAxis=0, uint64_t yAxis=0, IngestClock ingest=&Handoff::nowNs) {
+        std::lock_guard<std::mutex> lock(mutex);
+        queue.reset(); terminalReason.clear(); staged.clear(); published=0; watermark=0; hasWatermark=false;watermarkButton=false;
+        accepted=zero=nextSequence=nextIngest=lastIngestNs=0; ingestClock=ingest; source=value; generation=epoch; clock=time; armedTicks=start;
+        x=xAxis; y=yAxis; active=true;
+        if(!clock.numer || !clock.denom || start<clock.originTicks) { failLocked("invalid-input-clock"); return; }
+        const __uint128_t ns=__uint128_t(start-clock.originTicks)*clock.numer/clock.denom+__uint128_t(clock.originMs)*1000000;
+        if(ns>UINT64_MAX) { failLocked("invalid-input-clock"); return; }
+        armedNs=uint64_t(ns);
+    }
+    void stop() { std::lock_guard<std::mutex> lock(mutex); active=false; staged.clear(); queue.reset(); published=0; }
+    bool running() const { return active; }
+    std::string failureReason() const {std::lock_guard<std::mutex> lock(mutex);return terminalReason;}
+    void fail(const char *reason) { std::lock_guard<std::mutex> lock(mutex); failLocked(reason); }
+    bool push(const MkbEventQueue::Event &event, bool cgMotion=false, uint64_t sourceNs=0) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if(!active || event.generation!=generation || (source==Source::HID && (cgMotion || event.source<0 || event.source>=256))) return false;
+        if(!sourceNs) {
+            if(event.timestamp>UINT64_MAX/1000000) { failLocked("invalid-event-timestamp"); return false; }
+            sourceNs=event.timestamp*1000000;
+        }
+        if(sourceNs<armedNs) return false;
+        auto pending=event;
+        return stage(pending,sourceNs);
+    }
+    Translation hid(const Sample &sample) {
+        std::lock_guard<std::mutex> lock(mutex);
+        Translation value;
+        if(!active || source!=Source::HID) return value;
+        value=translate(sample,clock,generation,armedTicks,x,y);
+        if(value.error) failLocked(value.error);
+        else if(value.mapped) {
+            // Legacy single-axis adapter, not a mouse-button snapshot.
+            if(stage(value.event,value.sourceNs)) {
+                ++accepted; if(!sample.delta) ++zero;
+            }
+        }
+        return value;
+    }
+    Translation report(int64_t dx,int64_t dy,uint64_t timestamp,uint64_t received,uint64_t epoch,uint8_t buttons=0) {
+        std::lock_guard<std::mutex> lock(mutex);
+        Translation value;
+        if(!active || source!=Source::HID || epoch!=generation) return value;
+        value=translate({epoch,x,timestamp,received,dx?dx:(dy?dy:1),nullptr},clock,generation,armedTicks,x,y);
+        if(buttons&~uint8_t(31)) value.error="invalid-hid-buttons";
+        if(dy>9007199254740991LL || dy< -9007199254740991LL) value.error="invalid-hid-delta";
+        if(value.error) failLocked(value.error);
+        else if(value.mapped) {
+            value.event.dx=double(dx);value.event.dy=double(dy);
+            value.event.wholeReport=true;value.event.buttons=buttons;
+            if(stage(value.event,value.sourceNs)) { ++accepted;if(!dx&&!dy)++zero; }
+        }
+        return value;
+    }
+    bool seal() {
+        std::lock_guard<std::mutex> lock(mutex);
+        if(!active) return false;
+        if(source==Source::HID) return true; // Already published atomically at ingest.
+        std::stable_sort(staged.begin(),staged.end(),[](const Pending &a,const Pending &b) {
+            if(a.ns!=b.ns) return a.ns<b.ns;
+            // An equal-timestamp movement belongs to the mode preceding a button transition.
+            return a.event.source<0 && b.event.source>=0;
+        });
+        for(size_t i=0; i<staged.size(); ++i) {
+            auto event=staged[i].event;
+            if(!queue.push(event)) { failLocked("queue-overflow"); return false; }
+            ++published;
+        }
+        if(!staged.empty()) {
+            for(const auto &p:staged) if(p.ns>=watermark) {
+                if(p.ns>watermark) watermarkButton=false;
+                watermark=p.ns; watermarkButton=watermarkButton || p.event.source>=0;
+            }
+            hasWatermark=true;
+        }
+        staged.clear(); return true;
+    }
+    bool drain(std::deque<MkbEventQueue::Event> &events, std::string &failure, uint64_t at=0, uint64_t (*drainClock)()=nullptr) {
+        std::lock_guard<std::mutex> lock(mutex);
+        const bool healthy=queue.drain(events,failure); published=0;
+        if(!active || !healthy) { events.clear(); return false; }
+        if(drainClock && !events.empty()) {
+            const uint64_t stamp=drainClock();
+            for(auto &event:events) if(!event.native.drainNs) event.native.drainNs=stamp;
+        }
+        if(at) for(auto it=events.begin(); it!=events.end();) {
+            if(!it->wholeReport && it->timestamp<=at && at-it->timestamp>100 && it->source<0 && !it->dx && !it->dy) it=events.erase(it);
+            else ++it;
+        }
+        return true;
+    }
+    std::pair<uint64_t,uint64_t> counts() const {
+        std::lock_guard<std::mutex> lock(mutex); return {accepted,zero};
+    }
+private:
+    struct Pending { MkbEventQueue::Event event; uint64_t ns; };
+    bool stage(MkbEventQueue::Event &event,uint64_t ns) {
+        if(source==Source::HID) {
+            const uint64_t stamp=ingestClock ? ingestClock() : 0;
+            if(!stamp || stamp<lastIngestNs) {failLocked("invalid-ingest-clock");return false;}
+            if(ns>stamp) {failLocked("future-hid-event");return false;}
+            if(stamp-ns>100000000) {failLocked("stale-hid-event");return false;}
+            if(published>=512) {failLocked("queue-overflow");return false;}
+            if(nextIngest==UINT64_MAX || (event.source<0 && nextSequence==UINT64_MAX)) {
+                failLocked("input-sequence-overflow");return false;
+            }
+            event.ingestSequence=++nextIngest;event.ingestTime=stamp/1000000;lastIngestNs=stamp;
+            if(event.source<0) event.native.sequence=++nextSequence;
+            if(!queue.push(event)) {failLocked("queue-overflow");return false;}
+            ++published;return true;
+        }
+        // A zero-only sample has no mapper/ADS effect. Preserve its exact
+        // timestamp and count even when a sensor repeats an older zero axis.
+        if(hasWatermark && (ns<watermark || (ns==watermark && watermarkButton)) && (event.source>=0 || event.dx || event.dy)) {
+            failLocked("late-input-order"); return false;
+        }
+        if(staged.size()+published>=512) { failLocked("queue-overflow"); return false; }
+        if(event.source<0 && event.key<0) {
+            if(!event.native.sequence && nextSequence<UINT64_MAX) event.native.sequence=++nextSequence;
+            else nextSequence=std::max(nextSequence,event.native.sequence);
+        }
+        staged.push_back({event,ns}); return true;
+    }
+    void failLocked(const char *reason) { if(terminalReason.empty())terminalReason=reason; active=false; staged.clear(); queue.fail(reason); published=0; }
+    mutable std::mutex mutex;
+    MkbEventQueue queue;
+    std::string terminalReason;
+    std::vector<Pending> staged;
+    std::atomic<bool> active{false};
+    Source source=Source::CG;
+    uint64_t generation=0, armedTicks=0, x=0, y=0, watermark=0, armedNs=0, accepted=0, zero=0, nextSequence=0;
+    size_t published=0;
+    bool hasWatermark=false,watermarkButton=false;
+    uint64_t nextIngest=0,lastIngestNs=0;
+    IngestClock ingestClock=&Handoff::nowNs;
+    Clock clock;
+};
+}
diff --git a/gui/include/mkbcapturelifecycle.h b/gui/include/mkbcapturelifecycle.h
new file mode 100644
index 0000000..d7a90b6
--- /dev/null
+++ b/gui/include/mkbcapturelifecycle.h
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbmouseinput.h"
+#include "mkbhidreport.h"
+#include "mkbnativephasetrace.h"
+#include "mkbpermissionmonitor.h"
+#include "mkbworkertypes.h"
+#include "mkbstatuspublication.h"
+#include <condition_variable>
+#include <memory>
+#include <functional>
+#include <thread>
+#include <cstdio>
+
+struct MkbSelectedDevice {
+    bool confirmed=false,hasLocation=false;
+    uint32_t vid=0,pid=0,location=0;
+    uint64_t at=0;
+};
+// Shared channels outlive the GUI session, but retain no native resource.
+// Request has one worker writer; native has one capture writer protected by
+// nativeBusy; permission has one monitor writer protected by occupied.
+struct MkbLifecyclePublications {
+    MkbStatusPublication<12> request;
+    MkbStatusPublication<10> native;
+    MkbStatusPublication<6> permission;
+};
+struct MkbCaptureAttempt {
+    mutable std::mutex mutex; // control/debug only, never used by a status reader
+    const MkbMouseInput::Config requested;
+    const MkbCaptureToken token;
+    const std::shared_ptr<MkbLifecyclePublications> views;
+    MkbSelectedDevice selected;
+    std::weak_ptr<MkbPermissionMonitor> monitor;
+    std::atomic<bool> finished{false};
+    explicit MkbCaptureAttempt(MkbMouseInput::Config config,MkbCaptureToken identity={},
+        std::shared_ptr<MkbLifecyclePublications> channels=std::make_shared<MkbLifecyclePublications>())
+        :requested(config),token(identity),views(std::move(channels)){}
+    void publishMonitor(const std::shared_ptr<MkbPermissionMonitor> &value) {
+        std::lock_guard<std::mutex> lock(mutex);monitor=value;
+    }
+    void publishSelected(const MkbSelectedDevice &value) {
+        std::lock_guard<std::mutex> lock(mutex);if(finished.load())return;selected=value;
+        views->native.publish({token.session,token.capture,uint64_t(finished.load()),uint64_t(value.confirmed),
+            uint64_t(value.hasLocation),value.vid,value.pid,value.location,value.at,MkbNativePhaseTrace::now()});
+    }
+    void finish() {
+        std::lock_guard<std::mutex> lock(mutex);finished.store(true);
+        views->native.publish({token.session,token.capture,1,uint64_t(selected.confirmed),
+            uint64_t(selected.hasLocation),selected.vid,selected.pid,selected.location,selected.at,MkbNativePhaseTrace::now()});
+    }
+    void publishPermissions(const MkbPermissionSnapshot::Value &p) {
+        views->permission.publish({token.session,token.capture,p.start,p.end,uint64_t(p.status),uint64_t(p.tapChecked)});
+    }
+};
+struct MkbCaptureLifecycle {
+    struct Snapshot {
+        MkbCaptureToken token;
+        bool cleanup=true;
+        uint64_t revision=0;
+        MkbMouseInput::Config requested;
+        MkbSelectedDevice selected;
+        MkbPermissionSnapshot::Value permissions;
+        bool known=false;
+    };
+    mutable std::mutex mutex; // request ownership, not a read-side lock
+    MkbCaptureToken token;
+    MkbMouseInput::Config requested=MkbMouseInput::parse(std::getenv("CHIAKI_MKB_MOUSE_SOURCE"),
+        std::getenv("CHIAKI_MKB_HID_VID"),std::getenv("CHIAKI_MKB_HID_PID"),std::getenv("CHIAKI_MKB_HID_LOCATION"));
+    std::shared_ptr<MkbCaptureAttempt> attempt,cleanupDependency;
+    std::shared_ptr<MkbLifecyclePublications> views=std::make_shared<MkbLifecyclePublications>();
+    MkbCaptureLifecycle(){publishRequest({},false);}
+    void publishRequest(MkbCaptureToken dependency,bool required) {
+        views->request.publish({token.session,token.capture,uint64_t(requested.source),requested.vid,requested.pid,
+            requested.location,uint64_t(requested.hasLocation),uint64_t(requested.error!=nullptr),
+            dependency.session,dependency.capture,uint64_t(required),MkbNativePhaseTrace::now()});
+    }
+    void reserve(MkbCaptureToken identity,MkbMouseInput::Config config,std::shared_ptr<MkbCaptureAttempt> previous) {
+        std::lock_guard<std::mutex> lock(mutex);token=identity;requested=config;attempt.reset();cleanupDependency=std::move(previous);
+        publishRequest(cleanupDependency?cleanupDependency->token:MkbCaptureToken{},cleanupDependency && !cleanupDependency->finished.load());
+    }
+    std::shared_ptr<MkbCaptureAttempt> begin(MkbCaptureToken identity,MkbMouseInput::Config config) {
+        auto next=std::make_shared<MkbCaptureAttempt>(config,identity,views);
+        std::lock_guard<std::mutex> lock(mutex);token=identity;requested=config;attempt=next;cleanupDependency.reset();
+        publishRequest(identity,true);return next;
+    }
+    Snapshot snapshot() const {
+        Snapshot out;MkbStatusPublication<12>::Words r{},after{};
+        MkbStatusPublication<10>::Words n{};MkbStatusPublication<6>::Words p{};
+        if(!views->request.read(r)){out.cleanup=false;return out;}
+        const bool nativeKnown=views->native.read(n),permissionKnown=views->permission.read(p);
+        if(!views->request.read(after) || r!=after){out.cleanup=false;return out;}
+        out.known=true;out.token={r[0],r[1]};out.requested.source=MkbMouseInput::Source(r[2]);
+        out.requested.vid=uint32_t(r[3]);out.requested.pid=uint32_t(r[4]);out.requested.location=uint32_t(r[5]);
+        out.requested.hasLocation=r[6];out.requested.error=r[7]?"invalid-selector":nullptr;
+        out.cleanup=!r[10] || (nativeKnown && n[0]==r[8] && n[1]==r[9] && n[2]);
+        if(nativeKnown && n[0]==r[0] && n[1]==r[1])
+            out.selected={bool(n[3]),bool(n[4]),uint32_t(n[5]),uint32_t(n[6]),uint32_t(n[7]),n[8]};
+        if(permissionKnown && p[0]==r[0] && p[1]==r[1])
+            out.permissions={p[2],p[3],MkbPermissionSnapshot::Status(p[4]),bool(p[5])};
+        return out;
+    }
+};
+// A worker owns its native backend and this shared context until native cleanup
+// has returned. No callback retains a GUI object or the MacInputCapture facade.
+struct MkbCaptureState : std::enable_shared_from_this<MkbCaptureState> {
+    enum class Phase { Pending, Ready, Active, Stopping, Failed, Idle };
+    std::mutex control;
+    std::condition_variable changed;
+    Phase phase=Phase::Pending;
+    std::string error;
+    std::atomic<bool> cancelled{false}, finished{false};
+    std::atomic<uint64_t> heartbeat{0};
+    std::atomic<void *> nativeTap{nullptr};
+    std::atomic<const char *> tapStage{"not-created"};
+    uint64_t requestedAt=0, readyAt=0, generation=0, activationWaitMs=2000;
+    MkbHidReport::Descriptor descriptor;
+    std::array<uint8_t,MkbHidReport::BufferSize> reportBuffer{};
+    uint64_t x=0,y=0;
+    MkbMouseInput::Clock clock;
+    MkbMouseInput::Config config;
+    MkbProfile profile;
+    std::mutex profileMutex;
+    MkbSelectedDevice selected;
+    std::shared_ptr<MkbCaptureAttempt> lifecycle;
+    MkbMouseInput::Handoff input;
+    std::shared_ptr<MkbNativePhaseTrace> phases,permissionPhases;
+    std::shared_ptr<MkbPermissionMonitor> permissions;
+    std::function<void(const char *)> failureHook;
+    void fail(const char *reason) {
+        input.fail(reason);
+        bool first=false;
+        {std::lock_guard<std::mutex> lock(control);
+            if(error.empty()) {error=reason;first=true;}
+            phase=Phase::Failed;cancelled=true;changed.notify_all();
+        }
+        if(first && failureHook) failureHook(reason);
+        if(first) std::fprintf(stderr,"MKB capture failure: %s\n",reason);
+    }
+    void inputStopped() {
+        if(failureHook) {
+            const auto reason=input.failureReason();
+            if(!reason.empty()) {fail(reason.c_str());return;}
+        }
+        cancelled=true;
+    }
+    bool finishDrain(std::deque<MkbEventQueue::Event> &events,std::string &failure,bool healthy) {
+        std::lock_guard<std::mutex> lock(control);
+        if(cancelled || !healthy) {
+            events.clear();
+            if(!error.empty()) failure=error;
+            if(failure.empty()) failure="capture-stopped";
+            return false;
+        }
+        return true;
+    }
+    void cancel() {
+        cancelled=true; input.stop();
+        std::lock_guard<std::mutex> lock(control);
+        if(phase!=Phase::Failed) phase=Phase::Stopping;
+        changed.notify_all();
+    }
+};
+struct MkbNativeBackend {
+    virtual ~MkbNativeBackend() = default;
+    virtual MkbPermissionMonitor::Ops permissionOps() {return {};}
+    virtual bool prepare(MkbCaptureState &) = 0;
+    virtual void restoreCursor() {}
+    virtual void pumpReady(MkbCaptureState &) {}
+    // pump orders completed reports; it never constructs a report boundary.
+    virtual void pump(MkbCaptureState &) = 0;
+};
+
+inline bool MkbHeartbeatExpired(std::atomic<uint64_t> &heartbeat,const std::function<uint64_t()> &clock) {
+    const auto beat=heartbeat.load();
+    const auto stamp=clock();
+    return stamp<beat || stamp-beat>250;
+}
+
+// Uses the same bounded startup logic with native or injected tap operations.
+// No false/true disable cycle is performed; disabled notifications are failures.
+struct MkbTapStartupOps {
+    std::function<void()> requestEnable;
+    std::function<bool()> enabled;
+    std::function<void()> pump;
+    std::function<uint64_t()> clock;
+};
+inline bool MkbWaitForTap(MkbCaptureState &state,const MkbTapStartupOps &ops,
+    uint64_t timeoutMs=100,unsigned maximumPumps=64) {
+    if(state.cancelled) return false;
+    state.tapStage="startup-enable";
+    const auto began=ops.clock();
+    ops.requestEnable();
+    unsigned stable=0;
+    for(unsigned i=0;i<maximumPumps;++i) {
+        if(state.cancelled) return false;
+        const auto now=ops.clock();
+        if(now<began || now-began>=timeoutMs) break;
+        state.tapStage="startup-pump";
+        ops.pump();
+        if(state.cancelled) return false;
+        const auto after=ops.clock();
+        if(after<began || after-began>=timeoutMs) break;
+        const bool enabled=ops.enabled();
+        if(state.cancelled) return false;
+        stable=enabled?stable+1:0;
+        if(stable>=2) {state.tapStage="startup-ready";return true;}
+    }
+    state.fail("event-tap-readiness-timeout");return false;
+}
+
+// Apple and fake backends share the snapshot adapter; only the wait operation differs.
+template<class Wait> struct MkbNativePumpOps {
+    MkbCaptureState &state;
+    Wait waitOp;
+    void wait() {waitOp();}
+    const char *permissionFailure() {return state.permissions?state.permissions->failure():"permission-monitor-pending";}
+};
+template<class Wait> auto MkbMakePumpOps(MkbCaptureState &state,Wait wait) {
+    return MkbNativePumpOps<Wait>{state,std::move(wait)};
+}
+
+// The injected operations run at the same boundaries as the Apple backend.
+template<class Ops> inline void MkbActivePump(MkbCaptureState &s,Ops &ops) {
+    using Trace=MkbNativePhaseTrace;
+    Trace::Scope pump(s.phases.get(),Trace::Kind::Pump);
+    {Trace::Scope phase(s.phases.get(),Trace::Kind::Wait);ops.wait();}
+    {Trace::Scope phase(s.phases.get(),Trace::Kind::Seal);s.input.seal();}
+    if(!s.input.running()) s.inputStopped();
+    {
+        Trace::Scope phase(s.phases.get(),Trace::Kind::PermissionSnapshot);
+        if(const auto reason=ops.permissionFailure()) s.fail(reason);
+    }
+}
+template<class Clock> inline void MkbWatchdog(MkbCaptureState &s,Clock clock) {
+    MkbNativePhaseTrace::Scope phase(s.phases.get(),MkbNativePhaseTrace::Kind::Watchdog);
+    if(!s.cancelled && MkbHeartbeatExpired(s.heartbeat,clock)) s.fail("handler-stall-or-sleep");
+}
diff --git a/gui/include/mkbhidreport.h b/gui/include/mkbhidreport.h
new file mode 100644
index 0000000..c82b815
--- /dev/null
+++ b/gui/include/mkbhidreport.h
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+#include <limits>
+
+namespace MkbHidReport {
+constexpr size_t DescriptorLimit=4096, ReportLimit=1024, BufferSize=4096;
+struct Field { unsigned offset=0,bits=0; int64_t minimum=0,maximum=0; bool present=false; };
+struct Layout { unsigned bits=0; bool present=false; Field x,y,button1,button2,button3,button4,button5; };
+struct Descriptor {
+    std::array<Layout,256> reports{};
+    bool numbered=false;
+    unsigned motionId=0;
+    const char *error=nullptr;
+};
+inline int64_t signedValue(uint32_t v,unsigned bits) {
+    return bits && (uint64_t(v)&(uint64_t(1)<<(bits-1))) ? int64_t(v)-(int64_t(1)<<bits) : int64_t(v);
+}
+inline Descriptor parse(const uint8_t *bytes,size_t length) {
+    Descriptor out;
+    const auto fail=[&](const char *why) { out.error=why; return out; };
+    if(!bytes || !length || length>DescriptorLimit) return fail("unsupported-hid-descriptor-size");
+    struct Global { uint32_t page=0,size=0,count=0,id=0; int64_t min=0,max=0; } g;
+    std::vector<Global> globals;
+    std::vector<unsigned> collections;
+    std::vector<uint32_t> usages;
+    uint32_t usageMin=0,usageMax=0; bool haveMin=false,haveMax=false;
+    unsigned mouse=0,mouseCount=0,xyCount=0;
+    std::array<bool,5> buttonsSeen{};
+    auto clearLocal=[&] { usages.clear();haveMin=haveMax=false; };
+    auto usageAt=[&](unsigned i)->uint32_t {
+        if(!usages.empty()) return usages[i<usages.size()?i:usages.size()-1];
+        if(haveMin && haveMax && usageMax>=usageMin) return usageMin+(i<=usageMax-usageMin?i:usageMax-usageMin);
+        return 0;
+    };
+    for(size_t at=0;at<length;) {
+        const auto prefix=bytes[at++]; if(prefix==0xfe) return fail("unsupported-hid-long-item");
+        unsigned size=prefix&3; if(size==3) size=4;
+        if(size>length-at) return fail("truncated-hid-descriptor");
+        uint32_t value=0;for(unsigned i=0;i<size;++i) value|=uint32_t(bytes[at++])<<(8*i);
+        const unsigned type=(prefix>>2)&3, tag=prefix>>4;
+        if(type==1) {
+            switch(tag) {
+            case 0:if(value>65535) return fail("unsupported-hid-usage-page");g.page=value;break;
+            case 1:g.min=signedValue(value,size*8);break;
+            case 2:g.max=g.min<0?signedValue(value,size*8):int64_t(value);break;
+            case 7:g.size=value;break;
+            case 8:if(!value || value>255) return fail("unsupported-hid-report-id");g.id=value;out.numbered=true;break;
+            case 9:g.count=value;break;
+            case 10:if(size || globals.size()>=8) return fail("unsupported-hid-global-stack");globals.push_back(g);break;
+            case 11:if(size || globals.empty()) return fail("unsupported-hid-global-stack");g=globals.back();globals.pop_back();break;
+            default: if(tag>6) return fail("unsupported-hid-global-item"); break;
+            }
+        } else if(type==2) {
+            if(tag==0) { if(usages.size()>=64) return fail("unsupported-hid-usages");usages.push_back(size==4?value:(g.page<<16)|value); }
+            else if(tag==1) {usageMin=size==4?value:(g.page<<16)|value;haveMin=true;}
+            else if(tag==2) {usageMax=size==4?value:(g.page<<16)|value;haveMax=true;}
+            else return fail("unsupported-hid-local-item");
+        } else if(type==0) {
+            if(tag==10) {
+                if(size!=1 || (value==1 && mouse)) return fail("unsupported-hid-collection");
+                if(collections.size()>=16) return fail("unsupported-hid-collection-depth");
+                collections.push_back(mouse);
+                if(value==1 && usageAt(0)==0x10002) { mouse=++mouseCount; }
+                clearLocal(); continue;
+            }
+            if(tag==12) {
+                if(size) return fail("invalid-hid-collection");
+                if(collections.empty()) return fail("invalid-hid-collection");
+                mouse=collections.back();collections.pop_back();clearLocal();continue;
+            }
+            if(tag!=8 && tag!=9 && tag!=11) return fail("unsupported-hid-main-item");
+            if(!g.size || !g.count || g.size>32 || g.count>1024) return fail("unsupported-hid-field-size");
+            if(tag==8) {
+                auto &layout=out.reports[g.id];layout.present=true;
+                const uint64_t total=uint64_t(g.size)*g.count;
+                if(total>ReportLimit*8 || layout.bits>ReportLimit*8-total) return fail("unsupported-hid-report-size");
+                for(unsigned i=0;i<g.count;++i) {
+                    const auto usage=usageAt(i);
+                    if(mouse && (usage>=0x90001 && usage<=0x90005)) {
+                        if(value!=2 || g.min!=0 || g.max!=1)
+                            return fail("unsupported-hid-button-field");
+                        if((haveMin || haveMax) && (!haveMin || !haveMax || !usages.empty()))
+                            return fail("ambiguous-hid-button-usages");
+                        Field *fields[]={&layout.button1,&layout.button2,&layout.button3,&layout.button4,&layout.button5};
+                        auto &field=*fields[usage-0x90001];
+                        if(buttonsSeen[usage-0x90001]) return fail("ambiguous-hid-report-buttons");
+                        buttonsSeen[usage-0x90001]=true;
+                        field={layout.bits+i*g.size,g.size,g.min,g.max,true};
+                    }
+                    if(mouse && (usage==0x10030 || usage==0x10031) && !(value&1)) {
+                        if((value&7)!=6 || g.min>=0 || g.max<=0 || g.min< -(int64_t(1)<<(g.size-1)) || g.max>((int64_t(1)<<(g.size-1))-1))
+                            return fail("unsupported-hid-relative-field");
+                        auto &field=usage==0x10030 ? layout.x : layout.y;
+                        if(field.present || xyCount>=2) return fail("ambiguous-hid-report-axes");
+                        field={layout.bits+i*g.size,g.size,g.min,g.max,true};++xyCount;out.motionId=g.id;
+                    }
+                }
+                layout.bits+=unsigned(total);
+            }
+            clearLocal();
+        } else return fail("unsupported-hid-item-type");
+    }
+    if(!collections.empty() || !globals.empty()) return fail("invalid-hid-descriptor-stack");
+    if(mouseCount!=1 || xyCount!=2) return fail("ambiguous-hid-mouse-collection");
+    auto &motion=out.reports[out.motionId];
+    if(!motion.x.present || !motion.y.present) return fail("split-hid-motion-reports");
+    if(!buttonsSeen[0] || !buttonsSeen[1]) return fail("missing-hid-report-buttons");
+    const Field *fields[]={&motion.button1,&motion.button2,&motion.button3,&motion.button4,&motion.button5};
+    for(unsigned i=0;i<5;++i) if(buttonsSeen[i] && !fields[i]->present) return fail("split-hid-button-reports");
+    if(out.numbered && out.reports[0].present) return fail("mixed-hid-report-ids");
+    for(auto &r:out.reports) if(r.present && ((r.bits+7)/8+(out.numbered?1:0)>ReportLimit)) return fail("unsupported-hid-report-size");
+    return out;
+}
+inline bool hasButton(const Descriptor &descriptor,unsigned index) {
+    if(descriptor.error || index>=5) return false;
+    const auto &layout=descriptor.reports[descriptor.motionId];
+    const Field *fields[]={&layout.button1,&layout.button2,&layout.button3,&layout.button4,&layout.button5};
+    return fields[index]->present;
+}
+struct Value { int64_t x=0,y=0; uint8_t buttons=0; bool motion=false; const char *error=nullptr; };
+inline Value decode(const Descriptor &descriptor,unsigned id,const uint8_t *bytes,size_t length) {
+    Value out;
+    if(descriptor.error) { out.error=descriptor.error;return out; }
+    if(id>255 || !descriptor.reports[id].present) {out.error="unknown-hid-report-id";return out;}
+    const auto &layout=descriptor.reports[id];
+    const size_t prefix=descriptor.numbered?1:0;
+    if(!bytes || length!=(layout.bits+7)/8+prefix || length>ReportLimit) {out.error="invalid-hid-report-length";return out;}
+    if(descriptor.numbered && bytes[0]!=id) {out.error="mismatched-hid-report-id";return out;}
+    if(id!=descriptor.motionId) return out;
+    auto read=[&](const Field &field)->int64_t {
+        uint32_t raw=0;
+        for(unsigned i=0;i<field.bits;++i) {
+            const auto bit=field.offset+i;
+            raw|=uint32_t((bytes[prefix+bit/8]>>(bit%8))&1)<<i;
+        }
+        return field.minimum<0?signedValue(raw,field.bits):int64_t(raw);
+    };
+    const auto x=read(layout.x),y=read(layout.y);
+    if(x<layout.x.minimum || x>layout.x.maximum || y<layout.y.minimum || y>layout.y.maximum) {
+        out.error="invalid-hid-report-value";return out;
+    }
+    const Field *fields[]={&layout.button1,&layout.button2,&layout.button3,&layout.button4,&layout.button5};
+    uint8_t buttons=0;
+    for(unsigned i=0;i<5;++i) if(fields[i]->present) {
+        const auto value=read(*fields[i]);
+        if(value<fields[i]->minimum || value>fields[i]->maximum) {out.error="invalid-hid-report-value";return out;}
+        buttons|=uint8_t(value<<i);
+    }
+    out.x=x;out.y=y;out.buttons=buttons;
+    out.motion=true;return out;
+}
+}
diff --git a/gui/include/mkbcapturecoordinator.h b/gui/include/mkbcapturecoordinator.h
new file mode 100644
index 0000000..48f714b
--- /dev/null
+++ b/gui/include/mkbcapturecoordinator.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "macinputcapture.h"
+
+// The session and offline tests use this same pending/ready/release path.
+class MkbCaptureCoordinator {
+    MkbMapper &mapper;
+    MacInputCapture &capture;
+    std::function<void()> clear;
+    std::function<uint64_t()> clock;
+    bool waiting=false,attempt=false;
+    std::string reason;
+    uint64_t armedAt=0;
+public:
+    MkbCaptureCoordinator(MkbMapper &m,MacInputCapture &c,std::function<void()> reset,
+        std::function<uint64_t()> now=MacInputCapture::now)
+        :mapper(m),capture(c),clear(std::move(reset)),clock(std::move(now)) {}
+    bool engaged() const {return waiting || mapper.active();}
+    bool pending() const {return waiting;}
+    uint64_t activatedAt() const {return armedAt;}
+    const std::string &failure() const {return reason;}
+    bool release(const char *why) {
+        const bool neutral=waiting || mapper.active();
+        const bool was=attempt || engaged();
+        capture.disarm();waiting=false;attempt=false;reason=why;
+        if(was) clear();
+        if(neutral) mapper.release(why);
+        return was;
+    }
+    bool start(bool connected,bool focused,bool blocked) {
+        if(engaged() || !connected || !focused || blocked || !mapper.configuration().valid()) return false;
+        reason.clear();clear();mapper.release("capture-pending");waiting=true;attempt=true;
+        if(!capture.arm()) {const auto why=capture.failure();release(why.c_str());return false;}
+        return true;
+    }
+    bool poll(bool connected,bool focused,bool blocked) {
+        if(!engaged()) return false;
+        if(!connected || !focused || blocked) {release(!connected?"disconnect":!focused?"focus-loss":"menu");return false;}
+        if(!waiting) return true;
+        const auto status=capture.status();
+        if(status.phase==MkbCaptureState::Phase::Failed || status.phase==MkbCaptureState::Phase::Stopping) {
+            release(status.error.empty()?"capture-stopped":status.error.c_str());return false;
+        }
+        if(status.phase!=MkbCaptureState::Phase::Ready) return true;
+        armedAt=clock();
+        if(!mapper.arm(connected,focused,blocked,armedAt)) {release("capture-activation-denied");return false;}
+        if(!capture.activate(mapper.generation(),armedAt)) {
+            const auto why=capture.failure();release(why.c_str());return false;
+        }
+        waiting=false;return true;
+    }
+};

+namespace {
+uint64_t radialDeadline(uint64_t now, uint32_t delay)
+{
+    const auto maximum=std::numeric_limits<uint64_t>::max();
+    return now>maximum-delay?maximum:now+delay;
+}
+bool validRadialConfig(const MkbProfile &p)
+{
+    if(p.radial_menu_open_delay_ms>1500 || !std::isfinite(p.radial_menu_gain) || p.radial_menu_gain<.0001 || p.radial_menu_gain>1 ||
+        (p.radial_menu_enabled && p.radial_menu_actions.empty()) || p.radial_menu_actions.size()>3) return false;
+    for(auto it=p.radial_menu_actions.begin();it!=p.radial_menu_actions.end();++it)
+        if((*it!=MkbMapper::L1 && *it!=MkbMapper::R1 && *it!=MkbMapper::Left) ||
+            std::find(p.radial_menu_actions.begin(),it,*it)!=it) return false;
+    return true;
+}
+bool identicalAimModes(const MkbAimMode &a, const MkbAimMode &b)
+{
+    if(a.gain != b.gain || a.smoothing_ms != b.smoothing_ms)
+        return false;
+    if((!a.x.empty() || !a.y.empty() || !b.x.empty() || !b.y.empty()) && a.cm360 != b.cm360)
+        return false;
+    const auto sameAxis = [](const std::vector<MkbAxisPoint> &x, const std::vector<MkbAxisPoint> &y) {
+        return x.size() == y.size() && std::equal(x.begin(), x.end(), y.begin(),
+            [](const MkbAxisPoint &p, const MkbAxisPoint &q) {
+                return p.speed == q.speed && p.stick == q.stick;
+            });
+    };
+    return sameAxis(a.x, b.x) && sameAxis(a.y, b.y);
+}
+}

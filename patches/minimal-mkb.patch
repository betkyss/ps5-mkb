diff --git a/gui/include/mkbheadsetaudio.h b/gui/include/mkbheadsetaudio.h
new file mode 100644
index 0000000..98bccc2
--- /dev/null
+++ b/gui/include/mkbheadsetaudio.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <QJsonObject>
+#include <QString>
+#include <QVector>
+#include <functional>
+#include <memory>
+#include <cmath>
+
+// Backend methods never resolve a default device. A failed identity check
+// invalidates the command rather than substituting another endpoint.
+struct MkbAudioDevice {
+    QString uid, name;
+    quint32 instanceId=0; // CoreAudio AudioObjectID, never persisted or selected by the client.
+    bool usb=false, alive=false, master=false, writable=false;
+    bool hasMute=false, muteValid=true, muteWritable=false, muted=false;
+    unsigned outputChannels=0;
+    double volume=0;
+    bool operator==(const MkbAudioDevice &b) const {
+        return uid==b.uid && instanceId==b.instanceId && name==b.name && usb==b.usb && alive==b.alive &&
+            master==b.master && writable==b.writable && hasMute==b.hasMute && muteValid==b.muteValid && muteWritable==b.muteWritable &&
+            muted==b.muted && outputChannels==b.outputChannels && volume==b.volume;
+    }
+};
+struct MkbAudioBackend {
+    virtual ~MkbAudioBackend()=default;
+    virtual QVector<MkbAudioDevice> devices()=0;
+    virtual QString volume(const QString &uid,quint32 instanceId,double value)=0;
+    virtual QString mute(const QString &uid,quint32 instanceId,bool value)=0;
+    virtual void listen(std::function<void()> changed)=0;
+
+};
+std::unique_ptr<MkbAudioBackend> MkbCreateCoreAudioBackend();
+
+class MkbHeadsetAudioControl {
+    MkbAudioBackend &backend;
+    QString selected;
+    QString topology;
+    bool pending=false, pendingUnmute=false;
+    QString pendingUid;
+    quint64 pendingGeneration=0;
+    double pendingValue=0;
+    MkbAudioDevice device;
+    QString failure="device-missing";
+    std::function<double(const QString &)> recall;
+    std::function<void(const QString &,double)> remember;
+public:
+    quint64 generation=0;
+    MkbHeadsetAudioControl(MkbAudioBackend &b, QString name,
+        std::function<double(const QString &)> get, std::function<void(const QString &,double)> put)
+        :backend(b),selected(std::move(name)),recall(std::move(get)),remember(std::move(put)) {}
+    bool refresh() {
+        auto all=backend.devices(); QVector<MkbAudioDevice> matches;
+        for(const auto &d:all) if(d.name==selected && d.name.contains("DualSense",Qt::CaseInsensitive) &&
+            d.usb && d.alive && d.outputChannels==4) matches.push_back(d);
+        MkbAudioDevice next; QString error;
+        if(matches.size()!=1) error=matches.isEmpty()?"device-missing":"ambiguous-device";
+        else { next=matches[0]; if(!next.master || !next.writable)error="unsupported-volume-control"; }
+        // Only the selected topology and its ambiguity revoke authorization.
+        int uidMatches=0;
+        for(const auto &d:all)if(!next.uid.isEmpty() && d.uid==next.uid)++uidMatches;
+        if(matches.size()==1 && (next.uid.isEmpty() || uidMatches!=1))error="ambiguous-device";
+        const auto nextTopology=QString("%1|%2|%3|%4|%5|%6").arg(next.uid,next.name)
+            .arg(next.alive).arg(next.usb).arg(next.outputChannels).arg(next.instanceId)+
+            (error=="ambiguous-device"?"|ambiguous":"");
+        if(topology!=nextTopology)++generation;
+        const bool changed=!(device==next) || failure!=error;
+        topology=nextTopology;device=next;failure=error;
+        if(device.master && std::isfinite(device.volume) && device.volume>0 && device.volume<=1)
+            remember(device.uid,device.volume);
+        return changed;
+    }
+    const MkbAudioDevice &selectedDevice() const {return device;}
+    QString error() const {return failure;}
+    QString set(double value, quint64 expectedGeneration) {
+        if(!std::isfinite(value) || value<0 || value>1)return "invalid-volume";
+        if(pending)return "volume-operation-pending";
+        refresh();
+        if(generation!=expectedGeneration)return "device-changed";
+        if(!failure.isEmpty())return failure;
+        const auto uid=device.uid;
+        const auto instance=device.instanceId;
+        const bool unmute=value>0 && device.hasMute && (!device.muteValid || device.muted);
+        if(unmute && !device.muteWritable)return "hardware-mute-read-only";
+        const auto error=backend.volume(uid,instance,value);
+        refresh();
+        if(device.uid!=uid || generation!=expectedGeneration)return "device-changed";
+        if(!error.isEmpty())return error;
+        pending=true;pendingUid=uid;pendingGeneration=expectedGeneration;pendingValue=value;pendingUnmute=unmute;
+        return poll(false);
+    }
+    QString poll(bool expired) {
+        if(!pending)return {};
+        refresh();
+        if(device.uid!=pendingUid || generation!=pendingGeneration) {pending=false;return "device-changed";}
+        const bool scalarConfirmed=device.master && std::isfinite(device.volume) &&
+            (pendingValue==0 ? device.volume==0 : device.volume>0 && std::abs(device.volume-pendingValue)<=.02);
+        if(scalarConfirmed && pendingUnmute) {
+            if(!device.muteWritable) {pending=false;return "hardware-mute-read-only";}
+            const auto error=backend.mute(device.uid,device.instanceId,false);
+            pendingUnmute=false;
+            refresh();
+            if(device.uid!=pendingUid || generation!=pendingGeneration) {pending=false;return "device-changed";}
+            if(!error.isEmpty()) {pending=false;return error;}
+        }
+        const bool confirmed=device.master && std::isfinite(device.volume) &&
+            (pendingValue==0 ? device.volume==0 : device.volume>0 && std::abs(device.volume-pendingValue)<=.02) &&
+            !(pendingValue>0 && device.hasMute && (!device.muteValid || device.muted));
+        if(confirmed) {pending=false;return {};}
+        if(expired) {pending=false;return "volume-readback-unconfirmed";}
+        return "volume-readback-pending";
+    }
+    QString setMuted(bool muted,quint64 expectedGeneration) {
+        refresh();
+        if(generation!=expectedGeneration)return "device-changed";
+        const auto saved=recall(device.uid);
+        return set(muted?0:(saved>0 && saved<=1?saved:.35),expectedGeneration);
+    }
+    QJsonObject snapshot(bool open,double appGain) const {
+        return {{"uid",device.uid},{"deviceGeneration",double(generation)},{"outputName",device.name},
+            {"outputOpen",open},{"osScalar",device.master?QJsonValue(device.volume):QJsonValue()},
+            {"hardwareMute",device.hasMute && device.muteValid?QJsonValue(device.muted):QJsonValue()},
+            {"appGain",appGain},{"appMuted",appGain==0},{"effectiveMuted",!open || !device.master || device.volume==0 || (device.hasMute && (!device.muteValid || device.muted)) || appGain==0},
+            {"supported",failure.isEmpty()},{"error",failure}};
+    }
+};
diff --git a/gui/src/mkbheadsetaudio.mm b/gui/src/mkbheadsetaudio.mm
new file mode 100644
index 0000000..013477b
--- /dev/null
+++ b/gui/src/mkbheadsetaudio.mm
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbheadsetaudio.h"
+#include <CoreAudio/CoreAudio.h>
+#include <QCoreApplication>
+#include <QMetaObject>
+#include <atomic>
+#include <vector>
+#include <Block.h>
+
+namespace {
+AudioObjectPropertyAddress property(AudioObjectPropertySelector selector,
+    AudioObjectPropertyScope scope=kAudioObjectPropertyScopeGlobal) {
+    return {selector,scope,kAudioObjectPropertyElementMain};
+}
+template<class T> bool read(AudioObjectID id, AudioObjectPropertyAddress p,T &value) {
+    UInt32 size=sizeof(value);
+    return AudioObjectGetPropertyData(id,&p,0,nullptr,&size,&value)==noErr && size==sizeof(value);
+}
+QString stringProperty(AudioObjectID id,AudioObjectPropertySelector selector) {
+    CFStringRef value=nullptr;
+    if(!read(id,property(selector),value) || !value)return {};
+    const auto result=QString::fromCFString(value);CFRelease(value);return result;
+}
+unsigned channels(AudioObjectID id,AudioObjectPropertyScope scope) {
+    auto p=property(kAudioDevicePropertyStreamConfiguration,scope);UInt32 size=0;
+    if(AudioObjectGetPropertyDataSize(id,&p,0,nullptr,&size)!=noErr || size<sizeof(AudioBufferList))return 0;
+    std::vector<char> bytes(size);auto *list=reinterpret_cast<AudioBufferList *>(bytes.data());
+    if(AudioObjectGetPropertyData(id,&p,0,nullptr,&size,list)!=noErr)return 0;
+    unsigned count=0;for(UInt32 i=0;i<list->mNumberBuffers;++i)count+=list->mBuffers[i].mNumberChannels;
+    return count;
+}
+bool settable(AudioObjectID id,AudioObjectPropertyAddress p) {
+    Boolean value=false;return AudioObjectIsPropertySettable(id,&p,&value)==noErr && value;
+}
+struct Notification {
+    std::atomic<bool> active{true},queued{false};
+    std::function<void()> refresh;
+};
+class CoreAudioBackend final:public MkbAudioBackend {
+    struct Listener {AudioObjectID id;AudioObjectPropertyAddress address;};
+    QVector<Listener> listeners;
+    std::shared_ptr<Notification> notification=std::make_shared<Notification>();
+    AudioObjectPropertyListenerBlock block=nullptr;
+    QVector<AudioObjectID> ids() {
+        auto p=property(kAudioHardwarePropertyDevices);UInt32 size=0;
+        if(AudioObjectGetPropertyDataSize(kAudioObjectSystemObject,&p,0,nullptr,&size)!=noErr)return {};
+        QVector<AudioObjectID> result(size/sizeof(AudioObjectID));
+        if(AudioObjectGetPropertyData(kAudioObjectSystemObject,&p,0,nullptr,&size,result.data())!=noErr)return {};
+        return result;
+    }
+    void add(AudioObjectID id,AudioObjectPropertyAddress p) {
+        if(!block || !AudioObjectHasProperty(id,&p))return;
+        for(auto l:listeners)if(l.id==id && l.address.mSelector==p.mSelector && l.address.mScope==p.mScope)return;
+        if(AudioObjectAddPropertyListenerBlock(id,&p,dispatch_get_main_queue(),block)==noErr)listeners.push_back({id,p});
+    }
+    QString write(const QString &uid,quint32 instanceId,AudioObjectPropertySelector selector,const void *value,UInt32 size) {
+        AudioObjectID found=0;
+        for(auto id:ids())if(stringProperty(id,kAudioDevicePropertyDeviceUID)==uid) {
+            if(found)return "ambiguous-device";found=id;
+        }
+        if(!found)return "device-missing";
+        if(found!=instanceId)return "device-changed";
+        UInt32 alive=0,transport=0;
+        if(!read(found,property(kAudioDevicePropertyDeviceIsAlive),alive) || !alive ||
+            !read(found,property(kAudioDevicePropertyTransportType),transport) || transport!=kAudioDeviceTransportTypeUSB ||
+            channels(found,kAudioDevicePropertyScopeOutput)!=4)return "device-changed";
+        auto p=property(selector,kAudioDevicePropertyScopeOutput);
+        if(!settable(found,p))return "unsupported-volume-control";
+        if(found!=instanceId || stringProperty(found,kAudioDevicePropertyDeviceUID)!=uid)return "device-changed";
+        return AudioObjectSetPropertyData(found,&p,0,nullptr,size,value)==noErr?QString():QString("coreaudio-write-failed");
+    }
+public:
+    ~CoreAudioBackend() override {
+        notification->active=false;
+        for(auto l:listeners)AudioObjectRemovePropertyListenerBlock(l.id,&l.address,dispatch_get_main_queue(),block);
+        if(block)Block_release(block);
+    }
+    void listen(std::function<void()> callback) override {
+        notification->refresh=std::move(callback);auto state=notification;
+        block=Block_copy(^(UInt32,const AudioObjectPropertyAddress *) {
+            if(!state->active || state->queued.exchange(true))return;
+            QMetaObject::invokeMethod(QCoreApplication::instance(),[state] {
+                state->queued=false;if(state->active)state->refresh();
+            },Qt::QueuedConnection);
+        });
+        add(kAudioObjectSystemObject,property(kAudioHardwarePropertyDevices));
+    }
+    QVector<MkbAudioDevice> devices() override {
+        QVector<MkbAudioDevice> result;
+        for(auto id:ids()) {
+            MkbAudioDevice d;d.instanceId=id;d.uid=stringProperty(id,kAudioDevicePropertyDeviceUID);
+            d.name=stringProperty(id,kAudioObjectPropertyName);
+            UInt32 alive=0,transport=0;
+            read(id,property(kAudioDevicePropertyDeviceIsAlive),alive);d.alive=alive;
+            read(id,property(kAudioDevicePropertyTransportType),transport);d.usb=transport==kAudioDeviceTransportTypeUSB;
+            if(!d.usb || !d.name.contains("DualSense",Qt::CaseInsensitive))continue;
+            d.outputChannels=channels(id,kAudioDevicePropertyScopeOutput);
+            auto v=property(kAudioDevicePropertyVolumeScalar,kAudioDevicePropertyScopeOutput);
+            Float32 volume=0;d.master=read(id,v,volume) && std::isfinite(volume) && volume>=0 && volume<=1;
+            d.volume=volume;d.writable=d.master && settable(id,v);
+            auto m=property(kAudioDevicePropertyMute,kAudioDevicePropertyScopeOutput);UInt32 mute=0;
+            d.hasMute=AudioObjectHasProperty(id,&m);d.muteValid=!d.hasMute || read(id,m,mute);
+            d.muted=mute;d.muteWritable=d.hasMute && settable(id,m);
+            add(id,v);add(id,m);add(id,property(kAudioDevicePropertyDeviceIsAlive));
+            result.push_back(d);
+        }
+        return result;
+    }
+    QString volume(const QString &uid,quint32 instanceId,double value) override {Float32 scalar=value;return write(uid,instanceId,kAudioDevicePropertyVolumeScalar,&scalar,sizeof(scalar));}
+    QString mute(const QString &uid,quint32 instanceId,bool value) override {UInt32 muted=value;return write(uid,instanceId,kAudioDevicePropertyMute,&muted,sizeof(muted));}
+};
+}
+std::unique_ptr<MkbAudioBackend> MkbCreateCoreAudioBackend() {return std::make_unique<CoreAudioBackend>();}
diff --git a/gui/include/mkbcameraprobe.h b/gui/include/mkbcameraprobe.h
new file mode 100644
index 0000000..26a85dd
--- /dev/null
+++ b/gui/include/mkbcameraprobe.h
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <chiaki/controller.h>
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <cstring>
+
+// Только worker владеет состоянием. Ввод не накапливается в очередь.
+class MkbCameraProbe {
+public:
+    enum class Phase:uint64_t { Off, Ready, Pending, Pulse, Settling, Failed };
+    enum class Mode { Disabled, Enabled, Invalid };
+    static Mode mode(const char *value,bool worker) {
+        if(!value || !std::strcmp(value,"0"))return Mode::Disabled;
+        return !std::strcmp(value,"1")&&worker?Mode::Enabled:Mode::Invalid;
+    }
+    static bool allowNormalInput(Mode mode){return mode==Mode::Disabled;}
+    using Clock=std::function<uint64_t()>;
+    using Sink=std::function<bool(const ChiakiControllerState &,const char *)>;
+    struct Snapshot {
+        Phase phase=Phase::Off;
+        uint64_t axis=0,value=0,durationMs=200,trial=0,beginNs=0,neutralNs=0,deadlineNs=0;
+        uint64_t session=0,capture=0,sampleNs=0;
+        uint64_t trialAxis=0,trialValue=0,trialDurationMs=0;
+    };
+private:
+    inline static constexpr std::array<uint64_t,10> levels{{0,128,256,512,768,1024,1536,2048,3072,4096}};
+    inline static constexpr std::array<uint64_t,4> durations{{8,16,50,200}};
+    Snapshot view;
+    size_t level=0,duration=3;
+    uint64_t pendingAt=0,readyAt=0,readySince=0;
+    std::array<bool,6> held{};
+    static int keyIndex(int source) {
+        switch(source){case 49:return 0;case 123:return 1;case 124:return 2;case 125:return 3;case 126:return 4;case 48:return 5;default:return -1;}
+    }
+public:
+    Snapshot snapshot()const{return view;}
+    void arm(uint64_t now){held.fill(false);view.phase=now<readyAt?Phase::Settling:Phase::Ready;readySince=now;view.deadlineNs=now<readyAt?readyAt:0;}
+    void stop(uint64_t now){
+        if(view.phase==Phase::Pulse || view.phase==Phase::Failed)readyAt=now+500000000;
+        held.fill(false);view.phase=Phase::Off;view.deadlineNs=0;
+    }
+    void key(int source,bool down,bool repeat,uint64_t now) {
+        const int i=keyIndex(source);if(i<0)return;
+        if(!down){held[i]=false;return;}
+        if(repeat || held[i])return;
+        held[i]=true;
+        if(view.phase!=Phase::Ready || now<readySince)return;
+        if(source==49){view.phase=Phase::Pending;pendingAt=now;return;}
+        if(source==124 && level+1<levels.size())++level;
+        if(source==123 && level)--level;
+        if(source==126)view.axis=(view.axis+1)%4;
+        if(source==125)view.axis=(view.axis+3)%4;
+        if(source==48)duration=(duration+1)%durations.size();
+        view.value=levels[level];view.durationMs=durations[duration];
+    }
+    bool service(const Clock &clock,const Sink &send) {
+        auto now=clock();
+        if(view.phase==Phase::Pending) {
+            if(now<pendingAt || now-pendingAt>100000000){view.phase=Phase::Ready;return true;}
+            ChiakiControllerState s;chiaki_controller_state_set_idle(&s);
+            const int16_t v=int16_t(view.value);
+            if(view.axis<2)s.right_x=view.axis==0?v:-v;else s.right_y=view.axis==2?v:-v;
+            ++view.trial;view.beginNs=now;view.neutralNs=0;
+            view.trialAxis=view.axis;view.trialValue=view.value;view.trialDurationMs=view.durationMs;
+            view.deadlineNs=now+view.durationMs*1000000;
+            if(!send(s,"probe-pulse")){view.phase=Phase::Failed;return false;}
+            view.phase=Phase::Pulse;now=clock();
+        }
+        if(view.phase==Phase::Pulse && now<view.beginNs){view.phase=Phase::Failed;return false;}
+        if(view.phase==Phase::Pulse && now>=view.deadlineNs) {
+            ChiakiControllerState idle;chiaki_controller_state_set_idle(&idle);
+            if(!send(idle,"probe-neutral")){view.phase=Phase::Failed;return false;}
+            view.neutralNs=clock();readyAt=view.neutralNs+500000000;view.deadlineNs=readyAt;
+            view.phase=Phase::Settling;
+        }
+        if(view.phase==Phase::Settling && now>=readyAt){view.phase=Phase::Ready;readySince=readyAt;view.deadlineNs=0;}
+        return true;
+    }
+};
diff --git a/gui/include/mkboutputpolicy.h b/gui/include/mkboutputpolicy.h
new file mode 100644
index 0000000..667b08f
--- /dev/null
+++ b/gui/include/mkboutputpolicy.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <chiaki/takion.h>
+#include <cstddef>
+#include <cstdint>
+
+// Immutable for a session. Never consult the environment in the input path.
+struct MkbOutputPolicy
+{
+    bool headset = false;
+    ChiakiDisableAudioVideo audioVideo;
+    static MkbOutputPolicy select(ChiakiDisableAudioVideo saved, bool noAv, bool headset)
+    {
+        return {headset, noAv ? CHIAKI_AUDIO_VIDEO_DISABLED : headset ? CHIAKI_VIDEO_DISABLED : saved};
+    }
+    bool feedbackAllowed() const { return !headset; }
+    template<class Controller> void clearPriorEffects(Controller &controller) const
+    {
+        if(!headset) return;
+        uint8_t clear[10] = {};
+        controller.SetRumble(0, 0);
+        controller.SetHapticRumble(0, 0);
+        controller.SetTriggerEffects(0x05, clear, 0x05, clear);
+    }
+};
+
+// Explicit quad PCM avoids SDL's stereo-to-surround duplication into motors.
+inline void MkbHeadsetPcm(const int16_t *stereo, int16_t *quad, size_t frames)
+{
+    for(size_t i = 0; i < frames; ++i) {
+        quad[4*i] = stereo[2*i];
+        quad[4*i+1] = stereo[2*i+1];
+        quad[4*i+2] = quad[4*i+3] = 0;
+    }
+}

+        if(viewRevision && next==previousView)return;
+        previousView=next;next[7]=++viewRevision;next[8]=MkbNativePhaseTrace::now();publication.publish(next);
+    }
+    struct PublishOnExit {MkbSubmissionGate &gate;~PublishOnExit(){gate.publishView();}};

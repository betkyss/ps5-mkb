diff --git a/gui/src/mkbprofilejson.cpp b/gui/src/mkbprofilejson.cpp
new file mode 100644
index 0000000..c863662
--- /dev/null
+++ b/gui/src/mkbprofilejson.cpp
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbmapper.h"
+#include <QFile>
+#include <QCryptographicHash>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QSet>
+#include <cmath>
+#include <algorithm>
+#include <stdexcept>
+namespace {
+void require(bool ok, const char *message) { if(!ok) throw std::runtime_error(message); }
+// QJsonDocument accepts duplicate object keys. Check the original token stream as well.
+class UniqueKeys {
+    const QByteArray &s; int pos=0;
+    void ws() { while(pos<s.size() && (s[pos]==' ' || s[pos]=='\n' || s[pos]=='\r' || s[pos]=='\t')) ++pos; }
+    QString string() {
+        int start=pos++; while(pos<s.size()) {
+            char c=s[pos++]; if(c=='\\') ++pos; else if(c=='"') break;
+        }
+        return QJsonDocument::fromJson("["+s.mid(start,pos-start)+"]").array()[0].toString();
+    }
+    void value() {
+        ws(); char c=s[pos];
+        if(c=='{') {
+            ++pos; ws(); QSet<QString> keys;
+            if(s[pos]=='}') { ++pos; return; }
+            for(;;) {
+                ws(); auto key=string(); require(!keys.contains(key),"Повторяющийся JSON ключ"); keys.insert(key);
+                ws(); ++pos; value(); ws(); if(s[pos++]=='}') break;
+            }
+        } else if(c=='[') {
+            ++pos; ws(); if(s[pos]==']') { ++pos; return; }
+            for(;;) { value(); ws(); if(s[pos++]==']') break; }
+        } else if(c=='"') string();
+        else while(pos<s.size() && s[pos]!=',' && s[pos]!=']' && s[pos]!='}') ++pos;
+    }
+public:
+    explicit UniqueKeys(const QByteArray &bytes):s(bytes) { value(); }
+};
+void fields(const QJsonObject &o, const QStringList &allowed, const QStringList &optional = {}) {
+    for(auto i=o.begin(); i!=o.end(); ++i) require(allowed.contains(i.key()) || optional.contains(i.key()),"Неизвестное поле профиля");
+    for(auto &k:allowed) require(o.contains(k),"Неполный профиль");
+}
+double number(const QJsonValue &v,double min,double max) {
+    require(v.isDouble(),"Ожидалось число"); double n=v.toDouble();
+    require(std::isfinite(n) && n>=min && n<=max,"Число вне диапазона"); return n;
+}
+std::vector<MkbAxisPoint> table(const QJsonValue &v) {
+    require(v.isArray(),"Таблица должна быть массивом"); std::vector<MkbAxisPoint> out;
+    for(auto entry:v.toArray()) {
+        require(entry.isArray() && entry.toArray().size()==2,"Точка должна содержать speed и stick");
+        auto pair=entry.toArray(); double speed=number(pair[0],0,1000000), stick=number(pair[1],0,1);
+        if(out.empty()) require(speed==0,"Таблица должна начинаться с [0,threshold]");
+        else require(speed>out.back().speed && stick>out.back().stick,"Таблица должна строго возрастать");
+        out.push_back({speed,stick});
+    }
+    require(out.empty() || out.size()>=2,"Неполная таблица"); return out;
+}
+MkbAimMode mode(const QJsonValue &v) {
+    require(v.isObject(),"Режим должен быть объектом"); auto o=v.toObject();
+    fields(o,{"gain","smoothing_ms","cm360","x","y"}); MkbAimMode m;
+    m.gain=number(o["gain"],0.000001,1); m.smoothing_ms=number(o["smoothing_ms"],0,1000);
+    m.cm360=number(o["cm360"],0,10000); m.x=table(o["x"]); m.y=table(o["y"]);
+    require(m.x.empty()==m.y.empty(),"Нужны обе таблицы осей");
+    require(m.x.empty() || m.cm360>0,"Для таблиц нужен cm360"); return m;
+}
+}
+MkbProfile MkbProfile::load(const std::string &path)
+{
+    QFile file(QString::fromStdString(path));
+    if(!file.open(QIODevice::ReadOnly) || file.size()>1024*1024) {
+        MkbProfile p; p.error="Не удалось прочитать профиль или превышен размер"; return p;
+    }
+    return fromBytes(file.readAll().toStdString());
+}
+MkbProfile MkbProfile::fromBytes(const std::string &input)
+{
+    MkbProfile p;
+    p.digest=QCryptographicHash::hash(QByteArray::fromStdString(input),QCryptographicHash::Sha256).toHex().toStdString();
+    try {
+        require(input.size()<=1024*1024,"Профиль слишком велик");
+        auto bytes=QByteArray::fromStdString(input);
+        if(bytes.startsWith(QByteArray::fromHex("efbbbf"))) bytes.remove(0,3);
+        QJsonParseError error;
+        auto doc=QJsonDocument::fromJson(bytes,&error);
+        require(error.error==QJsonParseError::NoError && doc.isObject(),"Некорректный JSON профиль");
+        // Limit nesting before the duplicate-key scan to bound recursion on untrusted input.
+        int depth=0; bool quoted=false, escaped=false;
+        for(char c:bytes) {
+            if(quoted) { if(escaped) escaped=false; else if(c=='\\') escaped=true; else if(c=='"') quoted=false; }
+            else if(c=='"') quoted=true;
+            else if(c=='{' || c=='[') { ++depth; require(depth<=16,"Слишком глубокий JSON"); }
+            else if(c=='}' || c==']') --depth;
+        }
+        UniqueKeys unique(bytes); auto o=doc.object(); fields(o,{"version","name","dpi","binds","hip","ads"},{"radial_deadzone","calibration","recoil","rapid_fire","radial_menu"});
+        if(o.contains("radial_menu")) {
+            require(o["radial_menu"].isObject(),"Круговые меню должны быть объектом");
+            const auto menu=o["radial_menu"].toObject();
+            fields(menu,{"enabled","gain","open_actions"},{"open_delay_ms"});
+            if(menu.contains("open_delay_ms")) {
+                const double delay=number(menu["open_delay_ms"],0,1500);
+                require(std::floor(delay)==delay,"Задержка открытия должна быть целым числом");
+                p.radial_menu_open_delay_ms=uint32_t(delay);
+            }
+            require(menu["enabled"].isBool(),"Включение круговых меню должно быть boolean");
+            p.radial_menu_enabled=menu["enabled"].toBool();
+            p.radial_menu_gain=number(menu["gain"],.0001,1);
+            require(menu["open_actions"].isArray(),"Нужен список действий круговых меню");
+            for(const auto &value:menu["open_actions"].toArray()) {
+                require(value.isString(),"Действие меню должно быть строкой");
+                const auto action=value.toString();
+                const int key=action=="L1"?MkbMapper::L1:action=="R1"?MkbMapper::R1:action=="Left"?MkbMapper::Left:-1;
+                require(key>=0 && std::find(p.radial_menu_actions.begin(),p.radial_menu_actions.end(),key)==p.radial_menu_actions.end(),"Неизвестное или повторное действие меню");
+                p.radial_menu_actions.push_back(key);
+            }
+            require(!p.radial_menu_enabled || !p.radial_menu_actions.empty(),"Выберите хотя бы одно круговое меню");
+        }
+        if(o.contains("radial_deadzone")) p.radial_deadzone=number(o["radial_deadzone"],0,0.99);
+        if(o.contains("rapid_fire")) {
+            require(o["rapid_fire"].isObject(),"Автотап должен быть объектом");
+            const auto rapid=o["rapid_fire"].toObject();
+            fields(rapid,{"enabled","interval_ms","press_ms"},{});
+            require(rapid["enabled"].isBool(),"Автотап enabled должен быть boolean");
+            p.rapid_fire_enabled=rapid["enabled"].toBool();
+            const double interval=number(rapid["interval_ms"],64,1000);
+            const double press=number(rapid["press_ms"],16,496);
+            require(std::floor(interval)==interval && std::fmod(interval,8)==0 &&
+                std::floor(press)==press && std::fmod(press,8)==0 && press<interval,
+                "Автотап: длительности должны быть кратны 8, нажатие короче интервала");
+            p.rapid_fire_interval_ms=uint32_t(interval);p.rapid_fire_press_ms=uint32_t(press);
+        }
+        if(o.contains("recoil")) {
+            require(o["recoil"].isObject(),"Recoil должен быть объектом");
+            const auto recoil=o["recoil"].toObject();
+            fields(recoil,{"vertical"},{"enabled","mode","pulse_peak","period_ms"});
+            p.recoil_vertical=number(recoil["vertical"],0,.25);
+            if(recoil.contains("mode")) {
+                require(recoil["mode"].isString(),"Recoil mode должен быть строкой");
+                const auto mode=recoil["mode"].toString();
+                require(mode=="constant" || mode=="pulse","Неизвестный режим компенсации");
+                p.recoil_pulse=mode=="pulse";
+            }
+            if(recoil.contains("pulse_peak"))p.recoil_pulse_peak=number(recoil["pulse_peak"],.001,.25);
+            if(recoil.contains("period_ms")) {
+                const double period=number(recoil["period_ms"],32,496);
+                require(std::floor(period)==period && std::fmod(period,8)==0,"Recoil period_ms должен быть кратен 8");
+                p.recoil_period_ms=uint32_t(period);
+            }
+            if(recoil.contains("enabled")) {
+                require(recoil["enabled"].isBool(),"Recoil enabled должен быть boolean");
+                p.recoil_enabled=recoil["enabled"].toBool();
+            }
+        }
+        if(o.contains("calibration")) {
+            require(o["calibration"].isObject(),"Calibration должен быть объектом");
+            const std::map<QString,int> bounds={{"game_version",128},{"settings",2048},{"fov",128},
+                {"optic",128},{"date",64},{"notes",2048}};
+            auto metadata=o["calibration"].toObject();
+            for(auto i=metadata.begin(); i!=metadata.end(); ++i) {
+                auto bound=bounds.find(i.key());
+                require(bound!=bounds.end(),"Неизвестное поле calibration");
+                require(i.value().isString() && i.value().toString().size()<=bound->second,"Некорректное поле calibration");
+                p.calibration[i.key().toStdString()]=i.value().toString().toStdString();
+            }
+        }
+        require(number(o["version"],1,1)==1,"Неизвестная версия");
+        require(o["name"].isString() && !o["name"].toString().trimmed().isEmpty() && o["name"].toString().size()<=120,"Нужно имя профиля");
+        p.name=o["name"].toString().toStdString(); p.dpi=number(o["dpi"],0,1000000);
+        p.hip=mode(o["hip"]); p.ads=mode(o["ads"]);
+        require((p.hip.x.empty() && p.ads.x.empty()) || p.dpi>0,"Для таблиц нужен DPI");
+        require(o["binds"].isObject(),"Binds должен быть объектом");
+        const std::map<QString,int> actions={{"W",MkbMapper::W},{"A",MkbMapper::A},{"S",MkbMapper::S},{"D",MkbMapper::D},
+            {"Cross",MkbMapper::Cross},{"Box",MkbMapper::Box},{"Pyramid",MkbMapper::Pyramid},{"Moon",MkbMapper::Moon},
+            {"L3",MkbMapper::L3},{"R3",MkbMapper::R3},{"L1",MkbMapper::L1},{"R1",MkbMapper::R1},
+            {"Up",MkbMapper::Up},{"Down",MkbMapper::Down},{"Left",MkbMapper::Left},{"Right",MkbMapper::Right},
+            {"L2",MkbMapper::L2},{"R2",MkbMapper::R2},{"Options",MkbMapper::Options},{"Share",MkbMapper::Share},
+            {"PS",MkbMapper::PS},{"Touchpad",MkbMapper::Touchpad},
+            {"LookUp",MkbMapper::LookUp},{"LookDown",MkbMapper::LookDown},
+            {"LookLeft",MkbMapper::LookLeft},{"LookRight",MkbMapper::LookRight},
+            {"RecoilToggle",MkbMapper::RecoilToggle},{"RecoilDecrease",MkbMapper::RecoilDecrease},
+            {"RecoilIncrease",MkbMapper::RecoilIncrease},{"RapidFireToggle",MkbMapper::RapidFireToggle},
+            {"HoldLeft",MkbMapper::HoldLeft},{"HoldRight",MkbMapper::HoldRight},{"DodgeRoll",MkbMapper::DodgeRoll}};
+        auto binds=o["binds"].toObject();
+        for(auto i=binds.begin(); i!=binds.end(); ++i) {
+            // Canonical numeric identities prevent aliases such as 01 and 1.
+            bool ok=false; int source=i.key().toInt(&ok);
+            require(ok && QString::number(source)==i.key(),"Некорректный источник ввода");
+            require((source>=0 && source<=127) || (source>=256 && source<=287),"Источник вне диапазона");
+            require(source!=63,"Fn не поддерживается");
+            require(source!=53 && source!=46 && source!=58 && source!=61 && source!=59 && source!=62,
+                "Esc, M и модификаторы системного аккорда зарезервированы");
+            require(i.value().isString(),"Action должен быть строкой"); auto action=actions.find(i.value().toString());
+            require(action!=actions.end(),"Неизвестный action");
+            require(source!=57 || action->second==MkbMapper::DodgeRoll,"Caps Lock поддерживает только Перекат");
+            p.binds.emplace(source,action->second);
+        }
+    } catch(const std::exception &e) { p.error=e.what(); p.binds.clear(); }
+    return p;
+}
+
+std::string MkbJsonError(const std::string &input)
+{
+    try {
+        require(!input.empty() && input.size()<=131072,"Некорректный размер JSON");
+        require(input.compare(0,3,"\xef\xbb\xbf")!=0,"JSON BOM запрещён");
+        const auto bytes=QByteArray::fromStdString(input);QJsonParseError error;
+        const auto doc=QJsonDocument::fromJson(bytes,&error);
+        require(error.error==QJsonParseError::NoError && doc.isObject(),"Некорректный JSON");
+        int depth=0;bool quoted=false,escaped=false;
+        for(char c:bytes) {
+            if(quoted){if(escaped)escaped=false;else if(c=='\\')escaped=true;else if(c=='"')quoted=false;}
+            else if(c=='"')quoted=true;
+            else if(c=='{' || c=='['){++depth;require(depth<=16,"Слишком глубокий JSON");}
+            else if(c=='}' || c==']')--depth;
+        }
+        UniqueKeys unique(bytes);return {};
+    } catch(const std::exception &e){return e.what();}
+}

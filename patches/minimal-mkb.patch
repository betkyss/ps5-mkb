+// Shared by the session owner and offline window-boundary tests.
+inline bool ReleaseMkbCapture(MkbMapper *mapper, const std::function<void()> &disarm,
+    const std::function<void()> &clearLegacy, const char *reason)
+{
+    disarm();
+    if(!mapper || !mapper->active()) return false;
+    clearLegacy(); mapper->release(reason); return true;
+}

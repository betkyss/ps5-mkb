+// All notice snapshots refer to the originating attempt, not GUI dispatch time.
+class MkbSessionGate
+{
+public:
+    struct QuitNotice { uint64_t generation; bool wasConnected; bool retryEligible; };
+    uint64_t start() {
+        std::lock_guard<std::mutex> lock(mutex);
+        live=false; accepting=true; stopped=false; had_connected=false; return ++epoch;
+    }
+    void stop() {
+        std::lock_guard<std::mutex> lock(mutex);
+        accepting=false; live=false; stopped=true; ++epoch;
+    }
+    uint64_t generation() const { std::lock_guard<std::mutex> lock(mutex); return epoch; }
+    uint64_t observeConnected() {
+        std::lock_guard<std::mutex> lock(mutex);
+        if(accepting) had_connected=true;
+        return epoch;
+    }
+    bool connected(uint64_t notice) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if(!accepting || notice != epoch) return false;
+        live=true; had_connected=true; return true;
+    }
+    QuitNotice quit() {
+        std::lock_guard<std::mutex> lock(mutex);
+        QuitNotice notice{epoch,had_connected,accepting && !stopped && !had_connected};
+        accepting=false; live=false;
+        return notice;
+    }
+    bool canRetry(const QuitNotice &notice) const {
+        std::lock_guard<std::mutex> lock(mutex);
+        return notice.generation==epoch && notice.retryEligible && !stopped;
+    }
+    bool shouldHandleQuit(const QuitNotice &notice) const {
+        std::lock_guard<std::mutex> lock(mutex);
+        return notice.generation==epoch || stopped;
+    }
+    bool isCurrent(uint64_t notice) const {
+        std::lock_guard<std::mutex> lock(mutex); return notice==epoch && !stopped;
+    }
+    bool ready() const { std::lock_guard<std::mutex> lock(mutex); return live && accepting; }
+    ChiakiControllerState stateForSubmit(ChiakiControllerState state, bool blocked) const {
+        if(blocked || !ready()) chiaki_controller_state_set_idle(&state);
+        return state;
+    }
+private:
+    mutable std::mutex mutex;
+    bool accepting=false, live=false, stopped=true, had_connected=false;
+    uint64_t epoch=0;
+};

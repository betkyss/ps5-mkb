+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbcapturelifecycle.h"
+#include <ApplicationServices/ApplicationServices.h>
+#include <IOKit/hid/IOHIDManager.h>
+#include <mach/mach_time.h>
+#include <atomic>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <string>
+#include <condition_variable>
+
+// No session or QObject is accessed by the native thread.
+class MacInputCapture
+{
+public:
+    // GUI-thread shortcut tap, active only for the foreground app, including capture-off.
+    static void *installLocalToggle(std::function<bool()> toggle);
+    static void removeLocalToggle(void *token);
+    using Event = MkbEventQueue::Event;
+    struct Translation {
+        Event event;
+        bool mapped=false, pass=false;
+        const char *release=nullptr;
+    };
+    static Translation translate(CGEventType type, CGEventRef event, uint64_t generation, const MkbProfile &profile = MkbProfile::defaults(), MkbMouseInput::Source source = MkbMouseInput::Source::CG);
+    Translation translateEvent(CGEventType type, CGEventRef event, uint64_t epoch) const {
+        return translate(type,event,epoch,profile,state ? state->config.source : MkbMouseInput::Source::CG);
+    }
+    struct MonitorOps {
+        void (*match)(IOHIDManagerRef,CFDictionaryRef)=IOHIDManagerSetDeviceMatching;
+        void (*install)(IOHIDManagerRef,IOHIDDeviceCallback,void *)=IOHIDManagerRegisterDeviceRemovalCallback;
+        void (*schedule)(IOHIDManagerRef,CFRunLoopRef,CFStringRef)=IOHIDManagerScheduleWithRunLoop;
+    };
+    static void setupMonitor(IOHIDManagerRef manager,MkbCaptureState &state,const MonitorOps &ops) {
+        ops.match(manager,nullptr); // All HID devices, including keyboards in HID mouse mode.
+        ops.install(manager,&MacInputCapture::removed,&state);
+        ops.schedule(manager,CFRunLoopGetCurrent(),kCFRunLoopDefaultMode);
+    }
+    struct TapLeaseOps {
+        bool (*enabled)(CFMachPortRef)=CGEventTapIsEnabled;
+        void (*invalidate)(CFMachPortRef)=CFMachPortInvalidate;
+        void (*release)(CFTypeRef)=CFRelease;
+    };
+    // Adopts the +1 tap/source references and retains the callback context.
+    static std::shared_ptr<MkbTapLease> ownTap(CFMachPortRef,CFRunLoopSourceRef,std::shared_ptr<MkbCaptureState>,const TapLeaseOps &);
+    static void tapDisabled(MkbCaptureState &,CGEventType,bool enabled);
+    static void reportReceived(void *,IOReturn,void *,IOHIDReportType,uint32_t,uint8_t *,CFIndex,uint64_t);
+    using ReportInstall = void (*)(IOHIDDeviceRef,uint8_t *,CFIndex,IOHIDReportWithTimeStampCallback,void *);
+    struct ReportRegistration {
+        IOHIDDeviceRef device=nullptr;
+        uint8_t *buffer=nullptr;
+        CFIndex length=0;
+        void *context=nullptr;
+    };
+    static ReportRegistration registerReports(IOHIDDeviceRef device,MkbCaptureState &state,
+        ReportInstall install=IOHIDDeviceRegisterInputReportWithTimeStampCallback) {
+        ReportRegistration registration{device,state.reportBuffer.data(),CFIndex(state.reportBuffer.size()),&state};
+        install(registration.device,registration.buffer,registration.length,&MacInputCapture::reportReceived,registration.context);
+        return registration;
+    }
+    static void unregisterReports(ReportRegistration &registration,
+        ReportInstall install=IOHIDDeviceRegisterInputReportWithTimeStampCallback) {
+        if(!registration.context) return;
+        // Apple removes the entry matching the original context, not a null context.
+        install(registration.device,registration.buffer,registration.length,nullptr,registration.context);
+        registration={};
+    }
+    static void deliverReport(MkbCaptureState &,IOReturn,IOHIDReportType,uint32_t,
+        const uint8_t *,CFIndex,uint64_t timestamp,uint64_t received);
+    using BackendFactory = std::function<std::unique_ptr<MkbNativeBackend>()>;
+    struct Status { MkbCaptureState::Phase phase; std::string error; };
+    explicit MacInputCapture(BackendFactory factory = {});
+    MacInputCapture(const MacInputCapture &) = delete;
+    MacInputCapture &operator=(const MacInputCapture &) = delete;
+    void setProfile(const MkbProfile &value) { profile = value; }
+    bool liveProfile(const MkbProfile &value);
+    ~MacInputCapture();
+    void setPhaseTrace(std::shared_ptr<MkbNativePhaseTrace> value) { phases=std::move(value); }
+    void setPermissionTrace(std::shared_ptr<MkbNativePhaseTrace> value) { permissionPhases=std::move(value); }
+    void setFailureHook(std::function<void(const char *)> hook) {failureHook=std::move(hook);}
+    void setLifecycle(std::shared_ptr<MkbCaptureLifecycle> value,MkbCaptureToken token={}) {
+        lifecycle=std::move(value);attemptToken=token;
+        lifecycle->reserve(token,requestedConfig(),state?state->lifecycle:nullptr);
+    }
+    bool arm();
+    bool activate(uint64_t generation, uint64_t at);
+    void disarm();
+    Status status();
+    MkbMouseInput::Config requestedConfig() const {
+        return state?state->config:MkbMouseInput::parse(std::getenv("CHIAKI_MKB_MOUSE_SOURCE"),std::getenv("CHIAKI_MKB_HID_VID"),std::getenv("CHIAKI_MKB_HID_PID"),std::getenv("CHIAKI_MKB_HID_LOCATION"));
+    }
+    MkbSelectedDevice selectedDevice() const {return lifecycle->snapshot().selected;}
+    bool cleanupFinished() const {return !state || state->finished.load();}
+    MkbPermissionSnapshot::Value permissionSnapshot() const {return lifecycle->snapshot().permissions;}
+    std::string failure() const;
+    bool drain(std::deque<Event> &events, std::string &failure);
+    static uint64_t now();
+    static uint64_t nowNs();
+    struct HidReader {
+        IOHIDElementRef (*element)(IOHIDValueRef) = IOHIDValueGetElement;
+        CFIndex (*length)(IOHIDValueRef) = IOHIDValueGetLength;
+        IOHIDElementCookie (*cookie)(IOHIDElementRef) = IOHIDElementGetCookie;
+        CFIndex (*integer)(IOHIDValueRef) = IOHIDValueGetIntegerValue;
+        uint64_t (*timestamp)(IOHIDValueRef) = IOHIDValueGetTimeStamp;
+    };
+    struct DescriptorReader {
+        IOHIDElementType (*type)(IOHIDElementRef) = IOHIDElementGetType;
+        Boolean (*relative)(IOHIDElementRef) = IOHIDElementIsRelative;
+        uint32_t (*page)(IOHIDElementRef) = IOHIDElementGetUsagePage;
+        uint32_t (*usage)(IOHIDElementRef) = IOHIDElementGetUsage;
+        uint32_t (*count)(IOHIDElementRef) = IOHIDElementGetReportCount;
+        uint32_t (*size)(IOHIDElementRef) = IOHIDElementGetReportSize;
+        IOHIDElementRef (*parent)(IOHIDElementRef) = IOHIDElementGetParent;
+        IOHIDElementCollectionType (*collection)(IOHIDElementRef) = IOHIDElementGetCollectionType;
+        IOHIDElementCookie (*cookie)(IOHIDElementRef) = IOHIDElementGetCookie;
+    };
+    static MkbMouseInput::Sample readHid(IOHIDValueRef value, IOReturn result, uint64_t epoch, uint64_t received);
+    static MkbMouseInput::Sample readHid(IOHIDValueRef value, IOReturn result, uint64_t epoch, uint64_t received, const HidReader &reader);
+    static bool describeAxis(IOHIDElementRef element, MkbMouseInput::Axis &axis, const DescriptorReader &reader);
+    static void removed(void *, IOReturn, void *, IOHIDDeviceRef);
+private:
+    std::shared_ptr<MkbCaptureState> state;
+    std::shared_ptr<MkbCaptureLifecycle> lifecycle=std::make_shared<MkbCaptureLifecycle>();
+    MkbCaptureToken attemptToken;
+    BackendFactory factory;
+    std::function<void(const char *)> failureHook;
+    std::shared_ptr<MkbNativePhaseTrace> phases,permissionPhases;
+    MkbProfile profile=MkbProfile::defaults();
+    std::string lastError;
+    static void run(std::shared_ptr<MkbCaptureState> state, BackendFactory factory);
+};
diff --git a/gui/src/macinputcapture.mm b/gui/src/macinputcapture.mm
new file mode 100644
index 0000000..6a596ca
--- /dev/null
+++ b/gui/src/macinputcapture.mm
@@ -0,0 +1,629 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "macinputcapture.h"
+#import <AppKit/AppKit.h>
+#include <ApplicationServices/ApplicationServices.h>
+#include <IOKit/hid/IOHIDManager.h>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <IOKit/hid/IOHIDLib.h>
+#include <IOKit/hid/IOHIDKeys.h>
+#include <IOKit/hid/IOHIDDeviceKeys.h>
+#include <IOKit/hidsystem/IOLLEvent.h>
+#include <IOKit/hidsystem/IOHIDLib.h>
+
+namespace {
+struct MkbToggleShortcut {
+    std::function<bool()> toggle;
+    CFMachPortRef tap=nullptr;
+    CFRunLoopSourceRef source=nullptr;
+    bool escapeHeld=false;
+};
+CGEventRef toggleShortcutEvent(CGEventTapProxy,CGEventType type,CGEventRef event,void *context)
+{
+    auto &s=*static_cast<MkbToggleShortcut *>(context);
+    if(type==kCGEventTapDisabledByTimeout || type==kCGEventTapDisabledByUserInput) {
+        CGEventTapEnable(s.tap,true);return event;
+    }
+    if(!event || CGEventGetIntegerValueField(event,kCGKeyboardEventKeycode)!=53)return event;
+    if(type==kCGEventKeyUp && s.escapeHeld) {s.escapeHeld=false;return nullptr;}
+    const auto flags=CGEventGetFlags(event)&(kCGEventFlagMaskCommand|kCGEventFlagMaskControl|kCGEventFlagMaskAlternate|kCGEventFlagMaskShift);
+    if(type!=kCGEventKeyDown || flags!=kCGEventFlagMaskCommand)return event;
+    if([NSWorkspace sharedWorkspace].frontmostApplication.processIdentifier!=getpid())return event;
+    if(CGEventGetIntegerValueField(event,kCGKeyboardEventAutorepeat))return s.escapeHeld?nullptr:event;
+    if(!s.toggle())return event;
+    s.escapeHeld=true;return nullptr;
+}
+}
+void *MacInputCapture::installLocalToggle(std::function<bool()> toggle)
+{
+    auto s=std::make_unique<MkbToggleShortcut>();s->toggle=std::move(toggle);
+    s->tap=CGEventTapCreate(kCGSessionEventTap,kCGHeadInsertEventTap,kCGEventTapOptionDefault,
+        CGEventMaskBit(kCGEventKeyDown)|CGEventMaskBit(kCGEventKeyUp),toggleShortcutEvent,s.get());
+    if(!s->tap)return nullptr;
+    s->source=CFMachPortCreateRunLoopSource(kCFAllocatorDefault,s->tap,0);
+    if(!s->source){CFRelease(s->tap);return nullptr;}
+    CFRunLoopAddSource(CFRunLoopGetMain(),s->source,kCFRunLoopCommonModes);
+    CGEventTapEnable(s->tap,true);return s.release();
+}
+void MacInputCapture::removeLocalToggle(void *token)
+{
+    if(!token)return;
+    std::unique_ptr<MkbToggleShortcut> s(static_cast<MkbToggleShortcut *>(token));
+    CGEventTapEnable(s->tap,false);CFMachPortInvalidate(s->tap);
+    CFRunLoopRemoveSource(CFRunLoopGetMain(),s->source,kCFRunLoopCommonModes);
+    CFRelease(s->source);CFRelease(s->tap);
+}
+
+uint64_t MacInputCapture::now()
+{
+    mach_timebase_info_data_t base{};
+    if(mach_timebase_info(&base)!=KERN_SUCCESS || !base.denom) return 0;
+    return uint64_t(__uint128_t(mach_absolute_time())*base.numer/base.denom/1000000);
+}
+uint64_t MacInputCapture::nowNs()
+{
+    mach_timebase_info_data_t base{};
+    if(mach_timebase_info(&base)!=KERN_SUCCESS || !base.numer || !base.denom) return 0;
+    const __uint128_t ns=__uint128_t(mach_absolute_time())*base.numer/base.denom;
+    return ns<=UINT64_MAX ? uint64_t(ns) : 0;
+}
+MacInputCapture::Translation MacInputCapture::translate(CGEventType type, CGEventRef event, uint64_t generation, const MkbProfile &profile, MkbMouseInput::Source source)
+{
+    Translation result;
+    if(!event) { result.release="invalid-cg-event"; return result; }
+    bool mappedCommand=false;
+    auto &out=result.event;
+    out={generation,CGEventGetTimestamp(event)/1000000,-1,false,0,0};
+    if(type == kCGEventKeyDown || type == kCGEventKeyUp || type == kCGEventFlagsChanged)
+    {
+        int code = int(CGEventGetIntegerValueField(event, kCGKeyboardEventKeycode));
+        if(code == 53) {
+            const auto modifiers=CGEventGetFlags(event) & (kCGEventFlagMaskCommand|kCGEventFlagMaskControl|kCGEventFlagMaskAlternate|kCGEventFlagMaskShift);
+            if(type==kCGEventKeyDown && !CGEventGetIntegerValueField(event,kCGKeyboardEventAutorepeat))
+                result.release=modifiers==kCGEventFlagMaskCommand?"toggle":"escape";
+            // Suppress both edges: an Esc release arriving after activation
+            // must not immediately revoke the new capture.
+            return result;
+        }
+        // Shift releases must be delivered even while a system modifier is held.
+        if(type == kCGEventFlagsChanged && (code == 56 || code == 60)) {
+            out.source = code;
+            out.down = bool(CGEventGetFlags(event) & (code == 56 ? NX_DEVICELSHIFTKEYMASK : NX_DEVICERSHIFTKEYMASK));
+            auto binding=profile.binds.find(code);
+            if(binding!=profile.binds.end()) out.key=binding->second;
+            result.mapped=out.key>=0; result.pass=true; return result;
+        }
+        const auto flags=CGEventGetFlags(event);
+        mappedCommand=MkbMappedCommand(profile,flags);
+        if(type==kCGEventFlagsChanged && (code==54 || code==55 || code==57)) {
+            out.source=code;
+            out.down=code==57 || bool(flags & (code==54?NX_DEVICERCMDKEYMASK:NX_DEVICELCMDKEYMASK));
+            // Control combinations stay with the system. Still deliver a
+            // Command release so an earlier manual hold cannot remain stuck.
+            if((flags & kCGEventFlagMaskControl) && out.down) {
+                out.source=-1; result.pass=true; return result;
+            }
+            const auto binding=profile.binds.find(code);
+            if(binding!=profile.binds.end()) out.key=binding->second;
+            result.mapped=out.key>=0;
+            result.pass=(flags & kCGEventFlagMaskControl) || !result.mapped;
+            return result;
+        }
+        if((flags & kCGEventFlagMaskControl) || ((flags & kCGEventFlagMaskCommand) && !mappedCommand)) {
+            if(type==kCGEventKeyDown) {
+                result.release="system-shortcut"; result.pass=true; return result;
+            }
+            if(type==kCGEventFlagsChanged) { result.pass=true; return result; }
+        }
+        out.down = type == kCGEventKeyDown;
+        out.repeat = out.down && CGEventGetIntegerValueField(event,kCGKeyboardEventAutorepeat);
+        out.source = code;
+        if(type == kCGEventFlagsChanged) {
+            if(code == 56) out.down = bool(CGEventGetFlags(event) & NX_DEVICELSHIFTKEYMASK);
+            else if(code == 60) out.down = bool(CGEventGetFlags(event) & NX_DEVICERSHIFTKEYMASK);
+            else { result.pass = true; return result; }
+        }
+    }
+    else if(type == kCGEventLeftMouseDown || type == kCGEventLeftMouseUp ||
+            type == kCGEventRightMouseDown || type == kCGEventRightMouseUp ||
+            type == kCGEventOtherMouseDown || type == kCGEventOtherMouseUp)
+    {
+        if(source==MkbMouseInput::Source::HID) return result; // Suppress; report snapshot owns mouse buttons.
+        out.source = 256 + int(CGEventGetIntegerValueField(event,kCGMouseEventButtonNumber));
+        out.down = type == kCGEventLeftMouseDown || type == kCGEventRightMouseDown || type == kCGEventOtherMouseDown;
+    }
+    else if(type == kCGEventMouseMoved || type == kCGEventLeftMouseDragged || type == kCGEventRightMouseDragged || type == kCGEventOtherMouseDragged)
+    {
+        if(source==MkbMouseInput::Source::HID) return result; // Подавлять CG, не подавать его движение повторно.
+        out.dx=CGEventGetIntegerValueField(event,kCGMouseEventDeltaX);
+        out.dy=CGEventGetIntegerValueField(event,kCGMouseEventDeltaY);
+    }
+    auto binding = profile.binds.find(out.source);
+    if(binding != profile.binds.end()) out.key = binding->second;
+    result.mapped=out.key>=0 || out.dx || out.dy;
+    result.pass=type==kCGEventFlagsChanged ||
+        ((type==kCGEventKeyDown || type==kCGEventKeyUp) && out.key<0 && !mappedCommand);
+    return result;
+}
+
+namespace {
+bool hidNumber(IOHIDDeviceRef device, CFStringRef key, uint32_t &result)
+{
+    auto value=IOHIDDeviceGetProperty(device,key);
+    int64_t number=0;
+    if(!value || CFGetTypeID(value)!=CFNumberGetTypeID() ||
+        !CFNumberGetValue(static_cast<CFNumberRef>(value),kCFNumberSInt64Type,&number) || number<0 || number>UINT32_MAX) return false;
+    result=uint32_t(number); return true;
+}
+MkbMouseInput::Device describe(IOHIDDeviceRef device)
+{
+    MkbMouseInput::Device result;
+    result.identifiers=hidNumber(device,CFSTR(kIOHIDVendorIDKey),result.vid) &&
+        hidNumber(device,CFSTR(kIOHIDProductIDKey),result.pid);
+    result.hasLocation=hidNumber(device,CFSTR(kIOHIDLocationIDKey),result.location);
+    auto elements=IOHIDDeviceCopyMatchingElements(device,nullptr,kIOHIDOptionsTypeNone);
+    if(!elements) return result;
+    for(CFIndex i=0; i<CFArrayGetCount(elements); ++i) {
+        auto element=static_cast<IOHIDElementRef>(const_cast<void *>(CFArrayGetValueAtIndex(elements,i)));
+        MkbMouseInput::Axis axis;
+        if(MacInputCapture::describeAxis(element,axis,{})) result.axes.push_back(axis);
+    }
+    CFRelease(elements); return result;
+}
+CFDictionaryRef mouseMatch()
+{
+    int page=1, usage=2;
+    auto p=CFNumberCreate(nullptr,kCFNumberIntType,&page);
+    auto u=CFNumberCreate(nullptr,kCFNumberIntType,&usage);
+    const void *keys[]={CFSTR(kIOHIDDeviceUsagePageKey),CFSTR(kIOHIDDeviceUsageKey)};
+    const void *values[]={p,u};
+    auto result=CFDictionaryCreate(nullptr,keys,values,2,&kCFTypeDictionaryKeyCallBacks,&kCFTypeDictionaryValueCallBacks);
+    CFRelease(p); CFRelease(u); return result;
+}
+bool listenAllowed() { return IOHIDCheckAccess(kIOHIDRequestTypeListenEvent)==kIOHIDAccessTypeGranted; }
+}
+
+bool MacInputCapture::describeAxis(IOHIDElementRef element, MkbMouseInput::Axis &axis, const DescriptorReader &r)
+{
+    if(!element || (r.type(element)!=kIOHIDElementTypeInput_Misc && r.type(element)!=kIOHIDElementTypeInput_Axis) ||
+        !r.relative(element) || r.page(element)!=1 || (r.usage(element)!=0x30 && r.usage(element)!=0x31) ||
+        r.count(element)!=1 || !r.size(element) || r.size(element)>64) return false;
+    unsigned depth=0;
+    for(auto parent=r.parent(element); parent && depth++<128; parent=r.parent(parent)) {
+        if(r.type(parent)==kIOHIDElementTypeCollection && r.collection(parent)==kIOHIDElementCollectionTypeApplication &&
+            r.page(parent)==1 && r.usage(parent)==2) {
+            axis={uint64_t(r.cookie(element)),uint64_t(reinterpret_cast<uintptr_t>(parent)),r.usage(element)};
+            return true;
+        }
+    }
+    return false;
+}
+MkbMouseInput::Sample MacInputCapture::readHid(IOHIDValueRef value, IOReturn result, uint64_t epoch, uint64_t received)
+{ return readHid(value,result,epoch,received,HidReader{}); }
+MkbMouseInput::Sample MacInputCapture::readHid(IOHIDValueRef value, IOReturn result, uint64_t epoch, uint64_t received, const HidReader &reader)
+{
+    MkbMouseInput::Sample sample; sample.generation=epoch; sample.received=received;
+    if(result!=kIOReturnSuccess) { sample.error=result==kIOReturnOverrun ? "hid-overrun" : "hid-callback-error"; return sample; }
+    if(!value) { sample.error="invalid-hid-value"; return sample; }
+    auto element=reader.element(value);
+    const auto length=reader.length(value);
+    if(!element || length<=0 || length>8) { sample.error="invalid-hid-value"; return sample; }
+    sample.cookie=uint64_t(reader.cookie(element)); sample.delta=reader.integer(value); sample.timestamp=reader.timestamp(value);
+    return sample;
+}
+void MacInputCapture::deliverReport(MkbCaptureState &s,IOReturn result,IOHIDReportType type,uint32_t id,
+    const uint8_t *bytes,CFIndex length,uint64_t timestamp,uint64_t received)
+{
+    if(s.cancelled || !s.input.running()) return;
+    if(result!=kIOReturnSuccess) {std::fprintf(stderr,"MKB report callback error=0x%x\n",unsigned(result));s.fail("hid-report-callback-error");return;}
+    if(type!=kIOHIDReportTypeInput) {s.fail("invalid-hid-report-type");return;}
+    if(length<=0 || uint64_t(length)>MkbHidReport::ReportLimit) {s.fail("invalid-hid-report-length");return;}
+    if(!timestamp) {s.fail("hid-report-timestamp-unavailable");return;}
+    const auto decoded=[&] {
+        MkbNativePhaseTrace::Scope phase(s.phases.get(),MkbNativePhaseTrace::Kind::Decode);
+        return MkbHidReport::decode(s.descriptor,id,bytes,size_t(length));
+    }();
+    if(decoded.error) {s.fail(decoded.error);return;}
+    if(!decoded.motion) return;
+    const auto translated=[&] {
+        MkbNativePhaseTrace::Scope phase(s.phases.get(),MkbNativePhaseTrace::Kind::Publish);
+        return s.input.report(decoded.x,decoded.y,timestamp,received,s.generation,decoded.buttons);
+    }();
+    if(translated.error) s.fail(translated.error);
+    else if(!s.input.running()) s.inputStopped();
+}
+void MacInputCapture::reportReceived(void *context,IOReturn result,void *,IOHIDReportType type,uint32_t id,uint8_t *bytes,CFIndex length,uint64_t timestamp)
+{
+    const uint64_t received=mach_absolute_time(); // Entry, до decode/очереди/GUI.
+    auto &state=*static_cast<MkbCaptureState *>(context);
+    MkbNativePhaseTrace::Scope phase(state.phases.get(),MkbNativePhaseTrace::Kind::Callback);
+    try { MacInputCapture::deliverReport(state,result,type,id,bytes,length,timestamp,received); }
+    catch(...) { state.fail("hid-report-exception"); }
+}
+void MacInputCapture::removed(void *context, IOReturn, void *, IOHIDDeviceRef)
+{ static_cast<MkbCaptureState *>(context)->fail("device-unplug"); }
+namespace {
+const char *phaseName(MkbCaptureState::Phase phase) {
+    switch(phase) {
+    case MkbCaptureState::Phase::Pending:return "pending";
+    case MkbCaptureState::Phase::Ready:return "ready";
+    case MkbCaptureState::Phase::Active:return "active";
+    case MkbCaptureState::Phase::Stopping:return "stopping";
+    case MkbCaptureState::Phase::Failed:return "failed";
+    default:return "idle";
+    }
+}
+void tapDiagnostic(MkbCaptureState &s,const char *kind,uint64_t eventType,bool enabled) {
+    MkbCaptureState::Phase phase;
+    {std::lock_guard<std::mutex> lock(s.control);phase=s.phase;}
+    std::fprintf(stderr,"MKB tap kind=%s event_type=0x%llx enabled=%d phase=%s stage=%s\n",
+        kind,static_cast<unsigned long long>(eventType),int(enabled),phaseName(phase),s.tapStage.load());
+}
+bool checkTap(MkbCaptureState &s,CFMachPortRef tap,const char *reason,
+    bool (*query)(CFMachPortRef)=CGEventTapIsEnabled) {
+    const bool enabled=query(tap);
+    if(!enabled) {tapDiagnostic(s,"enabled-check",0,enabled);s.fail(reason);}
+    return enabled;
+}
+}
+std::shared_ptr<MkbTapLease> MacInputCapture::ownTap(CFMachPortRef tap,CFRunLoopSourceRef source,
+    std::shared_ptr<MkbCaptureState> state,const TapLeaseOps &ops) {
+    return std::make_shared<MkbTapLease>([tap,ops] {return ops.enabled(tap);},
+        [tap,source,state=std::move(state),ops] {
+            (void)state; // Retain callback context through invalidation and both releases.
+            ops.invalidate(tap);
+            ops.release(source);
+            ops.release(tap);
+        });
+}
+void MacInputCapture::tapDisabled(MkbCaptureState &s,CGEventType type,bool enabled) {
+    tapDiagnostic(s,"disabled-callback",uint64_t(type),enabled);
+    s.fail(type==kCGEventTapDisabledByTimeout?"event-tap-disabled-callback-timeout":"event-tap-disabled-callback-user-input");
+}
+namespace {
+std::atomic<bool> nativeBusy{false};
+CGEventRef cgCallback(CGEventTapProxy, CGEventType type, CGEventRef event, void *context)
+{
+    auto &s=*static_cast<MkbCaptureState *>(context);
+    MkbNativePhaseTrace::Scope phase(s.phases.get(),MkbNativePhaseTrace::Kind::CgCallback);
+    try {
+        if(s.cancelled) return event;
+        if(type==kCGEventTapDisabledByTimeout || type==kCGEventTapDisabledByUserInput) {
+            MacInputCapture::tapDisabled(s,type,false);return event;
+        }
+        if(!s.input.running()) return event;
+        MacInputCapture::Translation t;
+        {std::lock_guard<std::mutex> lock(s.profileMutex);
+            t=MacInputCapture::translate(type,event,s.generation,s.profile,s.config.source);}
+        // Observe unmapped keys too, so a live binding knows what is held.
+        if(t.event.source>=0 && t.pass && !t.release)t.mapped=true;
+        if(t.release) s.fail(t.release);
+        else if(t.mapped) {
+            s.input.push(t.event,false,CGEventGetTimestamp(event));
+            if(!s.input.running()) s.inputStopped();
+        }
+        return t.pass ? event : nullptr;
+    } catch(...) { s.fail("cg-callback-exception"); return event; }
+}
+struct TapPlatform {
+    MacInputCapture::TapLeaseOps lease;
+    std::function<CFMachPortRef(CGEventMask,void *)> create=[](CGEventMask mask,void *context) {
+        return CGEventTapCreate(kCGSessionEventTap,kCGHeadInsertEventTap,kCGEventTapOptionDefault,mask,cgCallback,context);
+    };
+    std::function<CFRunLoopSourceRef(CFMachPortRef)> source=[](CFMachPortRef tap) {return CFMachPortCreateRunLoopSource(nullptr,tap,0);};
+    std::function<void(CFRunLoopSourceRef)> add=[](CFRunLoopSourceRef source) {CFRunLoopAddSource(CFRunLoopGetCurrent(),source,kCFRunLoopDefaultMode);};
+    std::function<void(CFRunLoopSourceRef)> remove=[](CFRunLoopSourceRef source) {CFRunLoopRemoveSource(CFRunLoopGetCurrent(),source,kCFRunLoopDefaultMode);};
+    std::function<void(CFMachPortRef,bool)> enable=CGEventTapEnable;
+    std::function<CGError(bool)> associate=CGAssociateMouseAndMouseCursorPosition;
+    std::function<CGError()> hide=[] {return CGDisplayHideCursor(kCGDirectMainDisplay);};
+    std::function<CGError()> show=[] {return CGDisplayShowCursor(kCGDirectMainDisplay);};
+    std::function<void()> pump=[] {CFRunLoopRunInMode(kCFRunLoopDefaultMode,0.002,false);};
+    std::function<uint64_t()> now=MacInputCapture::now;
+};
+class AppleBackend final : public MkbNativeBackend {
+    TapPlatform tapOps;
+    CFMachPortRef tap=nullptr;
+    CFRunLoopSourceRef source=nullptr;
+    IOHIDManagerRef manager=nullptr, monitor=nullptr;
+    IOHIDDeviceRef device=nullptr;
+    bool hidden=false, detached=false, opened=false, scheduled=false, monitored=false;
+    MacInputCapture::ReportRegistration reportRegistration;

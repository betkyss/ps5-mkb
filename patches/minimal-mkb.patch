@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbstatuspublication.h"
+#include <chiaki/feedbacksender.h>
+
+// Единственный writer: init, затем sender, затем fini после join. Reader
+// копирует фиксированные atomic words; остановленный reader не держит writer.
+class MkbFeedbackHealth {
+    MkbStatusPublication<12> publication;
+    MkbStatusPublication<12>::Words state{};
+public:
+    using Words=MkbStatusPublication<12>::Words;
+    void lifecycle(uint64_t generation,bool active) {
+        if(active)state={};
+        state[0]=generation;state[1]=active;publication.publish(state);
+    }
+    void observe(const ChiakiFeedbackSendRecord &r) {
+        if(!state[1] || state[0]!=r.generation)return;
+        state[2]=r.end_us;state[3]=uint64_t(r.result);++state[5];
+        if(r.result==CHIAKI_ERR_SUCCESS){state[4]=r.end_us;++state[6];}else ++state[7];
+        state[8]=r.revision;state[9]=r.retry_count;state[10]=r.retry_due_us;state[11]=r.degraded;
+        publication.publish(state);
+    }
+    bool read(Words &out)const{return publication.read(out);}
+};
diff --git a/gui/include/mkbstatuspublication.h b/gui/include/mkbstatuspublication.h
new file mode 100644
index 0000000..f991c2f
--- /dev/null
+++ b/gui/include/mkbstatuspublication.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+
+// One writer, or writers serialized by their existing control ownership.
+// Every shared byte is atomic. Equal even versions in the seq_cst total order
+// prove that the copied words belong to one publication. A suspended reader
+// owns no slot/lock and cannot delay the writer. Exhaustion fails closed.
+template<size_t N> class MkbStatusPublication {
+    static_assert(std::atomic<uint64_t>::is_always_lock_free,"status words must be lock-free");
+    std::atomic<uint64_t> version{0};
+    std::array<std::atomic<uint64_t>,N> words{};
+public:
+    using Words=std::array<uint64_t,N>;
+    void publish(const Words &value) {
+        const auto before=version.load();
+        if(before>=UINT64_MAX-2){version.store(UINT64_MAX);return;}
+        version.store(before+1);
+        for(size_t i=0;i<N;++i)words[i].store(value[i]);
+        version.store(before+2);
+    }
+    template<class Observer> bool read(Words &value,Observer observe) const {
+        for(unsigned attempt=0;attempt<3;++attempt) {
+            const auto before=version.load();
+            if(!before || (before&1))continue;
+            Words candidate{};
+            for(size_t i=0;i<N;++i){candidate[i]=words[i].load();observe(i);}
+            if(before==version.load()){value=candidate;return true;}
+        }
+        return false;
+    }
+    bool read(Words &value) const {return read(value,[](size_t){});}
+};
diff --git a/gui/include/mkbtargetwindow.h b/gui/include/mkbtargetwindow.h
new file mode 100644
index 0000000..80b4923
--- /dev/null
+++ b/gui/include/mkbtargetwindow.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <QGuiApplication>
+#include <QPointer>
+#include <QWindow>
+
+// GUI lifetime привязан к единственному окну, владеющему session.
+class MkbTargetWindow {
+    QPointer<QWindow> owner;
+public:
+    QWindow *window() const {return owner.data();}
+    void bind(QWindow *value) {owner=value;}
+    bool focused() const {return owner && owner->isVisible() && QGuiApplication::focusWindow()==owner.data();}
+    void requestFocus() const {if(owner && owner->isVisible())owner->requestActivate();}
+};
diff --git a/gui/include/mkbdashboardcontroller.h b/gui/include/mkbdashboardcontroller.h
new file mode 100644
index 0000000..cdf5642
--- /dev/null
+++ b/gui/include/mkbdashboardcontroller.h
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbprofile.h"
+#include <QJsonObject>
+#include <QString>
+#include <functional>
+#include <memory>
+#include <limits>
+
+// GUI-thread transaction. Ports expose physical state, never duplicate orchestration.
+class MkbDashboardController {
+public:
+    using Operation = uint64_t;
+    struct Ops {
+        std::function<QJsonObject()> read;
+        std::function<QString()> digest;
+        std::function<void()> clearLegacy,requestFocus;
+        std::function<uint64_t(uint64_t)> cancelQueue;
+        std::function<bool()> focused;
+        std::function<QString()> arm,release;
+        std::function<bool(std::shared_ptr<const MkbProfile>,uint64_t)> queue;
+        std::function<void(const MkbProfile &)> commit;
+        std::function<bool(std::shared_ptr<const MkbProfile>,uint64_t,uint64_t,uint64_t)> queueLive;
+    };
+private:
+    bool busy_=false,queued=false,armed=false;
+    uint64_t revision=0,generation=0,captureGeneration=0,runtimeRevision=0;
+    Operation sequence=0,current=0;
+    uint64_t epoch_=0;
+    QString command,captureState;
+    std::shared_ptr<const MkbProfile> candidate;
+    Ops ops;
+    void finish() {ops.clearLegacy();candidate.reset();queued=false;busy_=false;}
+public:
+    bool busy() const {return busy_;}
+    uint64_t epoch() const {return epoch_;}
+    bool owns(Operation operation) const {return busy_ && operation && operation==current;}
+    bool acceptLegacy(const std::function<void()> &clear) const {
+        if(!busy_)return true;
+        clear();return false;
+    }
+    QJsonObject status(const Ops &ports) const {
+        auto s=ports.read();s["busy"]=busy_;s["digest"]=ports.digest();
+        s["controlEpoch"]=double(epoch_);s["operationId"]=QString::number(current);
+        s["canApply"]=s["running"].toBool() && s["connected"].toBool() && s["healthy"].toBool() && !busy_;
+        return s;
+    }
+    QString begin(const QString &requestedCommand,const QByteArray &bytes,Ops ports,Operation &operation,uint64_t expectedEpoch=UINT64_MAX,uint64_t expectedRuntime=UINT64_MAX) {
+        operation=0;
+        if(requestedCommand=="release") {
+            cancelCurrent();ports.clearLegacy();
+            // Revoke even if disconnected/unhealthy. No successful cleanup proof
+            // is returned unless the healthy guards below also pass.
+            if(const auto error=ports.release();!error.isEmpty())return error;
+        }
+        else if(expectedEpoch!=UINT64_MAX && expectedEpoch!=epoch_)return "Control epoch изменился";
+        if(busy_)return "Предыдущая операция ещё выполняется";
+        const auto &command=requestedCommand;
+        if(sequence==std::numeric_limits<Operation>::max())return "Operation identity exhausted";
+        const auto s=ports.read();
+        if(!s["running"].toBool())return "Нужен HID worker новой сборки";
+        if(command=="apply" || command=="live") {
+            auto p=MkbProfile::fromBytes(bytes.toStdString());
+            if(!p.valid())return QString::fromStdString(p.error);
+            if(auto e=p.compatibilityError(true);!e.empty())return QString::fromStdString(e);
+            candidate=std::make_shared<const MkbProfile>(std::move(p));
+        } else if(command!="arm" && command!="release")return "Неизвестная команда";
+        if(!s["connected"].toBool() || !s["healthy"].toBool()){candidate.reset();return "Сессия отключена или ошибка отправки";}
+        if(command=="arm" && s["engaged"].toBool()){candidate.reset();return "Захват уже включён или освобождается";}
+        if(command=="live" && s["capture"]!="active" && s["capture"]!="off")return "Захват меняет состояние";
+        captureState=s["capture"].toString();
+        captureGeneration=uint64_t(s["captureGeneration"].toDouble());
+        runtimeRevision=uint64_t(s["recoil"].toObject()["runtimeRevision"].toDouble());
+        if(command=="live" && s["capture"]=="active" && expectedRuntime!=runtimeRevision)return "Runtime изменился";
+        this->command=requestedCommand;operation=current=++sequence;
+        ops=std::move(ports);generation=uint64_t(s["sessionGeneration"].toDouble());
+        if(epoch_>=9007199254740990ULL)return "Control epoch exhausted";
+        ++epoch_;busy_=true;queued=armed=false;ops.clearLegacy();
+        if(command=="arm")ops.requestFocus();
+        else if(command=="apply")if(const auto error=ops.release();!error.isEmpty()){cancel(operation);return error;}
+        return {};
+    }
+    QString poll(Operation operation,bool &done) {
+        done=false;
+        if(!owns(operation)){done=true;return "Операция отменена или заменена";}
+        auto s=ops.read();
+        // A concurrent tick can make the combined passive snapshot unknown.
+        // Wait for a coherent sample; this never acknowledges an operation.
+        if(command=="live" && s["capture"]=="unknown" && s["running"].toBool() && s["connected"].toBool() &&
+           uint64_t(s["sessionGeneration"].toDouble())==generation &&
+           uint64_t(s["captureGeneration"].toDouble())==captureGeneration)return {};
+        if(!s["running"].toBool() || !s["connected"].toBool() || !s["healthy"].toBool() || uint64_t(s["sessionGeneration"].toDouble())!=generation) {
+            cancel(operation);done=true;return "Сессия сменилась, отключена или ошибка neutral";
+        }
+        if(command=="live") {
+            if(uint64_t(s["captureGeneration"].toDouble())!=captureGeneration ||
+               (s["capture"]!=captureState)) {cancel(operation);done=true;return "Захват изменился";}
+            if(!queued) {
+                revision=std::max(revision,uint64_t(s["workerRevision"].toDouble()))+1;
+                if(!ops.queueLive || !ops.queueLive(candidate,revision,captureGeneration,runtimeRevision)) {
+                    cancel(operation);done=true;return "Worker отклонил live профиль";
+                }
+                queued=true;
+            } else if(uint64_t(s["discardedRevision"].toDouble())==revision) {
+                cancel(operation);done=true;return "Runtime изменился или binding недоступен";
+            } else if(uint64_t(s["workerRevision"].toDouble())==revision) {
+                ops.commit(*candidate);finish();done=true;return {};
+            }
+        } else if(command=="arm") {
+            if(armed && !ops.focused()) {cancel(operation);done=true;return "Окно сессии потеряло фокус до подтверждения захвата";}
+            if(!armed && ops.focused()) {
+                const auto error=ops.arm();armed=true;
+                if(!error.isEmpty()){cancel(operation);done=true;return error;}
+            }
+            s=ops.read();
+            if(s["capture"]=="active"){
+                if(!armed || !ops.focused()){cancel(operation);done=true;return "Фокус окна сессии не подтверждён";}
+                finish();done=true;return {};
+            }
+            if(armed && !s["engaged"].toBool()){const auto error=s["reason"].toString();cancel(operation);done=true;return error.isEmpty()?QString("Захват не подтверждён"):error;}
+        } else if(!s["engaged"].toBool() && s["cleanupFinished"].toBool() && s["capture"]=="off") {
+            if(command=="release"){finish();done=true;return {};}
+            if(!queued) {
+                ++revision;
+                if(!ops.queue(candidate,revision)){cancel(operation);done=true;return "Worker отклонил профиль";}
+                queued=true;
+            } else if(uint64_t(s["workerRevision"].toDouble())==revision) {
+                ops.commit(*candidate);finish();done=true;return {};
+            }
+        }
+        return {};
+    }
+    void cancelCurrent() {if(busy_)cancel(current);else if(epoch_<9007199254740990ULL)++epoch_;}
+    void cancel(Operation operation) {
+        if(!owns(operation))return;
+        if(epoch_<9007199254740990ULL)++epoch_;
+        const auto accepted=ops.cancelQueue(queued?revision:0);
+        if(queued && candidate && accepted==revision)
+            ops.commit(*candidate);
+        ops.clearLegacy();if(command!="live")ops.release();finish();
+    }
+};
diff --git a/gui/include/mkbdashboard.h b/gui/include/mkbdashboard.h
new file mode 100644
index 0000000..918de3a
--- /dev/null
+++ b/gui/include/mkbdashboard.h
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include <QObject>
+#include <QJsonObject>
+#include "mkbcapturelifecycle.h"
+class StreamSession;
+// Опциональный приватный IPC. Все обращения к session идут в GUI thread.
+class MkbDashboard : public QObject {
+public:
+    explicit MkbDashboard(QObject *parent=nullptr);
+    static void attach(StreamSession *session);
+    inline static QJsonObject retiringIdentity;
+    inline static std::shared_ptr<MkbCaptureLifecycle> retiringLifecycle;
+    static void retire(const QJsonObject &identity,std::shared_ptr<MkbCaptureLifecycle> lifecycle) {
+        if(retiringLifecycle && !retiringLifecycle->snapshot().cleanup)return;
+        retiringIdentity=identity;retiringLifecycle=std::move(lifecycle);
+    }
+};
diff --git a/gui/src/mkbdashboard.cpp b/gui/src/mkbdashboard.cpp
new file mode 100644
index 0000000..922d5db
--- /dev/null
+++ b/gui/src/mkbdashboard.cpp
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbdashboard.h"
+#include "streamsession.h"
+#include <QLocalServer>
+#include <QLocalSocket>
+#include <QPointer>
+#include <QJsonDocument>
+#include <QJsonArray>
+#include <QTimer>
+#include <QElapsedTimer>
+#include <QDir>
+#include <QFileInfo>
+#include <QCoreApplication>
+#include <QFile>
+#include <QCryptographicHash>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <deque>
+#include <cmath>
+namespace {
+QPointer<StreamSession> current;
+QString controlOperationId;
+const QString processId=QUuid::createUuid().toString(QUuid::WithoutBraces);
+const QString launchNonce=qEnvironmentVariable("CHIAKI_MKB_LAUNCH_NONCE");
+QString binaryDigest;
+QJsonObject status() {
+    auto s=current?current->DashboardStatus():QJsonObject{{"connected",false},{"capture","off"},{"canApply",false},{"sessionId",""},{"digest",""},{"cleanupFinished",true},{"sessionGeneration",0},{"captureGeneration",0}};
+    if(MkbDashboard::retiringLifecycle && (!current ||
+        (!MkbDashboard::retiringLifecycle->snapshot().cleanup && s["sessionId"]!=MkbDashboard::retiringIdentity["sessionId"]))) {
+        s=MkbDashboard::retiringIdentity;
+        const auto terminal=MkbDashboard::retiringLifecycle->snapshot();
+        s["running"]=false;s["connected"]=false;s["canApply"]=false;s["busy"]=false;
+        s["cleanupFinished"]=terminal.known && terminal.cleanup;
+        s["capture"]=terminal.known && terminal.cleanup?"off":"releasing";
+        s["engaged"]=!terminal.known || !terminal.cleanup;s["sampleAgeMs"]=0;
+    }
+    s["launchNonce"]=launchNonce;s["binaryDigest"]=binaryDigest;
+    s["headsetAudioControlVersion"]=1;
+    auto audio=current && s["sessionId"]==current->dashboardSession?current->HeadsetAudioStatus():QJsonObject{{"supported",false}};
+    audio["processId"]=processId;audio["sessionId"]=s["sessionId"];audio["sessionGeneration"]=s["sessionGeneration"];
+    s["audio"]=audio;
+    s["controlOperationId"]=controlOperationId;s["protocolVersion"]=2;s["processId"]=processId;s["pid"]=double(QCoreApplication::applicationPid());return s;
+}
+void reply(QLocalSocket *socket,const QJsonValue &id,const QString &error,bool released=false,const QString &audioOperation={}) {
+    if(!socket)return;
+    auto view=status();
+    // The ACK identifies the completed command; all state still comes from a
+    // fresh output snapshot.
+    if(!audioOperation.isEmpty()) {
+        auto audio=view["audio"].toObject();audio["operationId"]=audioOperation;view["audio"]=audio;
+    }
+    if(released && view["capture"]=="off" && view["cleanupFinished"].toBool()) {
+        view["releaseConfirmed"]=true;view["releaseProof"]="native-cleanup";
+    }
+    socket->write(QJsonDocument(QJsonObject{{"requestId",id},{"ok",error.isEmpty()},{"error",error},{"status",view}}).toJson(QJsonDocument::Compact)+"\n");
+    socket->disconnectFromServer();
+}
+}
+void MkbDashboard::attach(StreamSession *s) {current=s;}
+MkbDashboard::MkbDashboard(QObject *parent):QObject(parent) {
+    const auto path=qEnvironmentVariable("CHIAKI_MKB_SOCKET");
+    if(path.isEmpty())return;
+    QFile executable(QCoreApplication::applicationFilePath());
+    if(executable.open(QIODevice::ReadOnly))binaryDigest=QString::fromLatin1(QCryptographicHash::hash(executable.readAll(),QCryptographicHash::Sha256).toHex());
+    // Не создаём и не удаляем произвольные paths. Каталог заранее создаёт service.
+    struct stat st{};const auto dir=QFileInfo(path).absolutePath().toUtf8();
+    if(::lstat(dir.constData(),&st) || !S_ISDIR(st.st_mode) || st.st_uid!=getuid() || (st.st_mode&077)!=0)
+        qFatal("MKB IPC requires a private owned directory");
+    auto server=new QLocalServer(this);server->setMaxPendingConnections(32);server->setSocketOptions(QLocalServer::UserAccessOption);
+    if(!server->listen(path))qFatal("MKB IPC listen failed");
+    auto connections=std::make_shared<unsigned>(0);
+    auto normal=std::make_shared<unsigned>(0),priority=std::make_shared<unsigned>(0);
+    auto audioNormal=std::make_shared<unsigned>(0);
+    auto incomplete=std::make_shared<std::deque<QPointer<QLocalSocket>>>();
+    auto seen=std::make_shared<std::deque<QString>>();
+    connect(server,&QLocalServer::newConnection,this,[server,connections,normal,priority,audioNormal,incomplete,seen] {
+        while(auto socket=server->nextPendingConnection()) {
+            // Incomplete frames have a bounded admission pool, separate from
+            // the six normal and two priority command execution slots.
+            incomplete->erase(std::remove_if(incomplete->begin(),incomplete->end(),[](const auto &s){return s.isNull();}),incomplete->end());
+            if(*connections>=32 && !incomplete->empty()) {
+                auto victim=incomplete->front();incomplete->pop_front();
+                if(victim){victim->abort();delete victim.data();}
+            }
+            if(*connections>=32){socket->abort();socket->deleteLater();continue;}
+            auto lane=std::make_shared<unsigned>(0);
+            ++*connections;connect(socket,&QObject::destroyed,server,[connections,normal,priority,audioNormal,lane]{
+                --*connections;if(*lane==1)--*normal;else if(*lane==2)--*priority;else if(*lane==3)--*audioNormal;
+            });
+            incomplete->push_back(socket);
+            socket->setReadBufferSize(131073);
+            auto frame=std::make_shared<QByteArray>();auto consumed=std::make_shared<bool>(false);
+            auto expiry=new QTimer(socket);expiry->setSingleShot(true);expiry->start(2000);
+            connect(expiry,&QTimer::timeout,socket,[socket]{socket->abort();});
+            connect(socket,&QLocalSocket::disconnected,socket,&QObject::deleteLater);
+            connect(socket,&QLocalSocket::readyRead,socket,[socket,frame,consumed,seen,normal,priority,audioNormal,lane,expiry,incomplete] {
+                if(*consumed)return;
+                frame->append(socket->readAll());
+                if(frame->size()>131072){*consumed=true;reply(socket,{},"Слишком большой frame");return;}
+                if(!frame->contains('\n'))return;
+                incomplete->erase(std::remove(incomplete->begin(),incomplete->end(),socket),incomplete->end());
+                *consumed=true;
+                const auto jsonError=MkbJsonError(frame->toStdString());
+                if(!jsonError.empty()){reply(socket,{},QString::fromStdString(jsonError));return;}
+                QJsonParseError parse;const auto doc=QJsonDocument::fromJson(*frame,&parse);
+                const auto request=doc.object();const auto id=request["requestId"];
+                if(parse.error!=QJsonParseError::NoError || !doc.isObject() || !id.isString() || id.toString().size()>80) {reply(socket,id,"Некорректный frame");return;}
+                const QStringList allowed={"command","requestId","processId","sessionId","expectedDigest","profileBytes","sessionGeneration","captureGeneration","controlEpoch","operationId","launchNonce","binaryDigest","runtimeRevision","audioRevision","setVolume","setOutputMuted"};
+                for(auto it=request.begin();it!=request.end();++it)if(!allowed.contains(it.key())){reply(socket,id,"Неизвестное поле");return;}
+                const auto command=request["command"].toString();
+                if(command=="audio") {
+                    if(*audioNormal>=2){reply(socket,id,"Audio lane busy");return;}
+                    ++*audioNormal;*lane=3;
+                } else if(command=="release") {
+                    if(*priority>=2){reply(socket,id,"Release lane busy");return;}
+                    ++*priority;*lane=2;
+                } else {
+                    if(*normal>=6){reply(socket,id,"Reserved release lane");return;}
+                    ++*normal;*lane=1;
+                }
+                expiry->start(8000);
+                if(command=="status"){reply(socket,id,{});return;}
+                if(command!="arm" && command!="release" && command!="apply" && command!="live" && command!="validate" && command!="audio") {reply(socket,id,"Неизвестная команда");return;}
+                const auto view=status();
+                if(command=="audio") {
+                    const QStringList required={"command","requestId","operationId","processId","sessionId","sessionGeneration","audioRevision"};
+                    int actions=0;
+                    for(const auto &key: {"setVolume","setOutputMuted"})if(request.contains(key))++actions;
+                    if(actions!=1 || request.size()!=required.size()+1) {reply(socket,id,"Нужна ровно одна audio-команда");return;}
+                    for(const auto &key:required)if(!request.contains(key)) {reply(socket,id,"Неполная audio identity");return;}
+                    auto integer=[](const QJsonValue &v) {return v.isDouble() && std::isfinite(v.toDouble()) && v.toDouble()>=0 && v.toDouble()<=9007199254740991. && std::floor(v.toDouble())==v.toDouble();};
+                    if(!integer(request["audioRevision"]) || !integer(request["sessionGeneration"]) ||
+                        !request["operationId"].isString() || request["operationId"].toString().isEmpty() || request["operationId"].toString().size()>80 ||
+                        !request["processId"].isString() || !request["sessionId"].isString() ||
+                        (request.contains("setVolume") && (!request["setVolume"].isDouble() || !std::isfinite(request["setVolume"].toDouble()) || request["setVolume"].toDouble()<0 || request["setVolume"].toDouble()>100)) ||
+                        (request.contains("setOutputMuted") && !request["setOutputMuted"].isBool())) {reply(socket,id,"Некорректная audio-команда");return;}
+                    if(!current || view["sessionId"]!=current->dashboardSession || request["processId"]!=processId || request["sessionId"]!=view["sessionId"] || request["sessionGeneration"]!=view["sessionGeneration"]) {
+                        reply(socket,id,"Audio session изменилась");return;
+                    }
+                    const auto key="audio:"+request["operationId"].toString();
+                    if(std::find(seen->begin(),seen->end(),key)!=seen->end()) {reply(socket,id,"Audio операция уже зарегистрирована");return;}
+                    seen->push_back(key);if(seen->size()>64)seen->pop_front();
+                    const auto error=current->HeadsetAudioCommand(request);
+                    if(error!="volume-readback-pending") {reply(socket,id,error,false,request["operationId"].toString());return;}
+                    auto timer=new QTimer(current);timer->setInterval(10);
+                    const QPointer<QLocalSocket> requester=socket;
+                    auto elapsed=std::make_shared<QElapsedTimer>();elapsed->start();
+                    const QPointer<StreamSession> session=current;
+                    const auto audioOperation=request["operationId"].toString();
+                    connect(timer,&QTimer::timeout,timer,[requester,id,timer,elapsed,session,audioOperation] {
+                        if(!session || current!=session) {timer->deleteLater();reply(requester,id,"Audio session изменилась");return;}
+                        const auto result=session->HeadsetAudioPoll(elapsed->elapsed()>=300);
+                        if(result!="volume-readback-pending") {timer->deleteLater();reply(requester,id,result,false,audioOperation);}
+                    });
+                    timer->start();return;
+                }
+                const bool release=command=="release";
+                const bool localRelease=release && !request.contains("processId");
+                if(request.contains("launchNonce") && (launchNonce.isEmpty() || request["launchNonce"]!=launchNonce ||
+                    request["binaryDigest"]!=binaryDigest || request["expectedDigest"]!=view["digest"])) {
+                    reply(socket,id,"Launch identity изменилась");return;
+                }
+                if(request.contains("launchNonce") && (!controlOperationId.isEmpty() ||
+                    view["captureGeneration"].toDouble()!=0 || view["workerRevision"].toDouble()!=0 ||
+                    view["capture"]!="off" || view["busy"].toBool())) {
+                    reply(socket,id,"Запущенный клиент уже участвовал в другой операции");return;
+                }
+                if(!localRelease && (request["processId"]!=processId || request["sessionId"]!=view["sessionId"] ||
+                    request["sessionGeneration"]!=view["sessionGeneration"] ||
+                    (!release && (request["expectedDigest"]!=view["digest"] || request["captureGeneration"]!=view["captureGeneration"])))) {
+                    reply(socket,id,"Сессия или профиль изменились");return;
+                }
+                if(!current || view["sessionId"]!=current->dashboardSession) {
+                    if(release && view["cleanupFinished"].toBool() && view["capture"]=="off")reply(socket,id,{},true);
+                    else reply(socket,id,"Native cleanup ещё не завершён");
+                    return;
+                }
+                if(!release && command!="validate" && (!request["controlEpoch"].isDouble() || request["controlEpoch"]!=view["controlEpoch"])) {
+                    reply(socket,id,"Control epoch изменился");return;
+                }
+                const auto operationId=request.contains("operationId")?request["operationId"].toString():id.toString();
+                if(operationId.isEmpty() || operationId.size()>80){reply(socket,id,"Некорректная operation identity");return;}
+                if(command!="validate") {
+                    if(std::find(seen->begin(),seen->end(),operationId)!=seen->end()){reply(socket,id,"Операция уже зарегистрирована; запросите status");return;}
+                    seen->push_back(operationId);if(seen->size()>32)seen->pop_front();
+                }
+                if(command=="live" && view["capture"]=="active" &&
+                   request["runtimeRevision"]!=view["recoil"].toObject()["runtimeRevision"]) {
+                    reply(socket,id,"Runtime изменился");return;
+                }
+                const auto bytes=request["profileBytes"].toString().toUtf8();
+                if(command=="validate") {
+                    const auto p=MkbProfile::fromBytes(bytes.toStdString());reply(socket,id,QString::fromStdString(p.compatibilityError(true)));return;
+                }
+                auto session=QPointer<StreamSession>(current);
+                MkbDashboardController::Operation operation=0;
+                const auto error=session->DashboardBegin(command,bytes,operation,release?UINT64_MAX:uint64_t(request["controlEpoch"].toDouble()),command=="live"?uint64_t(request["runtimeRevision"].toDouble()):UINT64_MAX);
+                if(!error.isEmpty()){reply(socket,id,error);return;}
+                if(command!="release")controlOperationId=operationId;
+                auto timer=new QTimer(socket);timer->setObjectName("mkb-dashboard-poll:"+id.toString());timer->setInterval(10);
+                auto elapsed=std::make_shared<QElapsedTimer>();elapsed->start();
+                connect(socket,&QLocalSocket::disconnected,session,[session,timer,operation]{if(timer->isActive() && session)session->DashboardCancel(operation);});
+                connect(timer,&QTimer::timeout,socket,[socket,session,command,id,timer,elapsed,operation] {
+                    if(!session || session!=current || elapsed->elapsed()>6000) {
+                        if(session)session->DashboardCancel(operation);timer->stop();reply(socket,id,"Timeout или смена сессии");return;
+                    }
+                    bool done=false;const auto error=session->DashboardPoll(operation,done);
+                    if(done){timer->stop();reply(socket,id,error,command=="release" && error.isEmpty());}
+                });timer->start();
+            });
+        }
+    });
+}
diff --git a/gui/include/mkbsessioninput.h b/gui/include/mkbsessioninput.h
new file mode 100644
index 0000000..ae4db88
--- /dev/null
+++ b/gui/include/mkbsessioninput.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#pragma once
+#include "mkbworker.h"
+
+// GUI session routing, shared with offline tests. Callbacks run on the caller;
+// only the worker owns capture. No Qt state crosses into that worker.
+struct MkbSessionInput {
+    enum class Arm { Default, Invalid, Rejected, Requested };
+    template<class Clear,class DefaultArm>
+    static Arm arm(MkbWorker::Mode mode,MkbWorker *worker,MkbSubmissionGate *gate,
+        bool focused,bool blocked,Clear clear,DefaultArm defaultArm) {
+        if(mode==MkbWorker::Mode::Default){defaultArm();return Arm::Default;}
+        if(mode!=MkbWorker::Mode::Enabled || !worker || !gate || !worker->running())return Arm::Invalid;
+        gate->setEligibility(focused,blocked);clear();
+        const auto token=gate->reserveCapture();
+        if(!token)return Arm::Rejected;
+        worker->requestArm(token);
+        return Arm::Requested;
+    }
+    template<class Clear>
+    static bool acknowledge(const MkbWorker::Snapshot &snapshot,const MkbCaptureLifecycle::Snapshot &metadata,MkbSubmissionGate &gate,Clear clear) {
+        if(!metadata.cleanup || metadata.token!=snapshot.token)return false;
+        if((snapshot.phase!=MkbWorker::Phase::Releasing && snapshot.phase!=MkbWorker::Phase::Stopped) || !gate.releasePending(snapshot.token))return false;
+        clear();
+        return gate.completeRelease(snapshot.token);
+    }
+};

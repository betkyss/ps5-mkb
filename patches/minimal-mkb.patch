+void StreamSession::ScheduleHeadsetAudioRetry()
+{
+    // At most three delayed retries per setup/hotplug event. No input polling.
+    if(!output_policy.headset || !headset_audio_retry || audio_out ||
+       !headset_audio_channels || !headset_audio_rate || headset_audio_retry->isActive() || headset_audio_attempts >= 3)
+        return;

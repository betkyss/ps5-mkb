+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbworker.h"
+#include <cassert>
+#include <exception>
+MkbWorker::MkbWorker(MkbProfile p,std::shared_ptr<MkbSubmissionGate> g,std::shared_ptr<MkbWorkerTrace> t,MacInputCapture::BackendFactory f,std::function<void()> waitObserver,bool probe)
+    :gate(std::move(g)),trace(std::move(t)),profile(std::move(p)),factory(std::move(f)),beforeWait(std::move(waitObserver)),cameraProbe(probe),thread(&MkbWorker::run,this){}
+void MkbWorker::publish(Phase p,MkbCaptureToken t,MkbStopReason code,const char *reason,uint64_t ticks,uint64_t skipped) {
+    MkbStatusPublication<20>::Words words{};std::array<char,96> text{};MkbCopyReason(text,reason);
+    words[0]=uint64_t(p);words[1]=t.session;words[2]=t.capture;words[3]=uint64_t(code);
+    words[4]=MkbNativePhaseTrace::threadId();words[5]=ticks;words[6]=skipped;
+    std::memcpy(words.data()+7,text.data(),text.size());words[19]=MacInputCapture::nowNs();
+    publication.publish(words);
+}
+void MkbWorker::requestArm(MkbCaptureToken t) {
+    std::lock_guard<std::mutex> lock(control->mutex);if(control->closed||control->shutdown)return;
+    control->arm=t;control->wake.notify_all();
+}
+void MkbWorker::requestRelease(MkbCaptureToken t,MkbStopReason reason,const char *text) {
+    gate->revokeCapture(t,text,reason);control->release(t,reason,text);
+}
+void MkbWorker::shutdownAndJoin() {
+    if(!thread.joinable())return;
+    gate->stopSession();
+    {std::lock_guard<std::mutex> lock(control->mutex);control->shutdown=true;control->wake.notify_all();}
+    thread.join();
+}
+void MkbWorker::run() {
+    try {runOwner();}
+    catch(...) {
+        gate->stopSession();
+        {std::lock_guard<std::mutex> lock(control->mutex);control->closed=true;control->publishView();}
+        const auto terminal=gate->sealTrace();const auto now=MacInputCapture::nowNs();
+        trace->beginRelease(terminal.releaseNs?terminal.releaseNs:now,"worker-exception");
+        MkbWorkerRecord row;row.kind=MkbWorkerRecord::Kind::Stop;row.token=gate->current();row.reason=MkbStopReason::Native;row.finish=now;trace->append(row);
+        trace->finish(now,nullptr,terminal.recovery);
+        publish(Phase::Stopped,row.token,MkbStopReason::Native,"worker-exception",0,0);
+    }
+}
+void MkbWorker::runOwner() {

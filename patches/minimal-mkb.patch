+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#include "mkbmapper.h"
+MkbProfile MkbProfile::defaults()
+{
+    MkbProfile p;
+    p.binds = {{13,MkbMapper::W},{0,MkbMapper::A},{1,MkbMapper::S},{2,MkbMapper::D},
+        {49,MkbMapper::Cross},{15,MkbMapper::Box},{14,MkbMapper::Pyramid},{8,MkbMapper::Moon},
+        {12,MkbMapper::L1},{3,MkbMapper::R1},{56,MkbMapper::L3},{60,MkbMapper::L3},
+        {126,MkbMapper::Up},{125,MkbMapper::Down},{123,MkbMapper::Left},{124,MkbMapper::Right},
